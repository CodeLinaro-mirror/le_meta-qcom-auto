From a73f7a99f3b8df040cb8dcd286e89c20ebdc8b8b Mon Sep 17 00:00:00 2001
From: kas User <kas@example.com>
Date: Tue, 5 May 2026 16:36:22 -0700
Subject: [PATCH] safelinux-cfg-modules: fix remove() signature for 6.18 kernel

Signed-off-by: Venkatakrishnaiah Pari <vpari@qti.qualcomm.com>

Upstream-Status: Inappropriate
---
diff --git a/safelinux-modules/Kbuild b/safelinux-modules/Kbuild
index 8b6407b..5cd4d50 100644
--- a/safelinux-modules/Kbuild
+++ b/safelinux-modules/Kbuild
@@ -11,7 +11,7 @@ apps_pinctrl-objs := drivers/apps_pinctrl.o
 
 obj-m += scm_user_intf.o
 ifneq ($(KERNELRELEASE), "5.14.0")
-ccflags-y += -I$(KERNEL_SRC)/drivers/firmware
+ccflags-y += -I$(KERNEL_SRC)/drivers/firmware/qcom
 endif
 scm_user_intf-objs := drivers/scm_user_intf.o
 
@@ -24,8 +24,8 @@ pinctrl_fusa-objs := drivers/pinctrl_fusa.o
 obj-m += arm-smmu-qcom-fusa.o
 arm-smmu-qcom-fusa-objs := drivers/arm-smmu-qcom-fusa.o
 
-obj-m += qcom_io_mem.o
-qcom_io_mem-objs := drivers/qcom_io_mem.o drivers/kiumd_common.o
+# obj-m += qcom_io_mem.o
+# qcom_io_mem-objs := drivers/qcom_io_mem.o drivers/kiumd_common.o
 
 obj-m += iommu_iova_map.o
 iommu_iova_map-objs := drivers/iommu_iova_map.o
