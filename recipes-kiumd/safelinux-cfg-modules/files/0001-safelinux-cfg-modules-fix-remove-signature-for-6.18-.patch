diff --git a/safelinux-modules/drivers/kiumd.c b/safelinux-modules/drivers/kiumd.c
index c22052a..fb5040e 100644
--- a/safelinux-modules/drivers/kiumd.c
+++ b/safelinux-modules/drivers/kiumd.c
@@ -11,19 +11,10 @@
 #include "safelinux_modules_trace.h"
 #include "vfio.h"
 
-#ifdef CONFIG_SAFELINUX_KERNEL
 #define kiumd_set_dma_max_seg_size(_dev, _size)				\
 ({									\
 	dma_set_max_seg_size(_dev, _size);				\
 })
-#else
-#define kiumd_set_dma_max_seg_size(_dev, _size)				\
-({									\
-	ret = dma_set_max_seg_size(_dev, _size);			\
-	if (ret)							\
-		pr_warn("%s: max_segment size not set.\n", __func__);	\
-})
-#endif
 
 #define IOVA_ZERO	((dma_addr_t)0)
 
@@ -32,7 +23,6 @@ static struct kmem_cache *iommu_addr_cache;
 /**
  * Added in kernel tag v6.12-rc1
  */
-DEFINE_FREE(fput, struct file *, if (_T) fput(_T))
 
 /**
  * @Brief: This function provide the device
@@ -458,7 +448,18 @@ static int kiumd_dmabuf_custom_iova_init(char __user *arg, struct file *fp)
 	}
 
 	cookie = (struct kiumd_iommu_dma_cookie *)domain->iova_cookie;
+	if (!cookie) {
+               pr_err("%s: iova_cookie is NULL for %s, domain not DMA-capable\n",
+                      __func__, dev_name(dev));
+               return -EINVAL;
+        }
+
 	iovad = &cookie->iovad;
+	if (!iovad || !iovad->granule) {
+    		dev_err(dev, "kiumd: iova_domain not initialized for device\n");
+    		return -EINVAL;
+	}
+
 	qcom_iommu_generate_resv_regions(dev, &resrvd);
 	list_for_each_entry(region, &resrvd, list) {
 		lo = iova_pfn(iovad, region->start);
@@ -604,7 +605,7 @@ static int __kiumd_dmabuf_vfio_unmap(struct kiumd_ctx *kiumd_ctx,
 	dma_addr = smap->is_iova_zero ?
 		   IOVA_ZERO : sg_dma_address(smap->sgt_ptr->sgl);
 	if (smap->is_fixed_map) {
-		ret = kiumd_configure_dma_cookie(smap->dev, IOMMU_DMA_MSI_COOKIE,
+		ret = kiumd_configure_dma_cookie(smap->dev, IOMMU_COOKIE_DMA_MSI,
 						 dma_addr);
 		if (ret)
 			return -ENODEV;
@@ -1218,7 +1219,7 @@ static int kiumd_close(struct inode *inode, struct file *filp)
 				if (smap->is_fixed_map) {
 					ret = kiumd_configure_dma_cookie(
 							smap->dev,
-							IOMMU_DMA_MSI_COOKIE,
+							IOMMU_COOKIE_DMA_MSI,
 							(dma_addr_t)smap->dmabuf_ptr);
 					if (ret) {
 						pr_err("%s %d failed to configure cookie\n", __func__, __LINE__);
@@ -1253,7 +1254,7 @@ static int kiumd_close(struct inode *inode, struct file *filp)
 				if (smap->is_fixed_map) {
 					ret = kiumd_configure_dma_cookie(
 							smap->dev,
-							IOMMU_DMA_IOVA_COOKIE,
+							IOMMU_COOKIE_DMA_MSI,
 							(dma_addr_t)smap->dmabuf_ptr);
 					if (ret) {
 						pr_err("%s %d failed to configure cookie\n", __func__, __LINE__);
@@ -1662,7 +1663,6 @@ static struct platform_driver kiumd_driver = {
 	.probe = kiumd_probe,
 };
 module_platform_driver(kiumd_driver);
-
-MODULE_IMPORT_NS(DMA_BUF);
+MODULE_IMPORT_NS("DMA_BUF");
 MODULE_DESCRIPTION("KIUMD");
 MODULE_LICENSE("GPL v2");
diff --git a/safelinux-modules/drivers/kiumd_common.c b/safelinux-modules/drivers/kiumd_common.c
index c70e352..516df6d 100644
--- a/safelinux-modules/drivers/kiumd_common.c
+++ b/safelinux-modules/drivers/kiumd_common.c
@@ -106,17 +106,25 @@ struct kiumd_iommu_dma_cookie *kiumd_get_dma_cookie(struct device *dev)
  *
  * Return:  0 upon success and -EINVAL on failure
  */
-int kiumd_set_dma_cookie(struct kiumd_iommu_dma_cookie *cookie,
-			 enum iommu_dma_cookie_type type,
-			 dma_addr_t iova)
+
+int kiumd_set_dma_cookie(struct iommu_domain *domain,
+                                struct kiumd_iommu_dma_cookie *cookie,
+                                enum iommu_domain_cookie_type type,
+                                dma_addr_t iova)
 {
-	if (!cookie) {
+	if (!cookie || !domain) {
 		pr_err("%s:Unable to set cookie\n", __func__);
 		return -EINVAL;
 	}
 
-	cookie->type = type;
-	cookie->msi_iova = iova;
+	domain->cookie_type = type;
+	if (type == IOMMU_COOKIE_DMA_MSI) {
+		struct kiumd_iommu_dma_msi_cookie *msi_cookie = (struct kiumd_iommu_dma_msi_cookie *)domain->msi_cookie;
+		if (!msi_cookie)
+			iommu_get_msi_cookie(domain, iova);
+		else
+			msi_cookie->msi_iova = iova;
+	}
 
 	return 0;
 }
@@ -132,20 +140,20 @@ int kiumd_set_dma_cookie(struct kiumd_iommu_dma_cookie *cookie,
  *
  * Return: 0 upon success and -EINVAL on failure
  */
-int kiumd_set_dma_cookie_unlocked(struct kiumd_iommu_dma_cookie *cookie,
-				  enum iommu_dma_cookie_type type,
-				  dma_addr_t iova)
+
+int kiumd_set_dma_cookie_unlocked(struct iommu_domain *domain,
+                                struct kiumd_iommu_dma_cookie *cookie,
+                                enum iommu_domain_cookie_type type,
+                                dma_addr_t iova)
 {
 	int ret;
 
-	if (!cookie) {
+	if (!cookie || !domain) {
 		pr_err("%s:Unable to set cookie\n", __func__);
 		return -EINVAL;
 	}
 
-	mutex_lock(&cookie->mutex);
-	ret = kiumd_set_dma_cookie(cookie, type, iova);
-	mutex_unlock(&cookie->mutex);
+	ret = kiumd_set_dma_cookie(domain, cookie, type, iova);
 	return ret;
 }
 
@@ -187,8 +195,8 @@ int kiumd_iommu_custom_iova_init(struct device *dev)
 	LIST_HEAD(resrvd);
 
 	//Print a warning and continue.
-	if (dma_set_max_seg_size(dev, (unsigned int) DMA_BIT_MASK(32)))
-		pr_err("%s:WARNING: max_segment size not set.\n", __func__);
+	if (dev->dma_parms)
+		dma_set_max_seg_size(dev, (unsigned int) DMA_BIT_MASK(32));
 
 	domain = kiumd_iommu_get_dma_domain(dev);
 	if (!domain) {
@@ -344,17 +352,21 @@ static int insert_iova(struct pgtable_map *pgtable_ctx,
 }
 
 int kiumd_configure_dma_cookie(struct device *dev,
-			       enum iommu_dma_cookie_type cookie_type,
-			       dma_addr_t dma_addr)
+				     enum iommu_domain_cookie_type cookie_type,
+				     dma_addr_t dma_addr)
 {
 	struct kiumd_iommu_dma_cookie *cookie;
+	struct iommu_domain *domain;
 	int ret;
 
 	cookie = kiumd_get_dma_cookie(dev);
-	if (!cookie)
+	domain = kiumd_iommu_get_dma_domain(dev);
+	if (!cookie || !domain) {
+		pr_err("%s failed to get cookie\n", __func__);
 		return -EINVAL;
+	}
 
-	ret = kiumd_set_dma_cookie_unlocked(cookie, cookie_type, dma_addr);
+	ret = kiumd_set_dma_cookie_unlocked(domain, cookie, cookie_type, dma_addr);
 	if (ret) {
 		pr_err("%s %d failed to set cookie\n", __func__, __LINE__);
 		return -EINVAL;
@@ -376,6 +388,12 @@ static struct iova_domain *kiumd_get_iova_domain(struct device *dev)
 	}
 
 	cookie = (struct kiumd_iommu_dma_cookie *)domain->iova_cookie;
+	 if (!cookie) {
+               pr_err("%s: iova_cookie is NULL for device, domain not DMA-capable\n",
+                      __func__);
+               return NULL;
+       }
+
 	iovad = &cookie->iovad;
 
 	return iovad;
@@ -1103,7 +1121,7 @@ int set_kgsl_map_iova(struct kmem_cache *addr_cache, struct kiumd_ctx *kiumd_ctx
 	smap->kgsl_ctx.pt_id = kiusr.pt_id;
 	smap->kgsl_ctx.iova = iova;
 
-	ret = kiumd_configure_dma_cookie(dev, IOMMU_DMA_MSI_COOKIE, iova);
+	ret = kiumd_configure_dma_cookie(dev, IOMMU_COOKIE_DMA_MSI, iova);
 	if (ret) {
 		dev_err(dev, "Failed to set cookie for the GPU device\n");
 		(void)clear_kgsl_map_iova(addr_cache, kiumd_ctx, smap);
@@ -1124,15 +1142,17 @@ void add_to_smmu_table(struct kiumd_ctx *ctx, struct smmu_map_data *map_data)
 int set_allocated_iova(struct device *dev, unsigned long iova)
 {
 	struct kiumd_iommu_dma_cookie *cookie;
+	struct iommu_domain *domain;
 	int ret;
 
 	cookie = kiumd_get_dma_cookie(dev);
-	if (!cookie) {
+	domain = kiumd_iommu_get_dma_domain(dev);
+	if (!cookie || !domain) {
 		pr_err("%s failed to get cookie\n", __func__);
 		return -EINVAL;
 	}
 
-	ret = kiumd_set_dma_cookie_unlocked(cookie, IOMMU_DMA_MSI_COOKIE, iova);
+	ret = kiumd_set_dma_cookie_unlocked(domain, cookie, IOMMU_COOKIE_DMA_MSI, iova);
 	if (ret)
 		pr_err("%s failed to set cookie\n", __func__);
 
@@ -1170,7 +1190,7 @@ int init_and_allocate_iova(struct kmem_cache *addr_cache, struct device *dev,
 
 	smap->is_fixed_map = true;
 	smap->iova_rb  = iova;
-	ret = kiumd_configure_dma_cookie(dev, IOMMU_DMA_MSI_COOKIE, iova);
+	ret = kiumd_configure_dma_cookie(dev, IOMMU_COOKIE_DMA_MSI, iova);
 	if (ret < 0) {
 		pr_err("%s: Failed to set the iova.\n", __func__);
 		free_allocated_iova(addr_cache, kiumd_ctx, iova);
@@ -1208,13 +1228,11 @@ u64 kiumd_get_dmabuf_size(int dmabuf_fd)
  */
 bool is_fixed_mapping(struct device *dev)
 {
-	struct kiumd_iommu_dma_cookie *cookie;
+	struct iommu_domain *domain;
 
-	cookie = kiumd_get_dma_cookie(dev);
-	if (cookie) {
-		if (cookie->type == IOMMU_DMA_MSI_COOKIE)
+	domain = kiumd_iommu_get_dma_domain(dev);
+	if (domain && domain->cookie_type == IOMMU_COOKIE_DMA_MSI)
 			return true;
-	}
 
 	return false;
 }
