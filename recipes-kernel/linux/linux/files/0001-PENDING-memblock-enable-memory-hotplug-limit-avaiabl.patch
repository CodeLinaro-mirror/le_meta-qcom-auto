From aaf42b06c6f5e07f20041befbef31383ab98092f Mon Sep 17 00:00:00 2001
From: ziqic <ziqic@qti.qualcomm.com>
Date: Tue, 9 Jun 2026 17:53:38 +0800
Subject: [PATCH] PENDING: memblock:enable memory-hotplug&limit avaiable memory

1.arm64: add ARCH_MEMORY_PROBE Kconfig

Add config ARCH_MEMORY_PROBE to enable memory probe sysfs interface.
Write memory physical address to /sys/device/system/memory/probe to
add memory to kernel.

Signed-off-by: Kaisheng Yang <kaisheng@qti.qualcomm.com>

2.Add bootmem_limit parameter

Add a new bootmem_limit parameter to indicate how much memory should be used in early init process, ex. bootmem_limit=4G.

Offline all memblock.memory(except NO-MAP parts) after getting
4G memoblock.memory. Besides, all memblock.reserved and NO-MAP memory in
memblock.memory will be remained.

This new solution can reach similar kpi data as former memory-hotplug solutions, but more flexiable.

Change-Id: If3db7f0291532c1989f8dfce536df1308b412c46
Signed-off-by: ziqic <ziqic@qti.qualcomm.com>
---
 arch/arm64/Kconfig       |  12 +++++
 arch/arm64/mm/init.c     | 112 +++++++++++++++++++++++++++++++++++++++
 drivers/base/memory.c    |  22 ++++++++
 include/linux/memblock.h |   7 +++
 mm/memblock.c            |  47 ++++++++++++++++
 5 files changed, 200 insertions(+)

diff --git a/arch/arm64/Kconfig b/arch/arm64/Kconfig
index 1be9f1f6b320..96a6d43860cb 100644
--- a/arch/arm64/Kconfig
+++ b/arch/arm64/Kconfig
@@ -16,6 +16,7 @@ config ARM64
 	select ARCH_CORRECT_STACKTRACE_ON_KRETPROBE
 	select ARCH_ENABLE_HUGEPAGE_MIGRATION if HUGETLB_PAGE && MIGRATION
 	select ARCH_ENABLE_MEMORY_HOTPLUG
+	select ARCH_MEMORY_PROBE
 	select ARCH_ENABLE_MEMORY_HOTREMOVE
 	select ARCH_ENABLE_SPLIT_PMD_PTLOCK if PGTABLE_LEVELS > 2
 	select ARCH_ENABLE_THP_MIGRATION if TRANSPARENT_HUGEPAGE
@@ -1511,6 +1512,17 @@ config HW_PERF_EVENTS
 	def_bool y
 	depends on ARM_PMU
 
+config ARCH_MEMORY_PROBE
+	bool "Enable sysfs memory/probe interface"
+	depends on MEMORY_HOTPLUG
+	help
+	  This option enables a sysfs memory/probe interface for testing.
+	  See Documentation/admin-guide/mm/memory-hotplug.rst for more information.
+	  If you are unsure how to answer this question, answer N.
+
+	  Add userspace sysfs memory probe interface /sys/device/system/memory/probe.
+	  Write physical address to this interface to probe memory.
+
 # Supported by clang >= 7.0 or GCC >= 12.0.0
 config CC_HAVE_SHADOW_CALL_STACK
 	def_bool $(cc-option, -fsanitize=shadow-call-stack -ffixed-x18)
diff --git a/arch/arm64/mm/init.c b/arch/arm64/mm/init.c
index 8a0f8604348b..a987bff82ef6 100644
--- a/arch/arm64/mm/init.c
+++ b/arch/arm64/mm/init.c
@@ -17,6 +17,7 @@
 #include <linux/initrd.h>
 #include <linux/gfp.h>
 #include <linux/memblock.h>
+#include <linux/memory.h>
 #include <linux/sort.h>
 #include <linux/of.h>
 #include <linux/of_fdt.h>
@@ -67,6 +68,16 @@ phys_addr_t __ro_after_init arm64_dma_phys_limit;
 /* Current arm64 boot protocol requires 2MB alignment */
 #define CRASH_ALIGN			SZ_2M
 
+/*
+ * bootmem_limit=SIZE keeps only the requested amount of usable memory.
+ * Reserved regions are preserved, and blocks removed at boot are recorded
+ * for later probe/online from userspace.
+ */
+#ifdef CONFIG_MEMORY_HOTPLUG
+static bool __initdata bootmem_limit_enabled;
+static phys_addr_t __initdata bootmem_limit_size;
+#endif
+
 #define CRASH_ADDR_LOW_MAX		arm64_dma_phys_limit
 #define CRASH_ADDR_HIGH_MAX		(PHYS_MASK + 1)
 #define CRASH_HIGH_SEARCH_BASE		SZ_4G
@@ -309,6 +320,103 @@ static int __init early_mem(char *p)
 }
 early_param("mem", early_mem);
 
+#ifdef CONFIG_MEMORY_HOTPLUG
+static int __init early_bootmem_limit(char *p)
+{
+	phys_addr_t size;
+
+	if (!p || !*p)
+		return 0;
+
+	size = memparse(p, &p);
+	if (!size)
+		return 0;
+
+	bootmem_limit_enabled = true;
+	bootmem_limit_size = size;
+	pr_notice("bootmem_limit enabled: %pa\n", &bootmem_limit_size);
+
+	return 0;
+}
+early_param("bootmem_limit", early_bootmem_limit);
+
+static bool __init block_should_keep(phys_addr_t start, phys_addr_t size)
+{
+	struct memblock_region *rgn;
+
+	/* 1) check memblock.reserved overlap */
+	for_each_reserved_mem_region(rgn)
+		if (memblock_addrs_overlap(start, size, rgn->base, rgn->size))
+			return true;
+
+	/* 2) check memblock.memory no-map memory overlap */
+	for_each_mem_region(rgn)
+		if (memblock_is_nomap(rgn) &&
+			memblock_addrs_overlap(start, size, rgn->base, rgn->size))
+			return true;
+
+	return false;
+}
+
+static void __init arm64_limit_boot_usable_memory(void)
+{
+	phys_addr_t block_size;
+	phys_addr_t usable_limit;
+	phys_addr_t kept_free = 0;
+	phys_addr_t addr, region_end;
+	struct memblock_region *rgn;
+
+	phys_addr_t to_remove[NUM_ALIGN_BLK];
+	int remove_cnt = 0;
+	int i;
+
+	if (!bootmem_limit_enabled)
+		return;
+
+	block_size = memory_block_size_bytes();
+	if (!block_size)
+		return;
+
+	usable_limit = round_up(bootmem_limit_size, block_size);
+	if (!usable_limit)
+		return;
+
+	for_each_mem_region(rgn) {
+		addr = ALIGN(rgn->base, block_size);
+		region_end = ALIGN_DOWN(rgn->base + rgn->size, block_size);
+
+		for (; addr + block_size <= region_end; addr += block_size) {
+			if (block_should_keep(addr, block_size))
+				continue;
+
+			if (kept_free < usable_limit) {
+				kept_free += block_size;
+				continue;
+			}
+
+			if (remove_cnt < NUM_ALIGN_BLK)
+				to_remove[remove_cnt++] = addr;
+			else
+				pr_err("to_remove overflow, addr=%pa\n", &addr);
+		}
+	}
+
+	for (i = 0; i < remove_cnt; i++) {
+		phys_addr_t rm_end = to_remove[i] + block_size;
+
+		pr_debug("remove block %pa-%pa\n", &to_remove[i], &rm_end);
+		if (memblock_remove(to_remove[i], block_size)) {
+			pr_err("bootmem_limit: failed to remove %pa\n", &to_remove[i]);
+			continue;
+		}
+
+		memblock_record_aligned_block(to_remove[i]);
+	}
+
+	pr_info("bootmem_limit=%pa, block_size=%pa\n", &bootmem_limit_size, &block_size);
+}
+#endif
+
 void __init arm64_memblock_init(void)
 {
 	s64 linear_region_size = PAGE_END - _PAGE_OFFSET(vabits_actual);
@@ -435,6 +543,10 @@ void __init arm64_memblock_init(void)
 
 	early_init_fdt_scan_reserved_mem();
 
+#ifdef CONFIG_MEMORY_HOTPLUG
+	arm64_limit_boot_usable_memory();
+#endif
+
 	high_memory = __va(memblock_end_of_DRAM() - 1) + 1;
 }
 
diff --git a/drivers/base/memory.c b/drivers/base/memory.c
index 8a13babd826c..6d8d0b8288e8 100644
--- a/drivers/base/memory.c
+++ b/drivers/base/memory.c
@@ -22,6 +22,7 @@
 #include <linux/stat.h>
 #include <linux/slab.h>
 #include <linux/xarray.h>
+#include <linux/memblock.h>
 
 #include <linux/atomic.h>
 #include <linux/uaccess.h>
@@ -472,6 +473,22 @@ static DEVICE_ATTR_RW(state);
 static DEVICE_ATTR_RO(phys_device);
 static DEVICE_ATTR_RO(removable);
 
+#ifdef CONFIG_MEMORY_HOTPLUG
+static ssize_t show_aligned_blocks_addr(struct device *dev,
+			struct device_attribute *attr, char *buf)
+{
+	return memblock_dump_aligned_blocks_addr(buf);
+}
+
+static ssize_t show_aligned_blocks_num(struct device *dev,
+			struct device_attribute *attr, char *buf)
+{
+	return memblock_dump_aligned_blocks_num(buf);
+}
+static DEVICE_ATTR(aligned_blocks_addr, 0444, show_aligned_blocks_addr, NULL);
+static DEVICE_ATTR(aligned_blocks_num, 0444, show_aligned_blocks_num, NULL);
+#endif
+
 /*
  * Show the memory block size (shared by all memory blocks).
  */
@@ -921,6 +938,11 @@ static struct attribute *memory_root_attrs[] = {
 #ifdef CONFIG_CRASH_HOTPLUG
 	&dev_attr_crash_hotplug.attr,
 #endif
+
+#ifdef CONFIG_MEMORY_HOTPLUG
+	&dev_attr_aligned_blocks_addr.attr,
+	&dev_attr_aligned_blocks_num.attr,
+#endif
 	NULL
 };
 
diff --git a/include/linux/memblock.h b/include/linux/memblock.h
index ed64240041e8..a9d4945ce618 100644
--- a/include/linux/memblock.h
+++ b/include/linux/memblock.h
@@ -133,6 +133,13 @@ void memblock_free_all(void);
 void memblock_free(void *ptr, size_t size);
 void reset_all_zones_managed_pages(void);
 
+#ifdef CONFIG_MEMORY_HOTPLUG
+#define NUM_ALIGN_BLK 512
+void __init memblock_record_aligned_block(phys_addr_t addr);
+int memblock_dump_aligned_blocks_addr(char *buf);
+int memblock_dump_aligned_blocks_num(char *buf);
+#endif
+
 /* Low level functions */
 void __next_mem_range(u64 *idx, int nid, enum memblock_flags flags,
 		      struct memblock_type *type_a,
diff --git a/mm/memblock.c b/mm/memblock.c
index 0695284232f3..23901fa4eedf 100644
--- a/mm/memblock.c
+++ b/mm/memblock.c
@@ -16,6 +16,7 @@
 #include <linux/kmemleak.h>
 #include <linux/seq_file.h>
 #include <linux/memblock.h>
+#include <linux/memory.h>
 
 #include <asm/sections.h>
 #include <linux/io.h>
@@ -2227,6 +2228,52 @@ void __init memblock_free_all(void)
 	totalram_pages_add(pages);
 }
 
+#ifdef CONFIG_MEMORY_HOTPLUG
+
+static phys_addr_t aligned_blocks[NUM_ALIGN_BLK];
+static int aligned_blocks_num;
+
+void __init memblock_record_aligned_block(phys_addr_t addr)
+{
+	if (aligned_blocks_num >= NUM_ALIGN_BLK) {
+		pr_err("%s: aligned_blocks overflow\n", __func__);
+		return;
+	}
+
+	aligned_blocks[aligned_blocks_num++] = addr;
+}
+
+static int aligned_blocks_dump(char *buf, bool as_blocks_num)
+{
+	int i;
+	int size = 0;
+
+	for (i = 0; i < aligned_blocks_num; i++) {
+		if (i)
+			size += sysfs_emit_at(buf, size, ",");
+
+		if (as_blocks_num)
+			size += sysfs_emit_at(buf, size, "%lu",
+				(unsigned long)(aligned_blocks[i] >> SECTION_SIZE_BITS));
+		else
+			size += sysfs_emit_at(buf, size, "0x%llx",
+				(unsigned long long)aligned_blocks[i]);
+	}
+
+	return size;
+}
+
+int memblock_dump_aligned_blocks_addr(char *buf)
+{
+	return aligned_blocks_dump(buf, false);
+}
+
+int memblock_dump_aligned_blocks_num(char *buf)
+{
+	return aligned_blocks_dump(buf, true);
+}
+#endif
+
 #if defined(CONFIG_DEBUG_FS) && defined(CONFIG_ARCH_KEEP_MEMBLOCK)
 static const char * const flagname[] = {
 	[ilog2(MEMBLOCK_HOTPLUG)] = "HOTPLUG",
-- 
