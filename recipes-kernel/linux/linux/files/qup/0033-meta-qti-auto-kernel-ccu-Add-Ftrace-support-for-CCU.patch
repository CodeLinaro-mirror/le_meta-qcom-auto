From bb36c754e8f16aeaeced050a0a2d19966f72ab89 Mon Sep 17 00:00:00 2001
From: Aniket Randive <arandive@qti.qualcomm.com>
Date: Mon, 8 Sep 2025 20:08:44 +0530
Subject: [PATCH] meta-qti-auto-kernel: ccu: Add Ftrace support for CCU

Add Ftrace support for CCU driver to get the debug logs.

Change-Id: Ibdf06f61f227533c47c949bfbd8088a2d6d706ab
Signed-off-by: Aniket Randive <arandive@qti.qualcomm.com>
---
 drivers/soc/qcom/qcom-geni-se.c      |  3 ++
 drivers/soc/qcom/qcom_ccu_qup.c      | 41 ++++++++++++++++++++++++++--
 include/trace/events/ccu_qup_trace.h | 17 ++++++++++++
 3 files changed, 59 insertions(+), 2 deletions(-)
 create mode 100644 include/trace/events/ccu_qup_trace.h

diff --git a/drivers/soc/qcom/qcom-geni-se.c b/drivers/soc/qcom/qcom-geni-se.c
index 1cea5950cfdd..c0a634a06532 100644
--- a/drivers/soc/qcom/qcom-geni-se.c
+++ b/drivers/soc/qcom/qcom-geni-se.c
@@ -25,6 +25,7 @@
 #define CREATE_TRACE_POINTS
 #include <trace/events/qup_i2c_trace.h>
 #include <trace/events/gpi_qup_trace.h>
+#include <trace/events/ccu_qup_trace.h>
 
 /**
  * geni_trace_log() - Common trace logging function for GENI drivers
@@ -51,6 +52,8 @@ void geni_trace_log(struct device *dev, const char *driver_name, const char *fmt
 		trace_i2c_log_info(dev_name(dev), &vaf);
 	} else if (strcmp(driver_name, "gpi") == 0) {
 		trace_gpi_log_info(dev_name(dev), &vaf);
+	} else if (strcmp(driver_name, "ccu") == 0) {
+		trace_ccu_log_info(dev_name(dev), &vaf);
 	} else {
 		/* Fallback for unknown driver types */
 		dev_dbg(dev, "[%s] %pV", driver_name, &vaf);
diff --git a/drivers/soc/qcom/qcom_ccu_qup.c b/drivers/soc/qcom/qcom_ccu_qup.c
index 17c31b773f22..9de5dfb4b85d 100644
--- a/drivers/soc/qcom/qcom_ccu_qup.c
+++ b/drivers/soc/qcom/qcom_ccu_qup.c
@@ -20,12 +20,23 @@
 #include <linux/of_platform.h>
 #include <linux/platform_device.h>
 #include <linux/poll.h>
+#include <linux/soc/qcom/geni-se.h>
 #include <linux/soc/qcom/qcom_ccu_qup.h>
 #include <linux/spinlock.h>
 #include <linux/types.h>
 #include <linux/uaccess.h>
 #include <linux/wait.h>
 
+#define CCU_LOG(log_fn, level, dev, fmt, ...) do { \
+	if ((level) <= log_level) \
+		geni_trace_log(dev, "ccu", fmt, ##__VA_ARGS__); \
+	else \
+		log_fn(dev, fmt, ##__VA_ARGS__); \
+} while (0)
+
+#define CCU_ERR_LOG(level, dev, fmt, ...) CCU_LOG(dev_err, level, dev, fmt, ##__VA_ARGS__)
+#define CCU_DBG_LOG(level, dev, fmt, ...) CCU_LOG(dev_dbg, level, dev, fmt, ##__VA_ARGS__)
+
 #define GPII_0_IRQ		0
 #define GPII_14_IRQ		19
 #define MAX_GPI_DEV		2
@@ -37,6 +48,27 @@
 
 struct ccu_qup *ccud;
 
+static int log_level = -1;
+static ssize_t log_level_show(struct device *dev,
+			      struct device_attribute *attr, char *buf)
+{
+	return snprintf(buf, PAGE_SIZE, "%d\n", log_level);
+}
+
+static ssize_t log_level_store(struct device *dev,
+			       struct device_attribute *attr,
+			       const char *buf, size_t count)
+{
+	int val;
+
+	if (kstrtoint(buf, 10, &val) != 0 || val < LOG_LVL_ERROR || val >= LOG_LVL_MAX)
+		return -EINVAL;
+
+	log_level = val;
+	return count;
+}
+static DEVICE_ATTR_RW(log_level);
+
 static power_on_off_t ccu_on_off;
 static recover_ios_line_t ccu_recover;
 static config_ccu_mode_t ccu_cfg_mode;
@@ -914,7 +946,12 @@ static int ccu_qup_probe(struct platform_device *pdev)
 	queue_delayed_work(ccu->gpi_wq, &ccu->get_child_dev_node,
 			   msecs_to_jiffies(3000));
 
-	dev_dbg(&pdev->dev, "CCU QUP Probe completed\n");
+	ret = device_create_file(&pdev->dev, &dev_attr_log_level);
+	if (ret)
+		CCU_ERR_LOG(LOG_LVL_ERROR, &pdev->dev,
+			    "Failed to create sysfs entry ret:%d\n", ret);
+
+	CCU_DBG_LOG(LOG_LVL_INFO, &pdev->dev, "CCU QUP Probe completed\n");
 
 	return devm_of_platform_populate(&pdev->dev);
 }
@@ -926,7 +963,7 @@ static int ccu_qup_remove(struct platform_device *pdev)
 	if (!ccu)
 		return -ENODEV;
 
-	/* Disable the CCU QUP0 & CCU QUP1 IRQ */
+	device_remove_file(&pdev->dev, &dev_attr_log_level);
 	disable_irq(ccu->ccu_qup0_irq);
 	disable_irq(ccu->ccu_qup1_irq);
 	destroy_workqueue(ccu->gpi_wq);
diff --git a/include/trace/events/ccu_qup_trace.h b/include/trace/events/ccu_qup_trace.h
new file mode 100644
index 000000000000..36e159274dc3
--- /dev/null
+++ b/include/trace/events/ccu_qup_trace.h
@@ -0,0 +1,17 @@
+/* SPDX-License-Identifier: GPL-2.0
+ * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ */
+#undef TRACE_SYSTEM
+#define TRACE_SYSTEM ccu_qup_trace
+
+#include <linux/tracepoint.h>
+
+#if !defined(_TRACE_CCU_QUP_TRACE_H) || defined(TRACE_HEADER_MULTI_READ)
+#define _TRACE_CCU_QUP_TRACE_H
+
+#include "qup_trace_common.h"
+
+DEFINE_QUP_LOG_EVENT(ccu_log_info);
+
+#endif /* _TRACE_CCU_QUP_TRACE_H */
+#include <trace/define_trace.h>
-- 
2.34.1

