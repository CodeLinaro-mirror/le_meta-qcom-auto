 		gpii->ev_ring_rp_lsb_reg = gpii->ev_cntxt_base_reg + CNTXT_4_RING_RP_LSB;
 		gpii->ev_cmd_reg = (gpi_dev->ee_base +
-				(GPII_n_EV_CH_CMD_OFFS(i, gpi_dev->cfg.offset)));
+				(GPII_n_EV_CH_CMD_OFFS(i, gpi_dev->cfg.irq_off)));
 		gpii->ieob_clr_reg = (gpi_dev->ee_base +
