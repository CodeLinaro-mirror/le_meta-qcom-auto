@@ -3025,7 +3027,7 @@ static int gpi_probe(struct platform_device *pdev)
 			gchan->ch_cntxt_db_reg = gpi_dev->ee_base +
 				(GPII_n_CH_k_DOORBELL_0_OFFS(i, chan, gpi_dev->cfg.db_off));
