 				frame->msg[i].addr = rx_addr;
 			} else {
 				frame->msg[i].flag = false;
-				frame->msg[i].addr = tx_addr;
 			}
 			kfree(gi2c->ccu.msg[i]);
 			gi2c->ccu.msg[i] = NULL;
@@ -1531,7 +1620,7 @@ static int geni_i2c_gpi_xfer(struct geni_i2c_dev *gi2c, struct i2c_msg msgs[], i
 
 	if (gi2c->is_ccu_qup) {
 		frame->msgs = num;
-		if (gi2c->ccu.gpi[idx].recvd_cnt >= MAX_NUM_FRAMES)
