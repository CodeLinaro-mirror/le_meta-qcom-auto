+static int geni_i2c_gpi_nop_tre(struct geni_i2c_dev *gi2c, struct dma_slave_config *config, int idx)
+{
+	struct gpi_i2c_config *peripheral_cfg;
+	unsigned int flags;
+	struct dma_async_tx_descriptor *desc;
+	struct ccu_frame_info *frame;
+	dma_cookie_t cookie;
+	unsigned long time_left;
+	int ret;
+
+	peripheral_cfg = config->peripheral_config;
+	peripheral_cfg->ccu_cfg.ccu_last = gi2c->ccu.msg[0]->ccu_last;
+	peripheral_cfg->ccu_cfg.nop_frame = gi2c->ccu.msg[0]->nop_frame;
+	peripheral_cfg->set_config = false;
+	peripheral_cfg->multi_msg = true;
+
+	ret = dmaengine_slave_config(gi2c->tx_c[idx], config);
+	if (ret) {
+		dev_err(gi2c->se.dev, "dma config error: %d\n", ret);
+		goto err_submit;
+	}
+	peripheral_cfg->ccu_cfg.ccu_last = 0;
+	peripheral_cfg->ccu_cfg.nop_frame = false;
+	frame = &gi2c->ccu.gpi[idx].frame[gi2c->ccu.gpi[idx].recvd_cnt];
+	frame->msgs = 1;
+
+	flags = DMA_PREP_INTERRUPT | DMA_CTRL_ACK;
+
+	desc = dmaengine_prep_slave_single(gi2c->tx_c[idx], NULL, 0, DMA_MEM_TO_DEV, flags);
+	if (!desc) {
+		dev_err(gi2c->se.dev, "prep_slave_sg failed\n");
+		ret = -EIO;
+		goto err_submit;
+	}
+
+	desc->callback_result = i2c_gpi_cb_result;
+	desc->callback_param = peripheral_cfg;
+
+	cookie = dmaengine_submit(desc);
+	if (dma_submit_error(cookie)) {
+		dev_err(gi2c->se.dev, "%s: dmaengine_submit failed (%d)\n",
+			__func__, cookie);
+		dmaengine_desc_free(desc);
+		ret = -EIO;
+		goto err_submit;
+	}
+
+	dma_async_issue_pending(gi2c->tx_c[idx]);
+	/* Async transfer mode support only write transfer */
+	if (frame->async && !(gi2c->cur->flags & I2C_M_RD))
+		goto skip_completion;
+
+	time_left = wait_for_completion_timeout(&gi2c->done, XFER_TIMEOUT);
+	if (!time_left)
+		gi2c->err = -ETIMEDOUT;
+
+skip_completion:
+	if (gi2c->ccu.gpi[idx].recvd_cnt >= MAX_NUM_FRAMES -1)
+		gi2c->ccu.gpi[idx].recvd_cnt = 0;
+	else
+		gi2c->ccu.gpi[idx].recvd_cnt++;
+
+	if (gi2c->err) {
+		ret = gi2c->err;
+		goto err;
+	}
+
+	kfree(gi2c->ccu.msg[0]);
+	gi2c->ccu.msg[0] = NULL;
+	return 0;
+
+err:
+	dev_err(gi2c->se.dev, "%s: GPI transfer failed: %d\n", __func__, ret);
+	dmaengine_terminate_sync(gi2c->rx_c[idx]);
+	dmaengine_terminate_sync(gi2c->tx_c[idx]);
+
+err_submit:
+	kfree(gi2c->ccu.msg[0]);
+	gi2c->ccu.msg[0] = NULL;
+
+	return ret;
+}
