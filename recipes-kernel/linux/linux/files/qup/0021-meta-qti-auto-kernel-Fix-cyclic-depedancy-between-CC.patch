+		config_delay_t geni_i2c_configure_pre_delay,
+		geni_i2c_irq_t geni_i2c_process_irq)
+{
+	ccu_on_off = geni_i2c_power_on_off;
+	ccu_recover = geni_i2c_check_recover_ios_line;
+	ccu_cfg_mode = geni_i2c_configure_ccu_mode;
