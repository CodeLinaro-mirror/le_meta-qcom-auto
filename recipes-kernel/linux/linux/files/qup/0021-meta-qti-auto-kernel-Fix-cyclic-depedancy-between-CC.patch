-	peripheral_cfg->ccu_cfg.nop_frame = gi2c->ccu.msg[idx]->nop_frame;
-	peripheral_cfg->post_delay = gi2c->ccu.msg[idx]->post_delay;
-	peripheral_cfg->pre_delay = gi2c->ccu.msg[idx]->pre_delay;
