+#include <linux/soc/qcom/qcom_ccu_qup.h>
 #include <linux/soc/qcom/geni-se.h>
 #include "../dmaengine.h"
 #include "../virt-dma.h"
@@ -328,10 +329,6 @@ enum CNTXT_OFFS {
 	: (0x2005C + (0x4000 * (n)) + (0x80 * (k))))
