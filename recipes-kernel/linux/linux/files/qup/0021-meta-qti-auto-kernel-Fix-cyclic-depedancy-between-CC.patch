-/* GPII general control register */
-#define GPI_REE_CFG_OFFS			0x38
-#define GPI_RFE_INT_FAIR_RR_ARB_EN		BIT(16)
-
 /* Scratch registers */
 #define GPII_n_CH_k_SCRATCH_0_OFFS(n, k, ccu)\
 	((ccu) ? (0x20060 + (0x1000 * (n)) + (0x80 * (k)))\
@@ -708,7 +705,6 @@ struct gpii {
 	bool configured_irq;
 	enum gpi_pm_state pm_state;
 	rwlock_t pm_lock;
-	rwlock_t irq_lock;
 	struct gpi_ring ev_ring;
 	struct tasklet_struct ev_task; /* event processing tasklet */
 	struct completion cmd_completion;
@@ -858,8 +854,9 @@ void ccu_gpi_configure_mode(struct dma_chan *chan, int mode, int type)
 	gchan->ch_type = type;
 	if (mode) {
 		/* Enable the Global & IEOB IRQ of GPII in CDM mode */
-		gpi_update_reg(gpii, GPII_n_CNTXT_TYPE_COMP_IRQ_MSK_OFFS(gpii->gpii_id, gpii->gpi_dev->cfg.irq_off),
-			       GPII_n_CNTXT_TYPE_COMP_IRQ_MSK_BMSK, enable);
+		gpi_update_reg(gpii, GPII_n_CNTXT_TYPE_COMP_IRQ_MSK_OFFS(gpii->gpii_id,
+					   gpii->gpi_dev->cfg.irq_off),
+					   GPII_n_CNTXT_TYPE_COMP_IRQ_MSK_BMSK, enable);
 	}
 }
 EXPORT_SYMBOL(ccu_gpi_configure_mode);
@@ -1278,14 +1275,24 @@ static irqreturn_t gpi_handle_irq(int irq, void *data)
 }
 
 /* Handle IRQ for GPII */
-void ccu_gpi_handle_isr(void *dev, int idx)
+static void ccu_gpi_handle_isr(struct platform_device *pdev, int idx)
 {
-	struct gpi_dev *gpi = (struct gpi_dev *)dev;
-	struct gpii *gpii = &gpi->gpiis[idx];
+	struct gpi_dev *gpi;
+	struct gpii *gpii;
 
-	process_gpi_irq(gpii);
+	if (!pdev) {
+		pr_err("%s: pdev is NULL\n", __func__);
+		return;
+	}
+
+	gpi = platform_get_drvdata(pdev);
+	gpii = &gpi->gpiis[idx];
+
+	if (gpii->gchan[0].ch_ring.configured)
+		process_gpi_irq(gpii);
+	else
+		dev_err(gpii->gpi_dev->dev, "GPII[%d] is not configured\n", idx);
 }
-EXPORT_SYMBOL(ccu_gpi_handle_isr);
 
 /* process CCU Error notification event */
 static void gpi_process_ccu_error_event(struct gchan *gchan,
@@ -2744,7 +2751,8 @@ static void gpi_free_chan_resources(struct dma_chan *chan)
 	/* free all allocated memory */
 	gpi_free_ring(&gchan->ch_ring, gpii);
 	vchan_free_chan_resources(&gchan->vc);
-	kfree(gchan->config);
+	if (gchan->config)
+		kfree(gchan->config);
 
 	write_lock_irq(&gpii->pm_lock);
 	gchan->pm_state = DISABLE_STATE;
@@ -2952,8 +2960,10 @@ static int gpi_probe(struct platform_device *pdev)
 	if (!data)
 		return -EINVAL;
 
-	if (data->is_ccu_qup)
+	if (data->is_ccu_qup) {
 		gpi_dev->cfg = *data;
+		register_gpi_irq(ccu_gpi_handle_isr);
+	}
 
 	gpi_dev->ee_base = gpi_dev->ee_base - data->ee_offset;
 
@@ -3024,7 +3034,7 @@ static int gpi_probe(struct platform_device *pdev)
 			gchan->gpii = gpii;
 			gchan->dir = GPII_CHAN_DIR[chan];
 		}
-		/* */
+
 		mutex_init(&gpii->ctrl_lock);
 		rwlock_init(&gpii->pm_lock);
 
