 	}
 }
 
-static irqreturn_t geni_i2c_irq(int irq, void *dev)
+static void process_i2c_irq(int irq, void *dev)
 {
 	struct geni_i2c_dev *gi2c = dev;
 	void __iomem *base = gi2c->se.base;
@@ -898,10 +904,32 @@ static irqreturn_t geni_i2c_irq(int irq, void *dev)
 		complete(&gi2c->done);
 
 	spin_unlock(&gi2c->lock);
+}
 
+static irqreturn_t geni_i2c_irq(int irq, void *dev)
+{
+	process_i2c_irq(irq, dev);
 	return IRQ_HANDLED;
 }
 
+void geni_i2c_process_irq(struct i2c_adapter *adap)
+{
+	struct geni_i2c_dev *gi2c;
+
+	if (!adap) {
+		pr_err("%s: Adap is NULL\n", __func__);
+		return;
+	} else {
+		gi2c = adap->dev.driver_data;
+		if (!gi2c) {
+			pr_err("%s: I2C driver data is NULL\n", __func__);
+			return;
+		}
+	}
+	process_i2c_irq(gi2c->irq, gi2c);
+}
+
+
 static void geni_i2c_abort_xfer(struct geni_i2c_dev *gi2c)
 {
 	unsigned long time_left = ABORT_TIMEOUT;
