@@ -1514,6 +1555,18 @@ static int geni_i2c_gpi_xfer(struct geni_i2c_dev *gi2c, struct i2c_msg msgs[], i
 			idx = (gi2c->ccu.msg[i]->gpii_no % CCU_MAX_GPII);
 			frame = &gi2c->ccu.gpi[idx].frame[gi2c->ccu.gpi[idx].recvd_cnt];
 
+			if ((msgs[i].flags & I2C_M_RD) && (gi2c->ccu.msg[i]->pkt_len  > 0)){
+				dev_err(gi2c->se.dev, "Invalid Request for RD msg: Tx Sub pkt len:%d, msg:%d\n",
+					gi2c->ccu.msg[i]->pkt_len, i);
+					return -EINVAL;
+			}
+
+			if (gi2c->ccu.msg[i]->pkt_len > msgs[i].len) {
