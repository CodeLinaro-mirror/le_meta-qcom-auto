 	gi2c->ccu.msg[msg_idx]->priority = CCU_GET_PRIO(data);
 	gi2c->ccu.msg[msg_idx]->nop_frame = CCU_GET_NOP_FRAME(data);
 	gi2c->ccu.msg[msg_idx]->pre_delay = CCU_GET_INSERT_DELAY_BEFORE(data);
@@ -1436,6 +1475,7 @@ static int geni_i2c_extract_frame_cfg(struct geni_i2c_dev *gi2c, struct i2c_msg
 	gi2c->ccu.msg[msg_idx]->ccu_last = CCU_GET_LAST(data);
 	gi2c->ccu.msg[msg_idx]->arb_lost_retry = CCU_GET_ARB_LOST_CNT(data);
 	gi2c->ccu.msg[msg_idx]->pkt_len = CCU_GET_PKT_LEN(data);
+
 	gpii_idx = gi2c->ccu.msg[msg_idx]->gpii_no % CCU_MAX_GPII;
 	frame_idx = gi2c->ccu.gpi[gpii_idx].recvd_cnt;
 	gi2c->ccu.gpi[gpii_idx].frame[frame_idx].async = CCU_GET_ASYNC(data);
@@ -1448,7 +1488,7 @@ static int geni_i2c_extract_frame_cfg(struct geni_i2c_dev *gi2c, struct i2c_msg
 				  "GPII:%d Sync:%d Prio:%d Delay after:%d\n"
 				  "Delay Before:%d ch_last:%d ccu_last:%d\n"
 				  "arb_lost_retry:%d pkt_len:%d\n"
