 drivers/i2c/busses/i2c-qcom-geni.c    | 71 +++++++++++++++++++++++----
 drivers/soc/qcom/qcom_ccu_qup.c       | 32 +++++++++---
 include/linux/soc/qcom/qcom_ccu_qup.h |  6 ++-
