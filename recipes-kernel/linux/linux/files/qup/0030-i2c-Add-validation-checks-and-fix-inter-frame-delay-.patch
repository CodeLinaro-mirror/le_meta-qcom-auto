diff --git a/drivers/dma/qcom/gpi.c b/drivers/dma/qcom/gpi.c
index a922b0421e73..bffd65d5707a 100644
--- a/drivers/dma/qcom/gpi.c
+++ b/drivers/dma/qcom/gpi.c
@@ -79,8 +79,8 @@
 #define TRE_I2C_C0_TX_PACK	BIT(24)
 #define TRE_I2C_C0_RX_PACK      BIT(25)
 
-/* I2C Config WD1 */
-#define TRE_I2C_C1_DELAY	GENMASK(21, 16)
+/* I2C Config0 WD1 */
+#define TRE_I2C_C0_DELAY	GENMASK(31, 16)
 
 /* I2C GO WD0 */
 #define TRE_I2C_GO_CMD          GENMASK(4, 0)
@@ -1081,9 +1081,7 @@ static void gpi_process_ieob(struct gpii *gpii)
 {
 	struct gchan *chan = &gpii->gchan[0];
 
-	/* In CDM mode, client should clear the IEOB IRQ so skip it*/
-	if (!chan->mode)
-		gpi_write_reg(gpii, gpii->ieob_clr_reg, BIT(0));
+	gpi_write_reg(gpii, gpii->ieob_clr_reg, BIT(0));
 
 	gpi_config_interrupts(gpii, MASK_IEOB_SETTINGS, 0);
 	tasklet_hi_schedule(&gpii->ev_task);
@@ -1153,6 +1151,7 @@ static void gpi_process_glob_err_irq(struct gpii *gpii)
 	u32 offset = GPII_n_CNTXT_GLOB_IRQ_STTS_OFFS
 			(gpii_id, gpii->gpi_dev->cfg.irq_off);
 	u32 irq_stts = gpi_read_reg(gpii, gpii->regs + offset);
+	u32 status = 0;
 
 	offset = GPII_n_CNTXT_GLOB_IRQ_CLR_OFFS(gpii_id, gpii->gpi_dev->cfg.irq_off);
 	gpi_write_reg(gpii, gpii->regs + offset, irq_stts);
@@ -1165,6 +1164,8 @@ static void gpi_process_glob_err_irq(struct gpii *gpii)
 	}
 
 	offset = GPII_n_ERROR_LOG_OFFS(gpii_id, gpii->gpi_dev->cfg.irq_off);
+	status = gpi_read_reg(gpii, gpii->regs + offset);
+	dev_err(gpii->gpi_dev->dev, "GLOBAL Error LOG Reg:0x%x\n", status);
 	gpi_write_reg(gpii, gpii->regs + offset, 0);
 }
 
@@ -2343,7 +2344,7 @@ static int gpi_create_i2c_tre(struct gchan *chan, struct gpi_desc *desc,
 		tre->dword[0] |= u32_encode_bits(i2c->pack_enable, TRE_I2C_C0_TX_PACK);
 		tre->dword[0] |= u32_encode_bits(i2c->pack_enable, TRE_I2C_C0_RX_PACK);
 
-		tre->dword[1] |= u32_encode_bits(i2c->delay, TRE_I2C_C1_DELAY);
+		tre->dword[1] |= u32_encode_bits(i2c->delay, TRE_I2C_C0_DELAY);
 
 		tre->dword[2] = u32_encode_bits(i2c->clk_div, TRE_C0_CLK_DIV);
 		tre->dword[2] |= u32_encode_bits(i2c->ccu_cfg.retry, TRE_C0_RETRY);
diff --git a/drivers/i2c/busses/i2c-qcom-geni.c b/drivers/i2c/busses/i2c-qcom-geni.c
index ec553f916619..4461f4988be1 100644
--- a/drivers/i2c/busses/i2c-qcom-geni.c
+++ b/drivers/i2c/busses/i2c-qcom-geni.c
@@ -112,6 +112,7 @@ struct geni_i2c_desc {
 #define CCU_FRAME_COOKIE_SHFT	32
 
 #define CCU_MAX_GPII		3
+#define CCU_MAX_GPII_NUM	14
 #define REGULAR_GPII		0
 #define MAX_NUM_MSGS		4096
 #define MAX_NUM_FRAMES		4
@@ -127,6 +128,9 @@ struct geni_i2c_desc {
 #define CCU_GET_PKT_LEN(val)		((val & CCU_PKT_LEN_MASK) >> CCU_PKT_LEN_SHFT)
 #define CCU_GET_FRAME_COOKIE(val)	((val & CCU_FRAME_COOKIE_MASK) >> CCU_FRAME_COOKIE_SHFT)
 
+#define NSEC_PER_SEC		1000000000L
+#define NSEC_PER_USEC		1000L
+
 /*
  * struct ccu_msg_info - represent single message
  * @len: length of current message
@@ -208,7 +212,7 @@ struct ccu_i2c_config {
 	struct ccu_msg_config *msg[MAX_NUM_MSGS];
 	int idx;
 	int mode;
-	unsigned long inter_delay;
+	u16 inter_delay;
 	struct ccu_gpii_info gpi[CCU_MAX_GPII];
 	struct ccu_xfer_result result;
 };
@@ -603,7 +607,7 @@ static int geni_i2c_configure_ccu_mode(struct i2c_adapter *adap, int gpii_no,
 				int ch_type, bool mode)
 {
 	struct geni_i2c_dev *gi2c;
-	int idx = (gpii_no % CCU_MAX_GPII);
+	int idx;
 	int ret = 0;
 
 	if (!adap) {
@@ -617,6 +621,12 @@ static int geni_i2c_configure_ccu_mode(struct i2c_adapter *adap, int gpii_no,
 		}
 	}
 
+	if (gpii_no > CCU_MAX_GPII_NUM) {
+		dev_err(gi2c->se.dev, "%s: Invalid request of GPII:%d\n", __func__, gpii_no);
+		return -EINVAL;
+	}
+	idx = (gpii_no % CCU_MAX_GPII);
+
 	if ((ch_type != 1 && ch_type != 2) || idx < 0) {
 		dev_err(gi2c->se.dev, "%s: Invalid request, ch_type:%d, mode:%d gpii_no:%d\n",
 			__func__, ch_type, mode, gpii_no);
@@ -660,7 +670,7 @@ static int geni_i2c_gpii_reset(struct i2c_adapter *adap, int gpii_no,
 			bool premature_cancel)
 {
 	struct geni_i2c_dev *gi2c;
-	int idx = (gpii_no % CCU_MAX_GPII);
+	int idx = gpii_no % CCU_MAX_GPII;
 	int ret = 0;
 
 	if (!adap) {
@@ -707,9 +717,10 @@ static int geni_i2c_gpii_reset(struct i2c_adapter *adap, int gpii_no,
  *
  * Return none.
  */
-static void geni_i2c_configure_pre_delay(struct i2c_adapter *adap, unsigned long time)
+static void geni_i2c_configure_pre_delay(struct i2c_adapter *adap, unsigned long delay)
 {
 	struct geni_i2c_dev *gi2c;
+	unsigned int delay_cycle = 0;
 
 	if (!adap) {
 		pr_err("%s: Adap is NULL\n", __func__);
@@ -722,7 +733,23 @@ static void geni_i2c_configure_pre_delay(struct i2c_adapter *adap, unsigned long
 		}
 	}
 
-	gi2c->ccu.inter_delay = time;
+	/*
+	 * The inter-frame delay field in the Config TRE is limited to 16 bits,
+	 * which restricts the maximum number of clock pulses that can be used
+	 * to introduce a delay between transfers.
+	 */
+	if (((delay > 65535) && (gi2c->clk_freq_out == KHZ(1000))) ||
+		((delay > 163838) && (gi2c->clk_freq_out == KHZ(400))) ||
+		((delay > 655350) && (gi2c->clk_freq_out == KHZ(100)))) {
+			dev_err(gi2c->se.dev, "%s: Invalid delay:%d received for %d frequency\n",
+				__func__, delay, gi2c->clk_freq_out);
+			return;
+	}
+
+	delay_cycle = ((1*NSEC_PER_SEC)/gi2c->clk_freq_out);
+	gi2c->ccu.inter_delay = ((delay *NSEC_PER_USEC)/delay_cycle);
+	dev_dbg(gi2c->se.dev, "%s: Received delay in(Us): %d delay_cycle:%d\n",
+		__func__, delay, gi2c->ccu.inter_delay);
 }
 
