 	msg_buf = kmemdup(msg->buf, CCU_DATA_OFFSET, GFP_KERNEL);
 	if (!msg_buf) {
 		dev_err(gi2c->se.dev, "%s:  Memory allocation failed\n", __func__);
@@ -1428,6 +1461,12 @@ static int geni_i2c_extract_frame_cfg(struct geni_i2c_dev *gi2c, struct i2c_msg
 	data = *msg_buf;
 
