-static void  geni_i2c_release_buf(struct geni_i2c_dev *gi2c, int idx)
+static void geni_i2c_gpi_release_ccu_frame(struct geni_i2c_dev *gi2c, struct ccu_frame_info *frame)
 {
-	int i, msgs, frame_idx;
