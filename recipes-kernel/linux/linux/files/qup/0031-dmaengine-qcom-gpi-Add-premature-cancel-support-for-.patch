@@ -667,7 +668,7 @@ static int geni_i2c_configure_ccu_mode(struct i2c_adapter *adap, int gpii_no,
  * Return 0 on success and error on failure.
  */
 static int geni_i2c_gpii_reset(struct i2c_adapter *adap, int gpii_no,
-			bool premature_cancel)
+			       bool premature_cancel)
 {
 	struct geni_i2c_dev *gi2c;
 	int idx = gpii_no % CCU_MAX_GPII;
@@ -684,24 +685,28 @@ static int geni_i2c_gpii_reset(struct i2c_adapter *adap, int gpii_no,
 		}
 	}
 
-	if (premature_cancel)
+	if (premature_cancel) {
+		if (idx == REGULAR_GPII) {
+			dev_err(gi2c->se.dev, "%s: premature cancel is invalid for a regular channel:%d\n",
+				__func__, gpii_no);
+			return -EINVAL;
+		}
 		ccu_gpi_set_premature_cancel_flag(gi2c->tx_c[idx]);
+	}
 
 	if (gi2c->tx_c[idx]) {
-		ret = dmaengine_terminate_all(gi2c->tx_c[idx]);
+		ret = dmaengine_terminate_sync(gi2c->tx_c[idx]);
 		if (ret) {
-			dev_err(gi2c->se.dev, "%s: gpi terminate failed for tx_c[%d]ret:%d\n",
-				__func__, ret, idx);
+			dev_err(gi2c->se.dev, "%s: gpi terminate failed for tx_c[%d] ret:%d\n",
+				__func__, idx, ret);
 			return ret;
 		}
-	}
 
