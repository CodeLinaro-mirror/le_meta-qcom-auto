+++ b/drivers/soc/qcom/qcom_ccu_qup.c
@@ -448,6 +448,10 @@ int ccu_gpii_reset(struct i2c_adapter *adap, int gpii_no, bool partial,
 			return ret;
 	} else {
 		for (i = 0; i < CCU_MAX_GPII_PER_SE; i++) {
+			/* Skip premature cancel for regular channel */
+			if (premature_cancel && i == 0)
+				continue;
+
 			ret = ccu_reset(adap, i, premature_cancel);
 			if (ret)
 				return ret;
