+}
+
+/*
+ * geni_i2c_release_buf - This function is used to free the dma buffer
+ *
+ * @gi2c: Handle of the I2C device.
+ * @idx: indicate the gpii no
+ */
+static void  geni_i2c_release_buf(struct geni_i2c_dev *gi2c, int idx)
+{
+	int frame_idx;
+
+	frame_idx = gi2c->ccu.gpi[idx].released_cnt;
+
+	geni_i2c_gpi_release_ccu_frame(gi2c, &gi2c->ccu.gpi[idx].frame[frame_idx]);
 
 	if (frame_idx >= MAX_NUM_FRAMES -1)
 		gi2c->ccu.gpi[idx].released_cnt = 0;
@@ -1263,12 +1279,19 @@ static void geni_i2c_gpi_unmap(struct geni_i2c_dev *gi2c, struct i2c_msg *msg,
 {
 	if (tx_buf) {
 		dma_unmap_single(gi2c->se.dev->parent, tx_addr, msg->len, DMA_TO_DEVICE);
-		i2c_put_dma_safe_msg_buf(tx_buf, msg, !gi2c->err);
+		if (gi2c->is_ccu_qup) {
+			kfree(tx_buf);
+			tx_buf = NULL;
