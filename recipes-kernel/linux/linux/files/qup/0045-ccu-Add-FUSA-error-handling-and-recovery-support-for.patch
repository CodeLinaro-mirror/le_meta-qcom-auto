+/*
+ * geni_i2c_dmaengine_terminate_sync - Wrap dmaengine_terminate_sync with GPII state synchronization
+ * @gi2c: GENI I2C device pointer
+ * @idx: GPII channel index
+ *
+ * Wrap dmaengine_terminate_sync for the specified GPII channel. For CCU QUP,
+ * acquire the GPII state mutex, check and update GPII state to avoid repeated resets,
+ * terminate DMA transfer, and mark reset done. Synchronize state transitions to ensure
+ * correct operation.
+ *
+ * Return: 0 if already reset, or result of dmaengine_terminate_sync.
+ */
+static int geni_i2c_dmaengine_terminate_sync(struct geni_i2c_dev *gi2c, u8 idx)
+{
+	int ret;
+
+	mutex_lock(&gi2c->ccu->gpii[idx].state_lock);
+
+	if (gi2c->ccu->gpii[idx].state == GPII_RESET_DONE ||
+	    gi2c->ccu->gpii[idx].state == GPII_IDLE) {
+		I2C_DBG_LOG(LOG_LVL_INFO, gi2c->se.dev, "Skipped GPII reset, idx:%d, state:%d\n",
+			    idx, gi2c->ccu->gpii[idx].state);
+		mutex_unlock(&gi2c->ccu->gpii[idx].state_lock);
+		return 0; /* Already reset */
+	}
+
+	gi2c->ccu->gpii[idx].state = GPII_RESET_IN_PROGRESS;
+
+	ret = dmaengine_terminate_sync(gi2c->tx_c[idx]);
+
+	gi2c->ccu->gpii[idx].state = GPII_RESET_DONE;
+
+	mutex_unlock(&gi2c->ccu->gpii[idx].state_lock);
+
+	return ret;
+}
