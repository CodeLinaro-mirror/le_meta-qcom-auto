+static int ccu_qup_fusa_irq_get_status(struct ccu_qup *ccu, u8 qup_idx)
 {
+	void __iomem *base;
+	u32 status, qup_reset_mask = 0;
+
+	if (atomic_read(&ccu->ip_reset_in_progress)) {
+		CCU_ERR_LOG(LOG_LVL_ERROR, ccu->dev,
+			    "Please retry after CCU IP reset operation completes\n");
+		return -EAGAIN;
+	}
+
+	if (qup_idx > CCU_MAX_QUP) {
+		CCU_ERR_LOG(LOG_LVL_ERROR, ccu->dev,
+			    "%s: Invalid qup_idx:%d\n", __func__, qup_idx);
+		return -EINVAL;
+	}
+
+	base = ccu->qup_fusa_fault_aggregator[qup_idx];
+	if (!base) {
+		CCU_ERR_LOG(LOG_LVL_ERROR, ccu->dev,
+			    "%s: No base addr found for qup_idx:%d\n", __func__, qup_idx);
+		return -EINVAL;
+	}
+
+	for (enum ccu_fusa_irq_set irq_set_num = CCU_FUSA_IRQ_SET_0;
+		irq_set_num < CCU_MAX_FUSA_IRQ_SET; irq_set_num++) {
+		status = readl_relaxed(base + CCU_QUPV3_FUSA_IRQ_STATUS_n(irq_set_num));
+		writel_relaxed(status, base + CCU_QUPV3_FUSA_IRQ_CLEAR_n(irq_set_num));
+		writel_relaxed(FUSA_IRQ_CMD_CLEAR_CMD, base + CCU_QUPV3_FUSA_IRQ_CMD);
+
+		CCU_DBG_LOG(LOG_LVL_VERBOSE, ccu->dev,
+			    "%s: qup_idx:%d FUSA_IRQ_SET:%d status:0x%x\n",
+			    __func__, qup_idx, irq_set_num, status);
+		if (ccu_qup_update_qup_reset_mask(status, irq_set_num, &qup_reset_mask)) {
+			atomic_set(&ccu->ip_reset_in_progress, 1);
+			break;
+		}
+	}
+
+	CCU_DBG_LOG(LOG_LVL_VERBOSE, ccu->dev, "%s: qup_idx:%d: qup_reset_mask:0x%x\n",
+		    __func__, qup_idx, qup_reset_mask);
+
+	return qup_reset_mask;
+}
