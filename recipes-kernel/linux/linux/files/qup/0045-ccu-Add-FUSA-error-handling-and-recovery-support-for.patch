+/*
+ * geni_i2c_ccu_fusa_ecc_setup () - Setup FUSA ECC logger enablement
+ * @gi2c: pointer to i2c dev structure
+ *
+ * This function clears ECC-related FIFOs and counters, then enables them
+ * to activate ECC logger enblement functionality for the I2C CCU.
+ *
+ * Return none.
+ */
+void geni_i2c_ccu_fusa_ecc_setup(struct geni_i2c_dev *gi2c)
+{
+	u32 val;
+
+	writel(ECC_FIFO_CLEAR, gi2c->se.base + SE_GENI_ECC_CLEAR_FIFO_0);
+	writel(ECC_FIFO_ENABLE, gi2c->se.base + SE_GENI_ECC_CLEAR_FIFO_0);
+	writel(ECC_FIFO_CLEAR, gi2c->se.base + SE_GENI_ECC_CLEAR_FIFO_1);
+	writel(ECC_FIFO_ENABLE, gi2c->se.base + SE_GENI_ECC_CLEAR_FIFO_1);
+	writel(ECC_IRQ_SEC_ENABLE, gi2c->se.base + SE_GENI_ECC_IRQ_SEC_0);
+	writel(ECC_IRQ_SEC_ENABLE, gi2c->se.base + SE_GENI_ECC_IRQ_SEC_1);
+	writel(ECC_SEC_DED_AED_COUNTER_CLEAR, gi2c->se.base + SE_GENI_ECC_CLEAR_COUNTER_0);
+	writel(ECC_SEC_DED_AED_COUNTER_ENABLE, gi2c->se.base + SE_GENI_ECC_CLEAR_COUNTER_0);
+	writel(ECC_SEC_DED_AED_COUNTER_CLEAR, gi2c->se.base + SE_GENI_ECC_CLEAR_COUNTER_1);
+	writel(ECC_SEC_DED_AED_COUNTER_ENABLE, gi2c->se.base + SE_GENI_ECC_CLEAR_COUNTER_1);
+
+	val = readl_relaxed(gi2c->se.base + SE_GENI_CFG_REG67);
+	val &= ~(M_AUTO_OPCODE_CANCEL);
+	writel_relaxed(val, gi2c->se.base + SE_GENI_CFG_REG67);
+	val = readl_relaxed(gi2c->se.base + SE_GENI_CFG_REG67);
+
+	/* Ensure all relaxed MMIO writes are flushed and CFG_REG67 read-back is complete */
+	mb();
+	I2C_ERR_LOG(LOG_LVL_ERROR, gi2c->se.dev,
+		    "%s: done, CFG_REG67:0x%x\n", __func__, val);
+}
