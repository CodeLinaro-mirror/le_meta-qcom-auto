+/* processing transfer qup notification events */
+static void gpi_process_qup_notif_event(struct gchan *gchan,
+					struct qup_notif_event *notif_event)
+{
+	struct gpii *gpii = gchan->gpii;
+	struct virt_dma_desc *vd;
+	struct gpi_desc *gpi_desc;
+	struct dmaengine_result result;
+	unsigned long flags;
+
+	/*
+	 * If channel not active don't process event
+	 */
+	if (unlikely(gchan->pm_state != ACTIVE_STATE)) {
+		GPI_ERR_LOG(LOG_LVL_ERROR, gpii->gpi_dev->dev,
+			    "skipping processing event because ch @ %s state\n",
+			    TO_GPI_PM_STR(gchan->pm_state));
+		return;
+	}
+
+	spin_lock_irqsave(&gchan->vc.lock, flags);
+	vd = vchan_next_desc(&gchan->vc);
+	if (!vd) {
+		struct gpi_ere *gpi_ere;
+
+		spin_unlock_irqrestore(&gchan->vc.lock, flags);
+		GPI_ERR_LOG(LOG_LVL_ERROR, gpii->gpi_dev->dev,
+			    "Event without a pending descriptor!\n");
+		gpi_ere = (struct gpi_ere *)notif_event;
+		GPI_ERR_LOG(LOG_LVL_ERROR, gpii->gpi_dev->dev,
+			    "Event: %08x %08x %08x %08x\n",
+			    gpi_ere->dword[0], gpi_ere->dword[1],
+			    gpi_ere->dword[2], gpi_ere->dword[3]);
+		return;
+	}
+
+	gpi_desc = to_gpi_desc(vd);
+	spin_unlock_irqrestore(&gchan->vc.lock, flags);
+
+	result.result = DMA_TRANS_WRITE_FAILED;
+
+	result.residue = 0;
+	result.gpii_id = gpii->gpii_id;
+	GPI_DBG_LOG(LOG_LVL_VERBOSE, gpii->gpi_dev->dev,
+		    "GPII:%d QUP notif_event status:%d\n", gpii->gpii_id, notif_event->status);
+
+	dma_cookie_complete(&vd->tx);
+	if (gchan->protocol == QCOM_GPI_I2C) {
+		struct dmaengine_desc_callback cb;
+		struct gpi_i2c_config *i2c;
+
+		dmaengine_desc_get_callback(&vd->tx, &cb);
+		i2c = cb.callback_param;
+		i2c->status = notif_event->status;
+		dmaengine_desc_callback_invoke(&cb, &result);
+	}
+
+	spin_lock_irqsave(&gchan->vc.lock, flags);
+	list_del(&vd->node);
+	spin_unlock_irqrestore(&gchan->vc.lock, flags);
+	kfree(gpi_desc);
+	gpi_desc = NULL;
+}
