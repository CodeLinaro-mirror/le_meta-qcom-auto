From 7e5742a14d5124865693fb6c6dbb570b66f03cbb Mon Sep 17 00:00:00 2001
From: Aniket Randive <aniket.randive@oss.qualcomm.com>
Date: Wed, 29 Jul 2026 10:25:04 +0530
Subject: [PATCH 1/2] ccu: Fix NULL pointer dereference caused by shared state
 race

A kernel panic occurs when multiple clients concurrently execute
ccu_config_write(). The function stores per-call configuration,
adapter, and client data in shared ccu fields without serialization,
allowing one thread to free and clear ccu->cfg while another thread
is still accessing it, resulting in a NULL pointer dereference.

Avoid sharing per-call state across clients. Use the existing
stack-based ccu_qup_config instead of allocating ccu->cfg, and keep
i2c_adapter and i2c_client instances local to the call path.
Return the adapter through an output parameter and pass local
references to command handlers, eliminating the race on shared
pointers.

Change-Id: If681b514219b37c865191bcbb05e5202f9328155
Signed-off-by: Aniket Randive <aniket.randive@oss.qualcomm.com>
---
 drivers/i2c/busses/i2c-qcom-geni.c |   2 +-
 drivers/soc/qcom/qcom_ccu_qup.c    | 100 +++++++++++------------------
 2 files changed, 38 insertions(+), 64 deletions(-)

diff --git a/drivers/i2c/busses/i2c-qcom-geni.c b/drivers/i2c/busses/i2c-qcom-geni.c
index 86080363ef22..c715e37d8c0d 100644
--- a/drivers/i2c/busses/i2c-qcom-geni.c
+++ b/drivers/i2c/busses/i2c-qcom-geni.c
@@ -431,7 +431,7 @@ void geni_i2c_ccu_fusa_ecc_setup(struct geni_i2c_dev *gi2c)
 
 	/* Ensure all relaxed MMIO writes are flushed and CFG_REG67 read-back is complete */
 	mb();
-	I2C_ERR_LOG(LOG_LVL_ERROR, gi2c->se.dev,
+	I2C_DBG_LOG(LOG_LVL_INFO, gi2c->se.dev,
 		    "%s: done, CFG_REG67:0x%x\n", __func__, val);
 }
 
diff --git a/drivers/soc/qcom/qcom_ccu_qup.c b/drivers/soc/qcom/qcom_ccu_qup.c
