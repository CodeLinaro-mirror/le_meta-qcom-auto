+/* NOOP TRE */
+static void gpi_noop_tre(struct gpii *gpii, struct gchan *gchan)
+{
+	struct gpi_ring *ring = &gchan->ch_ring;
+	struct gpi_tre *tre;
+	phys_addr_t local_rp, local_wp;
+	void *cntxt_rp;
+	u32 noop_mask, noop_tre;
+
+	local_rp = to_physical(ring, ring->rp);
+	local_wp = to_physical(ring, ring->wp);
+	cntxt_rp = ring->rp;
+
+	dev_dbg(gpii->gpi_dev->dev, "local_rp:0x%11llx, local_wp:0x%11llx\n",
+		local_rp, local_wp);
+
+	noop_mask = NOOP_TRE_MASK(1, 0, 0, 0, 1);
+	noop_tre = NOOP_TRE;
+
+	while (local_rp != local_wp) {
+		tre = (struct gpi_tre *)cntxt_rp;
+		dev_dbg(gpii->gpi_dev->dev, "TRE: %08x %08x %08x %08x\n",
+			tre->dword[0], tre->dword[1], tre->dword[2],
+			tre->dword[3]);
+		tre->dword[3] &= noop_mask;
+		tre->dword[3] |= noop_tre;
+		local_rp += ring->el_size;
+		cntxt_rp += ring->el_size;
+		if (cntxt_rp >= (ring->base + ring->len)) {
+			cntxt_rp = ring->base;
+			local_rp = to_physical(ring, ring->base);
+		}
+	}
+}
