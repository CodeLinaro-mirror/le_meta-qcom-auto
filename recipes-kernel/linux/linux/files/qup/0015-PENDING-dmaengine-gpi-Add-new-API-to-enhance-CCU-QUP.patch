+/*
+ * ccu_gpi_prioritize_chan - This function is used to give priority
+ *                       to REGULAR channels.
+ *
+ * @chan : DMA transfer channel.
+ *
+ * Return 0 on success and failure on error.
+ */
+int ccu_gpi_prioritize_chan(struct dma_chan *chan)
+{
+	struct gchan *gchan = to_gchan(chan);
+	struct gpii *gpii = gchan->gpii;
+	struct gpi_ring *ring = &gchan->ch_ring;
+	int ret = 0;
+
+	/* Check Previous Transfer completed or not */
+	dev_dbg(gpii->gpi_dev->dev, "wp:0x%0llx rp:0x%0llx\n", ring->wp, ring->rp);
+	if (ring->wp == ring->rp) {
+		/* send command to Prioritize the channel */
+		ret = gpi_send_cmd(gpii, gchan, GPI_CH_CMD_PRIORITIZE_REG_CHAN);
+		if (ret) {
+			dev_err(gpii->gpi_dev->dev, "Error to prioritize reg Chan:%d\n", ret);
+			return -EIO;
+		}
+	} else {
+		dev_err(gpii->gpi_dev->dev, "Pending TRE's are present\n");
+		return -EAGAIN;
+	}
+
+	return 0;
+}
+EXPORT_SYMBOL(ccu_gpi_prioritize_chan);
