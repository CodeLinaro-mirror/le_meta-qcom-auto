-static int geni_i2c_runtime_resume(struct device *dev);
+/* CCU FRAME */
+#define CCU_DATA_OFFSET		8
+#define CCU_GPII_MASK		GENMASK(3, 0)
+#define CCU_ARB_LOST_MASK	GENMASK(16, 13)
+#define CCU_ARB_LOST_SHFT	13
+#define CCU_PKT_LEN_MASK	GENMASK(21, 16)
+#define CCU_PKT_LEN_SHFT	16
+#define CCU_FRAME_COOKIE_MASK	GENMASK(63, 32)
+#define CCU_FRAME_COOKIE_SHFT	32
+
+#define CCU_MAX_GPII		3
+#define REGULAR_GPII		2
+#define MAX_NUM_MSGS		4096
+#define CCU_GET_GPII(val)	(val & CCU_GPII_MASK)
+#define CCU_GET_SYNC(val)	(val & BIT(5))
+#define CCU_GET_PRIO(val)	(val & BIT(6))
+#define CCU_GET_NOP_FRAME(val)	(val & BIT(7))
+#define CCU_GET_INSERT_DELAY_BEFORE(val)	(val & BIT(8))
+#define CCU_GET_INSERT_DELAY_AFTER(val)		(val & BIT(9))
+#define CCU_GET_CH_LAST(val)		(val & BIT(11))
+#define CCU_GET_LAST(val)		(val & BIT(12))
+#define CCU_GET_ARB_LOST_CNT(val)	((val & CCU_ARB_LOST_MASK) >> CCU_ARB_LOST_SHFT)
+#define CCU_GET_PKT_LEN(val)		((val & CCU_PKT_LEN_MASK) >> CCU_PKT_LEN_SHFT)
+#define CCU_GET_FRAME_COOKIE(val)	((val & CCU_FRAME_COOKIE_MASK) >> CCU_FRAME_COOKIE_SHFT)
+
+/* struct ccu_gpii_info - represents the GPII information
+ * @type: indicate current gpii is regular or sync ch0 or sync ch1
+ * @gpii_mode_change: flag to indicate the mode change
+ */
+struct ccu_gpii_info {
+	int type; /* Regular or Sync channel */
+	bool gpii_mode_change;
+};
+
+/*
+ * struct ccu_msg_config - used to store the configuration of single frame.
+ * @gpii_no: represents the GPII no on which transfer need to send
+ * @sync: represents the synchronous or asynchornous transfer
+ * @priority: represents high priority data transfer
+ * @nop_last: when SW wants to NOP the FRAME(s)
+ * @pre_delay: insert predefined delay before I2C transaction
+ * @post_delay: insert predefined delay after I2C transaction
+ * @pkt_len: tx sub-packet length for multiple random write
+ * @arb_lost_retry: re-transmit count for arb lost in address phase
+ * @ch_last: indicates last packet (TX & RX) of a current FRAME
+ * @ccu_last: indicates end of transfer for single SYNC request
+ * @frame_cookie: indicate unique frame cookie for transfer.
+ */
+struct ccu_msg_config {
+	int gpii_no;
+	bool sync;
+	bool priority;
+	bool nop_last;
+	bool pre_delay;
+	bool post_delay;
+	int pkt_len;
+	int arb_lost_retry;
+	bool ch_last;
+	bool ccu_last;
+	int frame_cookie;
+};
+
+/*
+ * struct ccu_i2c_config - represents ccu configurations.
+ * @msg: pointer to struct ccu_msg_config
+ * @idx: indicates the index for gpii
+ * @mode: indicated CDM(1) or SYNC(0) mode
+ * @inter_delay: inter transfer delay
+ * @gpi: handle for struct ccu_gpii_info
+ */
+struct ccu_i2c_config {
+	struct ccu_msg_config *msg[MAX_NUM_MSGS];
+	int idx; /* Represents the GPII number */
+	int mode; /* CDM(1) or SYNC(0) mode */
+	unsigned long inter_delay;
+	struct ccu_gpii_info gpi[CCU_MAX_GPII];
+};
 
