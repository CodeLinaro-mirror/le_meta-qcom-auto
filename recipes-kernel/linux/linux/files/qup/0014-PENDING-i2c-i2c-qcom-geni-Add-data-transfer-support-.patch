 }
 
+/*
+ * geni_i2c_extract_frame_cfg - used to get the configuration of data xfer which is
+ * 				passed by client in msg buffer.
+ * @gi2c: points to the geni i2c dev structure
+ * @msg: points to the i2c msg structure
+ * @idx: index of message
+ *
+ * Returns 0 on success or error on failure
+ */
+static int geni_i2c_extract_frame_cfg(struct geni_i2c_dev *gi2c, struct i2c_msg *msg, int msg_idx)
+{
+	u64 data;
+	u64 *msg_buf = NULL;
+
+	if (msg->len <= CCU_DATA_OFFSET) {
+		dev_err(gi2c->se.dev, "%s: CCU config data not present. len:%d\n",
+			__func__, msg->len);
+		return -EINVAL;
+	}
+
+	msg_buf = kmemdup(msg->buf, CCU_DATA_OFFSET, GFP_KERNEL);
+	if (!msg_buf) {
+		dev_err(gi2c->se.dev, "%s:  Memory allocation failed\n", __func__);
+		return -ENOMEM;
+	}
+
+	gi2c->ccu.msg[msg_idx] = kzalloc(sizeof(struct ccu_msg_config), GFP_KERNEL);
+	if (!gi2c->ccu.msg[msg_idx]) {
+		dev_err(gi2c->se.dev, "%s:  Memory allocation failed for msg[%d]\n",
+			__func__, msg_idx);
+		kfree(msg_buf);
+		return -ENOMEM;
+	}
+	data = *msg_buf;
+
+	gi2c->ccu.msg[msg_idx]->gpii_no = CCU_GET_GPII(data);
+	gi2c->ccu.msg[msg_idx]->sync =  CCU_GET_SYNC(data);
+	gi2c->ccu.msg[msg_idx]->priority = CCU_GET_PRIO(data);
+	gi2c->ccu.msg[msg_idx]->nop_last = CCU_GET_NOP_FRAME(data);
+	gi2c->ccu.msg[msg_idx]->pre_delay = CCU_GET_INSERT_DELAY_BEFORE(data);
+	gi2c->ccu.msg[msg_idx]->post_delay = CCU_GET_INSERT_DELAY_AFTER(data);
+	gi2c->ccu.msg[msg_idx]->ch_last = CCU_GET_CH_LAST(data);
+	gi2c->ccu.msg[msg_idx]->ccu_last = CCU_GET_LAST(data);
+	gi2c->ccu.msg[msg_idx]->arb_lost_retry = CCU_GET_ARB_LOST_CNT(data);
+	gi2c->ccu.msg[msg_idx]->pkt_len = CCU_GET_PKT_LEN(data);
+	gi2c->ccu.msg[msg_idx]->frame_cookie = CCU_GET_FRAME_COOKIE(data);
+
+	i2c_trace_log(gi2c->se.dev, "%s: *** Message[%d] configuration ***\n"
+				  "GPII:%d Sync:%d Prio:%d Delay after:%d\n"
+				  "Delay Before:%d ch_last:%d ccu_last:%d\n"
+				  "arb_lost_retry:%d pkt_len:%d\n"
+				  "cookie:0x%x\n", __func__, msg_idx,
+				  gi2c->ccu.msg[msg_idx]->gpii_no,
+				  gi2c->ccu.msg[msg_idx]->sync,
+				  gi2c->ccu.msg[msg_idx]->priority,
+				  gi2c->ccu.msg[msg_idx]->post_delay,
+				  gi2c->ccu.msg[msg_idx]->pre_delay,
+				  gi2c->ccu.msg[msg_idx]->ch_last,
+				  gi2c->ccu.msg[msg_idx]->ccu_last,
+				  gi2c->ccu.msg[msg_idx]->arb_lost_retry,
+				  gi2c->ccu.msg[msg_idx]->pkt_len,
+				  gi2c->ccu.msg[msg_idx]->frame_cookie);
+	kfree(msg_buf);
+	msg_buf = NULL;
+
+	return 0;
+}
