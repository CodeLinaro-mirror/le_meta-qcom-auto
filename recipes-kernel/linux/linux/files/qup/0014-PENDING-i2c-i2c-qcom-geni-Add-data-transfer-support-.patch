 			if (ret)
 				goto err;
 
-			dma_async_issue_pending(gi2c->rx_c);
+			dma_async_issue_pending(gi2c->rx_c[idx]);
 		}
 
-		dma_async_issue_pending(gi2c->tx_c);
+		dma_async_issue_pending(gi2c->tx_c[idx]);
 
 		time_left = wait_for_completion_timeout(&gi2c->done, XFER_TIMEOUT);
 		if (!time_left)
@@ -714,15 +893,24 @@ static int geni_i2c_gpi_xfer(struct geni_i2c_dev *gi2c, struct i2c_msg msgs[], i
 		}
 
 		geni_i2c_gpi_unmap(gi2c, &msgs[i], tx_buf, tx_addr, rx_buf, rx_addr);
+		if (gi2c->is_ccu_qup)
+			kfree(gi2c->ccu.msg[i]);
 	}
-
 	return num;
 
 err:
-	I2C_ERR_LOG(LOG_LVL_ERROR, gi2c->se.dev, "GPI transfer failed: %d\n",
-		    ret);
-	dmaengine_terminate_sync(gi2c->rx_c);
-	dmaengine_terminate_sync(gi2c->tx_c);
+	dev_err(gi2c->se.dev, "GPI transfer failed: %d\n", ret);
