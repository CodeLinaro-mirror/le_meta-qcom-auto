+int geni_i2c_ccu_alloc_async_msg_bufs(struct geni_i2c_dev *gi2c)
+{
+	struct ccu_i2c_config *ccu = gi2c->ccu;
+
+	for (int i = SYNC_CH_0; i < CCU_MAX_GPII; i++) {
+		for (int j = 0; j < CCU_MAX_NUM_FRAMES; j++) {
+			for (int k = 0; k < I2C_RDWR_IOCTL_MAX_MSGS; k++) {
+				struct ccu_msg_info *msg = &ccu->gpii[i].frame[j].msg[k];
+
+				msg->buf = dmam_alloc_coherent(gi2c->se.dev->parent,
+							       CCU_MAX_MSG_BUF_SIZE,
+							       &msg->dma_addr, GFP_KERNEL);
+				if (!msg->buf) {
+					I2C_ERR_LOG(LOG_LVL_ERROR, gi2c->se.dev,
+						    "ccu frame msg buffers alloc failed gpii:%d frame:%d msg:%d\n",
+						    i, j, k);
+					return -ENOMEM;
+				}
+			}
+		}
+	}
+
+	return 0;
+}
