From 5d45d85c98fc287fa6369556f20f880305959a9c Mon Sep 17 00:00:00 2001
From: Praveen Talari <quic_ptalari@quicinc.com>
Date: Wed, 4 Dec 2024 16:14:27 +0530
Subject: [PATCH 1/3] PENDING: i2c: i2c-qcom-geni:  Add compatible field for
 SA8797P

Add compatible field for I2C driver for SA8797P.

Change-Id: If95de4c472ff30222512847ad8ceeeaf4e475042
Signed-off-by: Praveen Talari <quic_ptalari@quicinc.com>
---
 drivers/i2c/busses/i2c-qcom-geni.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/drivers/i2c/busses/i2c-qcom-geni.c b/drivers/i2c/busses/i2c-qcom-geni.c
index cfaf947de184..1df4549f2126 100644
--- a/drivers/i2c/busses/i2c-qcom-geni.c
+++ b/drivers/i2c/busses/i2c-qcom-geni.c
@@ -887,7 +887,8 @@ static int geni_i2c_probe(struct platform_device *pdev)
 	gi2c->dev_data = desc;
 
 	if (!(of_device_is_compatible(dev->of_node, "qcom,sa8255p-geni-i2c") ||
-			of_device_is_compatible(dev->of_node, "qcom,sa7255p-geni-i2c"))) {
+			of_device_is_compatible(dev->of_node, "qcom,sa7255p-geni-i2c") ||
+			of_device_is_compatible(dev->of_node, "qcom,sa8797p-geni-i2c"))) {
 		if (desc->has_core_clk) {
 			gi2c->core_clk = devm_clk_get(dev, "core");
 			if (IS_ERR(gi2c->core_clk))
@@ -1149,6 +1150,7 @@ static const struct of_device_id geni_i2c_dt_match[] = {
 	{ .compatible = "qcom,geni-i2c-master-hub", .data = &i2c_master_hub },
 	{ .compatible = "qcom,sa7255p-geni-i2c", .data = &remotely_geni_i2c },
 	{ .compatible = "qcom,sa8255p-geni-i2c", .data = &remotely_geni_i2c },
+	{ .compatible = "qcom,sa8797p-geni-i2c", .data = &remotely_geni_i2c },
 	{}
 };
 MODULE_DEVICE_TABLE(of, geni_i2c_dt_match);
-- 
