 }
 
+/*
+ * geni_i2c_release_buf - This function is used to free the dma buffer
+ *
+ * @gi2c: Handle of the I2C device.
+ * @idx: indicate the gpii no
+ */
+static void  geni_i2c_release_buf(struct geni_i2c_dev *gi2c, int idx)
+{
+	int i, msgs, frame_idx;
+	struct ccu_frame_info *frame;
+	enum dma_data_direction map_dirn;
+
+	frame_idx = gi2c->ccu.gpi[idx].released_cnt;
+	frame = &gi2c->ccu.gpi[idx].frame[frame_idx];
+	msgs = frame->msgs;
+
+	for (i = 0; i < msgs; i++) {
+		if (frame->msg[i].flag) {
+			map_dirn = DMA_FROM_DEVICE;
+			if (frame->msg[i].rx_buf) {
+				kfree(frame->msg[i].rx_buf);
+				frame->msg[i].rx_buf = NULL;
+			}
+		} else {
+			map_dirn = DMA_TO_DEVICE;
+			if (frame->msg[i].tx_buf) {
+				kfree(frame->msg[i].tx_buf);
+				frame->msg[i].tx_buf = NULL;
+			}
+		}
+		dma_unmap_single(gi2c->se.dev->parent, frame->msg[i].addr,
+				 frame->msg[i].len, map_dirn);
+	}
+	if (frame_idx >= MAX_NUM_FRAMES)
+		gi2c->ccu.gpi[idx].released_cnt = 0;
+	else
+		gi2c->ccu.gpi[idx].released_cnt++;
+}
+
 static void i2c_gpi_cb_result(void *cb, const struct dmaengine_result *result)
 {
 	struct gpi_i2c_config *i2c = cb;
 	struct geni_i2c_dev *gi2c = i2c->gi2c;
+	int gpii_idx, frame_idx;
 
 	if (i2c->status & (BIT(NACK) << 5)) {
 		geni_i2c_err(gi2c, NACK);
@@ -1006,6 +1094,21 @@ static void i2c_gpi_cb_result(void *cb, const struct dmaengine_result *result)
 			    "DMA xfer has pending: %d\n", result->residue);
 	}
 
+	gpii_idx = result->gpii_id % CCU_MAX_GPII;
+	frame_idx = gi2c->ccu.gpi[gpii_idx].released_cnt;
+	if (gi2c->is_ccu_qup && gi2c->ccu.gpi[gpii_idx].frame[frame_idx].async) {
+		gi2c->ccu.result.gpii_no = result->gpii_id;
+		gi2c->ccu.result.adap_nr = gi2c->adap.nr;
+		gi2c->ccu.result.frame_cookie =
+			gi2c->ccu.gpi[gpii_idx].frame[frame_idx].frame_cookie;
+		if (!gi2c->err)
+			gi2c->ccu.result.err_no = gi2c->err;
+
+		ccu_qup_update_xfer_completion(&gi2c->ccu.result);
+		/* Free the dma buffer associated to this frame */
+		geni_i2c_release_buf(gi2c, gpii_idx);
+	}
+
 	complete(&gi2c->done);
 }
 
