 				  "GPII:%d Sync:%d Prio:%d Delay after:%d\n"
@@ -1204,7 +1313,7 @@ static int geni_i2c_extract_frame_cfg(struct geni_i2c_dev *gi2c, struct i2c_msg
 				  "arb_lost_retry:%d pkt_len:%d\n"
 				  "cookie:0x%x\n", __func__, msg_idx,
 				  gi2c->ccu.msg[msg_idx]->gpii_no,
-				  gi2c->ccu.msg[msg_idx]->sync,
+				  gi2c->ccu.gpi[gpii_idx].frame[frame_idx].async,
 				  gi2c->ccu.msg[msg_idx]->priority,
 				  gi2c->ccu.msg[msg_idx]->post_delay,
 				  gi2c->ccu.msg[msg_idx]->pre_delay,
@@ -1212,7 +1321,7 @@ static int geni_i2c_extract_frame_cfg(struct geni_i2c_dev *gi2c, struct i2c_msg
 				  gi2c->ccu.msg[msg_idx]->ccu_last,
 				  gi2c->ccu.msg[msg_idx]->arb_lost_retry,
 				  gi2c->ccu.msg[msg_idx]->pkt_len,
-				  gi2c->ccu.msg[msg_idx]->frame_cookie);
