+/*
+ * struct ccu_msg_info - represent single message
+ * @len: length of current message
+ * @addr: dma addr of tx/rx xfer
+ * @tx_buf: hold tx message
+ * @rx_buf: hold incoming rx message
+ * @flag: indicate current message is read or write
+*/
+struct ccu_msg_info {
+	int len;
+	dma_addr_t addr;
+	void *tx_buf;
+	void *rx_buf;
+	bool flag;
+};
+
+ /*
+ * struct ccu_frame_info - represent single transfer
+ * @msgs: indicates the number of message within single i2c xfer
+ * frame_cookie: indicate unique frame cookie for transfer.
+ * @msg: array of messages
+ * @async: represents the asynchornous transfer.
+ */
+struct ccu_frame_info {
+	int msgs;
+	int frame_cookie;
+	struct ccu_msg_info msg[MAX_NUM_MSGS];
+	bool async;
+};
 /* struct ccu_gpii_info - represents the GPII information
  * @type: indicate current gpii is regular or sync ch0 or sync ch1
  * @gpii_mode_change: flag to indicate the mode change
+ * @frame: points to the ccu_frame_info structure
+ * @recvd_cnt: indicate the count of received frame
+ * @released_cnt: indicate the count of xfer completed frames
  */
 struct ccu_gpii_info {
-	int type; /* Regular or Sync channel */
+	int type;
 	bool gpii_mode_change;
+	struct ccu_frame_info frame[MAX_NUM_FRAMES];
+	int recvd_cnt;
+	int released_cnt;
 };
 
 /*
  * struct ccu_msg_config - used to store the configuration of single frame.
  * @gpii_no: represents the GPII no on which transfer need to send
- * @sync: represents the synchronous or asynchornous transfer
  * @priority: represents high priority data transfer
  * @nop_frame: when SW wants to NOP the FRAME(s)
  * @pre_delay: insert predefined delay before I2C transaction
@@ -146,11 +182,9 @@ struct ccu_gpii_info {
  * @arb_lost_retry: re-transmit count for arb lost in address phase
  * @ch_last: indicates last packet (TX & RX) of a current FRAME
  * @ccu_last: indicates end of transfer for single SYNC request
- * @frame_cookie: indicate unique frame cookie for transfer.
  */
 struct ccu_msg_config {
 	int gpii_no;
-	bool sync;
 	bool priority;
 	bool nop_frame;
