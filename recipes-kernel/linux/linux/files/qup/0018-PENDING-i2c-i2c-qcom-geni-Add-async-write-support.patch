@@ -1187,7 +1291,6 @@ static int geni_i2c_extract_frame_cfg(struct geni_i2c_dev *gi2c, struct i2c_msg
 	data = *msg_buf;
 
 	gi2c->ccu.msg[msg_idx]->gpii_no = CCU_GET_GPII(data);
