 	if (!peripheral)
@@ -1264,6 +1374,7 @@ static int geni_i2c_gpi_xfer(struct geni_i2c_dev *gi2c, struct i2c_msg msgs[], i
 			if (ret)
 				return ret;
 			idx = (gi2c->ccu.msg[i]->gpii_no % CCU_MAX_GPII);
+			frame = &gi2c->ccu.gpi[idx].frame[gi2c->ccu.gpi[idx].recvd_cnt];
 		}
 		i2c_trace_log(gi2c->se.dev, "msg[%d].len:%d GPII:%d\n", i, gi2c->cur->len, idx);
 
@@ -1273,8 +1384,13 @@ static int geni_i2c_gpi_xfer(struct geni_i2c_dev *gi2c, struct i2c_msg msgs[], i
 
 		peripheral->addr = msgs[i].addr;
 
-		ret =  geni_i2c_gpi(gi2c, &msgs[i], &config,
-				    &tx_addr, &tx_buf, I2C_WRITE, gi2c->tx_c[idx], i);
+		if (gi2c->is_ccu_qup)
+			ret = geni_i2c_gpi(gi2c, &msgs[i], &config,
+					   &frame->msg[i].addr, &frame->msg[i].tx_buf,
+					   I2C_WRITE, gi2c->tx_c[idx], i);
+		else
+			ret = geni_i2c_gpi(gi2c, &msgs[i], &config,
+					   &tx_addr, &tx_buf, I2C_WRITE, gi2c->tx_c[idx], i);
 		if (ret)
 			goto err;
 
@@ -1284,6 +1400,9 @@ static int geni_i2c_gpi_xfer(struct geni_i2c_dev *gi2c, struct i2c_msg msgs[], i
 			if (ret)
 				goto err;
 
+			/* Reduce the length so actual data provided to client*/
+			if (gi2c->is_ccu_qup)
+				msgs[i].len -= CCU_DATA_OFFSET;
 			dma_async_issue_pending(gi2c->rx_c[idx]);
 		}
 
@@ -1304,6 +1423,10 @@ static int geni_i2c_gpi_xfer(struct geni_i2c_dev *gi2c, struct i2c_msg msgs[], i
 		}
 
 		dma_async_issue_pending(gi2c->tx_c[idx]);
+		/* Async transfer mode support only write transfer */
+		if (gi2c->is_ccu_qup && (frame->async &&
+					 !(msgs[i].flags & I2C_M_RD)))
+			goto next_msg;
 
 		time_left = wait_for_completion_timeout(&gi2c->done, XFER_TIMEOUT);
 		if (!time_left)
@@ -1316,10 +1439,35 @@ static int geni_i2c_gpi_xfer(struct geni_i2c_dev *gi2c, struct i2c_msg msgs[], i
 
 		geni_i2c_gpi_unmap(gi2c, &msgs[i], tx_buf, tx_addr, rx_buf, rx_addr);
 		if (gi2c->is_ccu_qup) {
+			if (gi2c->ccu.gpi[idx].released_cnt >= MAX_NUM_FRAMES)
+				gi2c->ccu.gpi[idx].released_cnt = 0;
+			else
+				gi2c->ccu.gpi[idx].released_cnt++;
+		}
+next_msg:
+		if (gi2c->is_ccu_qup) {
+			frame->msg[i].tx_buf = tx_buf;
+			frame->msg[i].rx_buf = rx_buf;
+			frame->msg[i].len = msgs[i].len;
+			if (msgs[i].flags & I2C_M_RD) {
+				frame->msg[i].flag = true;
+				frame->msg[i].addr = rx_addr;
+			} else {
+				frame->msg[i].flag = false;
+				frame->msg[i].addr = tx_addr;
+			}
