+/*
+ * geni_i2c_power_on_off - This function is used to turn on or off all the clock
+ *                         and it will free the GPII resources in suspend path and
+ *                         allocate the resources in resume path.
+ * @adap: i2c adapter handle
+ * @suspend: true in case of suspend or false
+ *
+ * Return 0 on success or error on failure
+ */
+int geni_i2c_power_on_off(struct i2c_adapter *adap, bool suspend)
+{
+	struct geni_i2c_dev *gi2c;
+	int ret, i;
+
+	if (!adap) {
+		pr_err("%s: Adap is NULL\n", __func__);
+		return -EINVAL;
+	} else {
+		gi2c = adap->dev.driver_data;
+		if (!gi2c) {
+			pr_err("%s: I2C is NULL\n", __func__);
+			return -EINVAL;
+		}
+	}
+	if (suspend) {
+		for (i = 0; i < CCU_MAX_GPII; i++) {
+			if (gi2c->tx_c[i])
+				dmaengine_free_chan_resources(gi2c->tx_c[i]);
+
+			if (gi2c->rx_c[i])
+				dmaengine_free_chan_resources(gi2c->rx_c[i]);
+		}
+
+		/* Decrement the device usage counter and call pm runtime idle */
+		ret = pm_runtime_put_sync(gi2c->se.dev);
+		if (ret < 0) {
+			dev_err(gi2c->se.dev, "error turning off device :%d\n", ret);
+			return ret;
+		}
+	} else {
+		/* Increment the device usage counter and resume */
+		ret = pm_runtime_resume_and_get(gi2c->se.dev);
+		if (ret < 0) {
+			dev_err(gi2c->se.dev, "error turning on device :%d\n", ret);
+			return ret;
+		}
+		for (i = 0; i < CCU_MAX_GPII; i++) {
+			if (gi2c->tx_c[i])
+				dmaengine_alloc_chan_resources(gi2c->tx_c[i]);
+
+			if (gi2c->rx_c[i])
+				dmaengine_alloc_chan_resources(gi2c->rx_c[i]);
+		}
+	}
+
+	return 0;
+}
+EXPORT_SYMBOL(geni_i2c_power_on_off);
