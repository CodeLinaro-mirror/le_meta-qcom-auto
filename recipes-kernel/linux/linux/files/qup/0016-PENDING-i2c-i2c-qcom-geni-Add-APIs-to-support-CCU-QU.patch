+/*
+ *geni_i2c_send_cmd_fifo_mode - This function is used to send any command
+ *				in FIFO mode.
+ * @gi2c: Handle of the I2C device
+ * @cmd: Bus command
+ * Return: zero on success and error on failure.
+ */
+static int geni_i2c_send_cmd_fifo_mode(struct geni_i2c_dev *gi2c, int cmd)
+{
+	u32 m_param = 0;
+	u32 time_left = 0;
+
+	geni_se_select_mode(&gi2c->se, GENI_SE_FIFO);
+	reinit_completion(&gi2c->done);
+	geni_se_setup_m_cmd(&gi2c->se, cmd, m_param);
+	time_left = wait_for_completion_timeout(&gi2c->done, XFER_TIMEOUT);
+	if (!time_left) {
+		dev_err(gi2c->se.dev, "I2C timeout for cmd:%d\n", cmd);
+		return -ETIMEDOUT;
+	}
+
+	dev_dbg(gi2c->se.dev, "CMD:%d send successfully\n", cmd);
+	return 0;
+}
