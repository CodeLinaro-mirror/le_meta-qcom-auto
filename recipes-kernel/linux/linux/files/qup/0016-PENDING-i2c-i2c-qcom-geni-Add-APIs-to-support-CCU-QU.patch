+/*
+ * geni_i2c_is_bus_recovery_required - Checks if Bus recovery required or not.
+ *
+ * @gi2c: Handle of the I2C device
+ *
+ * Return: TRUE if SDA is stuck LOW due to some issue else false.
+ */
+bool geni_i2c_is_bus_recovery_required(struct geni_i2c_dev *gi2c)
+{
+	u32 geni_ios = readl_relaxed(gi2c->se.base + SE_GENI_IOS);
+
+	/* SE_GENI_IOS will show I2C CLK/SDA line status, BIT 0 is SDA,
+	 * BIT 1 is CLK. SE_GENI_IOS register set when CLK/SDA line
+	 * is pulled high.
+	 */
+	return (((geni_ios & 1) == 0) && (gi2c->err == -EPROTO ||
+				 gi2c->err == -ETIMEDOUT));
+}
+
+/*
+ * geni_i2c_check_recover_ios_line - Check and recover IOS lines state.
+ *
+ * @adap: Master controller handle.
+ *
+ * Return: Success OR Respective error code/value.
+ */
+int geni_i2c_check_recover_ios_line(struct i2c_adapter *adap)
+{
+	struct geni_i2c_dev *gi2c;
+	int ret = 0;
+
+	if (!adap) {
+		pr_err("%s: Adap is NULL\n", __func__);
+		return -EINVAL;
+	} else {
+		gi2c = adap->dev.driver_data;
+		if (!gi2c) {
+			pr_err("%s: I2C driver data is NULL\n", __func__);
+			return -EINVAL;
+		}
+	}
+
+	if (geni_i2c_is_bus_recovery_required(gi2c)) {
+		dev_err(gi2c->se.dev, "IOS lines in bad state, need recovery\n");
+	} else {
+		dev_dbg(gi2c->se.dev, "IOS lines in good state\n");
+		return 0;
+	}
+	if (gi2c->gpi_mode) {
+		ret = geni_i2c_send_cmd_gsi_mode(gi2c, I2C_BUS_CLEAR);
+		if (ret) {
+			dev_err(gi2c->se.dev, "BUS CLEAR cmd failed for GPI mode\n");
+			return ret;
+		}
+
+		ret = geni_i2c_send_cmd_gsi_mode(gi2c, I2C_STOP_ON_BUS);
+		if (ret) {
+			dev_err(gi2c->se.dev, "STOP_ON_BUS cmd failed for GPI mode\n");
+			return ret;
+		}
+	} else {
+		ret = geni_i2c_send_cmd_fifo_mode(gi2c, I2C_BUS_CLEAR);
+		if (ret) {
+			dev_err(gi2c->se.dev, "BUS Clear cmd failed for FIFO mode\n");
+			return ret;
+		}
+
+		ret = geni_i2c_send_cmd_fifo_mode(gi2c, I2C_STOP_ON_BUS);
+		if (ret) {
+			dev_err(gi2c->se.dev, "STOP_ON_BUS cmd failed for FIFO mode\n");
+			return ret;
+		}
+	}
+
+	return ret;
+}
+EXPORT_SYMBOL(geni_i2c_check_recover_ios_line);
