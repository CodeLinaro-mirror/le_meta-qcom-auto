+/*
+ * geni_i2c_configure_ccu_mode : Configure the CCU mode and GPII channel type
+ *
+ * @adap: Master controller handle.
+ * @gpii_no: GPII number.
+ * @ch_type: Channel type for given GPII. (0 – Regular, 1 – sync ch 0, 2 – sync ch 1)
+ * @mode: Represents SE mode (0 – sync trigger mode and 1 – CDM mode)
+ *
+ * Return 0 on success and error on failure.
+ */
+int geni_i2c_configure_ccu_mode(struct i2c_adapter *adap, int gpii_no, int ch_type, bool mode)
+{
+	struct geni_i2c_dev *gi2c;
+	int idx = (gpii_no % CCU_MAX_GPII);
+
+	if (!adap) {
+		pr_err("%s: Adap is NULL\n", __func__);
+		return -EINVAL;
+	} else {
+		gi2c = adap->dev.driver_data;
+		if (!gi2c) {
+			pr_err("%s: I2C driver data is NULL\n", __func__);
+			return -EINVAL;
+		}
+	}
+
+	gi2c->ccu.mode = mode;
+	gi2c->ccu.gpi[idx].type = ch_type;
+	gi2c->ccu.gpi[idx].gpii_mode_change = true;
+
+	ccu_gpi_configure_mode(gi2c->tx_c[idx], mode, ch_type);
+	ccu_gpi_configure_mode(gi2c->rx_c[idx], mode, ch_type);
+
+	release_gpi_dma(gi2c);
+	setup_gpi_dma(gi2c);
+	gi2c->ccu.gpi[idx].gpii_mode_change = false;
+
+	return 0;
+}
+EXPORT_SYMBOL(geni_i2c_configure_ccu_mode);
+
+/*
+ * geni_i2c_gpii_reset : Reset the GPII channel.
+ *
+ * @adap: Master controller handle.
+ * @gpii_no: GPII number.
+ * @premature_cancel: client use this flag if want to drop the queued frames
+ *
+ * Return 0 on success and error on failure.
+ */
+int geni_i2c_gpii_reset(struct i2c_adapter *adap, int gpii_no,
+			bool premature_cancel)
+{
+	struct geni_i2c_dev *gi2c;
+	int idx = (gpii_no % CCU_MAX_GPII);
+	int ret = 0;
+
+	if (!adap) {
+		pr_err("%s: Adap is NULL\n", __func__);
+		return -EINVAL;
+	} else {
+		gi2c = adap->dev.driver_data;
+		if (!gi2c) {
+			pr_err("%s: I2C driver data is NULL\n", __func__);
+			return -EINVAL;
+		}
+	}
+
+	if (premature_cancel)
+		ccu_gpi_set_premature_cancel_flag(gi2c->tx_c[idx]);
+
+	if (gi2c->tx_c[idx]) {
+		ret = dmaengine_terminate_all(gi2c->tx_c[idx]);
+		if (ret) {
+			dev_err(gi2c->se.dev, "%s: gpi terminate failed for tx_c[%d]ret:%d\n",
+				__func__, ret, idx);
+			return ret;
+		}
+	}
+
+	if (gi2c->rx_c[idx]) {
+		ret = dmaengine_terminate_all(gi2c->rx_c[idx]);
+		if (ret) {
+			dev_err(gi2c->se.dev, "%s: gpi terminate failed for rx_c[%d]ret:%d\n",
+				__func__, ret, idx);
+			return ret;
+		}
+	}
+
+	return 0;
+}
+EXPORT_SYMBOL(geni_i2c_gpii_reset);
+
