+static umode_t qcom_pcie_attr_is_visible(struct kobject *kobj,
+					 struct attribute *attr, int n)
+{
+	struct device *dev = kobj_to_dev(kobj);
+	struct qcom_pcie *pcie = dev_get_drvdata(dev);
+
+	/* error_report attribute only visible when safety is supported */
+	if (attr == &dev_attr_qcom_pcie_error_report.attr) {
+		if (!pcie || !pcie->safety_supported)
