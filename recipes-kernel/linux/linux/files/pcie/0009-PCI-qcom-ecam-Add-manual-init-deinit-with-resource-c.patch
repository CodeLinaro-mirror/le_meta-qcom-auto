From 14e3ff9a238770fb0ab31a38f94c98ec7c3b6db1 Mon Sep 17 00:00:00 2001
From: Rama Krishna Phani A <ramkri@qti.qualcomm.com>
Date: Mon, 16 Mar 2026 17:10:19 +0530
Subject: [PATCH] PCI: qcom-ecam: Add manual init/deinit with resource cleanup

Add support for manual PCIe controller initialization and deinitialization
to enable dynamic lifecycle management and fix resource leaks during
init->deinit->init sequences.

Changes:
- Add qcom_pcie_init() and qcom_pcie_deinit() functions
- Implement power domain management (init/cleanup)
- Fix ECAM resource collision by manually calling pci_ecam_free()
- Fix I/O space remapping BUG by calling pci_unmap_iospace()
- Release window resources from kernel resource tree
- Add sysfs triggers for manual init/deinit testing
- Track initialization state and store bridge/cfg pointers

Change-Id: Ia5448fdb98ac9785032799fd70461f1684c34d92
Signed-off-by: Rama Krishna Phani A <ramkri@qti.qualcomm.com>
---
 drivers/pci/controller/pcie-qcom-ecam.c | 518 ++++++++++++++++++++++--
 1 file changed, 488 insertions(+), 30 deletions(-)

diff --git a/drivers/pci/controller/pcie-qcom-ecam.c b/drivers/pci/controller/pcie-qcom-ecam.c
index d60d3bcb5081..cefa267b8fe5 100644
--- a/drivers/pci/controller/pcie-qcom-ecam.c
+++ b/drivers/pci/controller/pcie-qcom-ecam.c
@@ -266,6 +266,12 @@ struct qcom_msi_client {
  * pcie_fault_total	Total count of all errors occured on a RP
  * @msi: pointer to the qcom_msi structure
  * @debugfs: dentry to create DebugFS
+ * @power_devs: Array of power domain devices
+ * @power_domain_names: Array of power domain names
+ * @num_power_domains: Number of power domains
+ * @active_power_domain_idx: Index of the actively controlled power domain
+ * @power_enabled: Current power state of active domain
+ * @bridge: PCI host bridge instance
  */
 struct qcom_pcie {
 	struct device *dev;
@@ -279,6 +285,14 @@ struct qcom_pcie {
 	struct qcom_msi *msi;
 	struct dentry *debugfs;
 	u32 rasdp_off;
+	struct device **power_devs;
+	const char **power_domain_names;
+	int num_power_domains;
+	int active_power_domain_idx;
+	bool power_enabled;
+	bool pci_host_initialized;
+	struct pci_host_bridge *bridge;
+	struct pci_config_window *cfg;
 };
 
 static void qcom_msi_handler(struct irq_desc *desc)
@@ -801,6 +815,18 @@ static irqreturn_t qcom_pcie_global_irq_thread(int irq, void *data)
 	unsigned long irqsave_flags;
 	u32 val, int_status, counter = 0;
 
+	/*
+	 * Check if PCIe controller is initialized (D0 state).
+	 * The interrupt can be triggered even before proper initialization
+	 * (before qcom_pcie_init() is called via sysfs or during early boot).
+	 * Without this check, accessing PCIe registers can cause crashes or
+	 * undefined behavior if the controller is not in D0 state.
+	 */
+	if (!pcie->pci_host_initialized) {
+		dev_warn_ratelimited(dev, "Global IRQ received before PCIe initialization (not in D0), ignoring\n");
+		return IRQ_HANDLED;
+	}
+
 	spin_lock_irqsave(&pcie->safety_lock, irqsave_flags);
 
 	counter++;
@@ -898,8 +924,461 @@ static ssize_t qcom_pcie_error_report_show(struct device *dev,
 }
 static DEVICE_ATTR_RO(qcom_pcie_error_report);
 
+/**
+ * qcom_pcie_is_dummy_domain - Check if a power domain is dummy
+ * @pcie: PCIe controller instance
+ * @domain_idx: Index of the power domain
+ *
+ * Returns: true if domain is dummy, false if actively controlled
+ */
+static bool qcom_pcie_is_dummy_domain(struct qcom_pcie *pcie, int domain_idx)
+{
+	/* Only the first domain (index 0) is actively controlled */
+	return (domain_idx != 0);
+}
+
+/**
+ * qcom_pcie_init_power_domains - Initialize power domain support
+ * @pcie: PCIe controller instance
+ *
+ * Returns: 0 on success, negative error code on failure
+ */
+static int qcom_pcie_init_power_domains(struct qcom_pcie *pcie)
+{
+	struct device *dev = pcie->dev;
+	struct device_node *np = dev->of_node;
+	int ret, i;
+
+	/* Check if power domains are already initialized */
+	if (pcie->power_enabled) {
+		dev_warn(dev, "Power domains already initialized, skipping re-initialization\n");
+		return 0;
+	}
+
+	/* Get number of power domains */
+	pcie->num_power_domains = of_count_phandle_with_args(np, "power-domains",
+							     "#power-domain-cells");
+	if (pcie->num_power_domains <= 0) {
+		dev_info(dev, "No power domains specified in device tree\n");
+		return 0;
+	}
+
+	dev_info(dev, "Initializing %d power domains (only first will be actively controlled)\n",
+		 pcie->num_power_domains);
+
+	/* Set active power domain index (always 0 - first domain) */
+	pcie->active_power_domain_idx = 0;
+
+	/* Allocate arrays for power domain devices and names */
+	pcie->power_devs = devm_kcalloc(dev, pcie->num_power_domains,
+					sizeof(*pcie->power_devs), GFP_KERNEL);
+	if (!pcie->power_devs)
+		return -ENOMEM;
+
+	/* Get power domain names if available */
+	if (of_find_property(np, "power-domain-names", NULL)) {
+		pcie->power_domain_names = devm_kcalloc(dev, pcie->num_power_domains,
+							sizeof(*pcie->power_domain_names),
+							GFP_KERNEL);
+		if (pcie->power_domain_names) {
+			for (i = 0; i < pcie->num_power_domains; i++)
+				of_property_read_string_index(np, "power-domain-names",
+							      i, &pcie->power_domain_names[i]);
+		}
+	}
+
+	/* Attach to each power domain */
+	for (i = 0; i < pcie->num_power_domains; i++) {
+		const char *domain_name = pcie->power_domain_names ?
+					  pcie->power_domain_names[i] : "unknown";
+		bool is_dummy = qcom_pcie_is_dummy_domain(pcie, i);
+
+		pcie->power_devs[i] = dev_pm_domain_attach_by_id(dev, i);
+		if (IS_ERR(pcie->power_devs[i])) {
+			ret = PTR_ERR(pcie->power_devs[i]);
+			dev_err(dev, "Failed to attach power domain %d (%s): %d\n",
+				i, domain_name, ret);
+			pcie->power_devs[i] = NULL;  /* Mark as NULL for cleanup */
+			goto detach_domains;
+		}
+
+		/* Enable runtime PM for all domains (even dummy ones) */
+		/* Check if runtime PM is already enabled to avoid "Unbalanced pm_runtime_enable" warning */
+		if (!pm_runtime_enabled(pcie->power_devs[i]))
+			pm_runtime_enable(pcie->power_devs[i]);
+
+		dev_info(dev, "Attached power domain %d (%s) - %s\n", i, domain_name,
+			 is_dummy ? "DUMMY" : "ACTIVE");
+
+		ret = pm_runtime_resume_and_get(pcie->power_devs[i]);
+		if (ret < 0) {
+			dev_err(dev, "Failed to enable PCIe Controller: %d\n", ret);
+			/* Disable runtime PM for the current domain before cleanup */
+			pm_runtime_disable(pcie->power_devs[i]);
+			/* Detach the current domain that failed */
+			dev_pm_domain_detach(pcie->power_devs[i], true);
+			pcie->power_devs[i] = NULL;  /* Mark as NULL */
+			/* Now cleanup previously successful domains */
+			i--;
+			goto detach_domains;
+		}
+	}
+
+	/* Initialize power state - assume enabled if active domain is attached */
+	pcie->power_enabled = true;
+
+	return 0;
+
+detach_domains:
+	/* Cleanup all successfully initialized domains (i is already decremented) */
+	while (i >= 0) {
+		if (pcie->power_devs[i]) {
+			pm_runtime_put_sync(pcie->power_devs[i]);
+			pm_runtime_disable(pcie->power_devs[i]);
+			dev_pm_domain_detach(pcie->power_devs[i], true);
+			pcie->power_devs[i] = NULL;
+		}
+		i--;
+	}
+
+	return ret;
+}
+
+/**
+ * qcom_pcie_cleanup_power_domains - Cleanup power domain support
+ * @pcie: PCIe controller instance
+ *
+ * Returns: 0 on success, negative error code on failure
+ *
+ * Note: This function uses power_enabled flag to prevent double cleanup.
+ * It can be safely called multiple times (e.g., from both deinit and remove).
+ */
+static int qcom_pcie_cleanup_power_domains(struct qcom_pcie *pcie)
+{
+	struct device *dev = pcie->dev;
+	int i, ret = 0;
+
+	/* Check if power domains were actually initialized */
+	if (pcie->num_power_domains <= 0 || !pcie->power_devs) {
+		dev_info(dev, "Power domains not initialized, skipping cleanup\n");
+		return 0;
+	}
+
+	/*
+	 * Check if power is already disabled to prevent double cleanup.
+	 * This is critical because this function is called from both:
+	 * 1. qcom_pcie_deinit() - manual deinit via sysfs
+	 * 2. qcom_pcie_ecam_remove() - driver removal
+	 *
+	 * Without this check, if user does manual deinit followed by driver
+	 * removal (rmmod), we would call pm_runtime_put_sync() twice on the
+	 * same domains, causing "Unbalanced pm_runtime" errors.
+	 */
+	if (!pcie->power_enabled) {
+		dev_info(dev, "Power domains already disabled, skipping cleanup\n");
+		return 0;
+	}
+
+	dev_info(dev, "Cleaning up %d power domains\n", pcie->num_power_domains);
+
+	for (i = 0; i < pcie->num_power_domains; i++) {
+		if (pcie->power_devs[i]) {
+			const char *domain_name = pcie->power_domain_names ?
+						  pcie->power_domain_names[i] : "unknown";
+			bool is_dummy = qcom_pcie_is_dummy_domain(pcie, i);
+
+			dev_info(dev, "Detaching power domain %d (%s) - %s\n",
+				 i, domain_name, is_dummy ? "DUMMY" : "ACTIVE");
+
+			ret = pm_runtime_put_sync(pcie->power_devs[i]);
+			if (ret < 0)
+				dev_err(dev, "Failed to suspend power domain %d: %d\n", i, ret);
+
+			pm_runtime_disable(pcie->power_devs[i]);
+			dev_pm_domain_detach(pcie->power_devs[i], true);
+		}
+	}
+
+	/* Mark power as disabled to prevent double cleanup */
+	pcie->power_enabled = false;
+
+	return ret;
+}
+
+/* Helper function for devm cleanup of ECAM config window */
+static void qcom_pcie_ecam_free_action(void *data)
+{
+	struct pci_config_window *cfg = data;
+	if (cfg)
+		pci_ecam_free(cfg);
+}
+
+/**
+ * qcom_pcie_init - Initialize pcie support
+ * @pcie: PCIe controller instance
+ * @pdev: Platform device pointer
+ *
+ * Returns: 0 on success, negative error code on failure
+ */
+static int qcom_pcie_init(struct qcom_pcie *pcie, struct platform_device *pdev)
+{
+	struct device *dev = pcie->dev;
+	struct qcom_msi *msi = NULL;
+	int ret;
+
+	dev_info(dev, "Initializing PCIe controller\n");
+
+	/* Initialize power domain support */
+	ret = qcom_pcie_init_power_domains(pcie);
+	if (ret) {
+		dev_warn(dev, "Power domain initialization failed: %d\n", ret);
+		/* Don't fail probe, power domains are optional */
+	}
+
+	/* Enable PCIe safety error reporting */
+	qcom_pcie_enable_error_reporting(pcie);
+
+	/* Initialize MSI controller if not using msi-map */
+	if (!of_find_property(dev->of_node, "msi-map", NULL)) {
+		dev_info(dev, "Initializing MSI controller\n");
+		msi = qcom_msi_init(pcie);
+		if (IS_ERR(msi)) {
+			dev_err(dev, "MSI initialization failed: %ld\n", PTR_ERR(msi));
+			ret = PTR_ERR(msi);
+			goto cleanup_power_domains;
+		}
+	}
+
+	/* Probe PCI host */
+	ret = pci_host_common_probe(pdev);
+	if (ret) {
+		dev_err(dev, "pci_host_common_probe() failed: %d\n", ret);
+		if (msi)
+			qcom_msi_deinit(msi);
+		pcie->pci_host_initialized = false;
+		pcie->bridge = NULL;
+		pcie->cfg = NULL;
+		goto cleanup_power_domains;
+	}
+
+	pcie->pci_host_initialized = true;
+	/* Store the bridge created by pci_host_common_probe */
+	pcie->bridge = platform_get_drvdata(pdev);
+	/* Store the config window from bridge->sysdata */
+	pcie->cfg = pcie->bridge->sysdata;
+	pcie->msi = msi;
+	dev_info(dev, "PCIe controller initialized successfully\n");
+
+	return 0;
+
+cleanup_power_domains:
+	/* Cleanup power domains if initialization failed after they were set up */
+	qcom_pcie_cleanup_power_domains(pcie);
+	return ret;
+}
+
+/**
+ * qcom_pcie_deinit - Deinitialize pcie support
+ * @pcie: PCIe controller instance
+ *
+ * Returns: 0 on success, negative error code on failure
+ */
+static int qcom_pcie_deinit(struct qcom_pcie *pcie)
+{
+	struct device *dev = pcie->dev;
+	struct platform_device *pdev = to_platform_device(dev);
+	struct pci_host_bridge *bridge;
+	struct resource_entry *win;
+	int ret = 0;
+
+	dev_info(dev, "Deinitializing PCIe controller\n");
+
+	/* Remove PCI host common only if it was successfully initialized */
+	if (pcie->pci_host_initialized) {
+		/* Use the stored bridge from pcie structure */
+		bridge = pcie->bridge;
+
+		if (bridge && bridge->bus) {
+			/*
+			 * Ensure platform data is set to the correct bridge before cleanup.
+			 * This is critical because pci_host_common_remove expects to find
+			 * the bridge via platform_get_drvdata().
+			 */
+			platform_set_drvdata(pdev, bridge);
+
+			/*
+			 * Use the standard PCI subsystem cleanup function.
+			 * This is the proper way to clean up PCI resources and ensures
+			 * all cleanup is done in the correct order with proper locking.
+			 */
+			ret = pci_host_common_remove(pdev);
+			if (ret) {
+				dev_err(dev, "pci_host_common_remove() failed: %d\n", ret);
+				/* Continue with cleanup even if this fails */
+			}
+
+			/*
+			 * Unmap and release I/O and memory window resources.
+			 * pci_host_common_remove() removes the bus and devices but does NOT:
+			 * 1. Unmap the I/O virtual memory mappings created by pci_remap_iospace()
+			 * 2. Release the I/O port and memory window resources from the kernel's
+			 *    global resource tree.
+			 *
+			 * This causes:
+			 * - vmap_range_noflush BUG when trying to remap already mapped I/O space
+			 * - Resource collision errors for memory windows
+			 *
+			 * We must explicitly unmap I/O space and release all resources to allow
+			 * re-initialization.
+			 */
+			resource_list_for_each_entry(win, &bridge->windows) {
+				if (win->res && win->res->parent) {
+					/* Unmap I/O resources before releasing */
+					if (resource_type(win->res) == IORESOURCE_IO)
+						pci_unmap_iospace(win->res);
+
+					/* Release from resource tree */
+					release_resource(win->res);
+					win->res->parent = NULL;
+				}
+			}
+
+			/*
+			 * Free ECAM config window.
+			 * The ECAM region is claimed during pci_host_common_probe() via
+			 * pci_ecam_create() -> request_resource_conflict() but is NOT released
+			 * during pci_host_common_remove() because it's managed by devm_.
+			 * The devm_ cleanup only runs on device removal, not on manual deinit.
+			 *
+			 * We must manually call pci_ecam_free() to release the ECAM resource.
+			 * Note: The devm action registered by pci_host_common_probe() will
+			 * try to free it again on device removal, but pci_ecam_free() handles
+			 * this safely by checking if resources are already released.
+			 */
+			if (pcie->cfg) {
+				pci_ecam_free(pcie->cfg);
+				pcie->cfg = NULL;
+			}
+		} else {
+			if (!bridge)
+				dev_warn(dev, "PCI bridge not found, cleanup not needed\n");
+			else
+				dev_warn(dev, "PCI bus not initialized, cleanup not needed\n");
+		}
+
+		/* Clear our internal state regardless of cleanup result */
+		pcie->pci_host_initialized = false;
+		pcie->bridge = NULL;
+
+		/* Clear platform data after cleanup */
+		platform_set_drvdata(pdev, pcie);
+
+	} else {
+		dev_info(dev, "PCI host not initialized, skipping cleanup\n");
+	}
+
+	/* Cleanup MSI if initialized */
+	if (pcie->msi) {
+		qcom_msi_deinit(pcie->msi);
+		pcie->msi = NULL;
+	}
+
+	/* Cleanup power domains */
+	ret = qcom_pcie_cleanup_power_domains(pcie);
+	if (ret) {
+		dev_warn(dev, "Power domain cleanup had issues: %d\n", ret);
+		/* Continue, don't fail the overall deinit */
+	}
+
+	dev_info(dev, "PCIe controller deinitialized successfully\n");
+
+	return 0;
+}
+
+static ssize_t qcom_pcie_init_trigger_show(struct device *dev,
+		struct device_attribute *attr,
+		char *buf)
+{
+	return sysfs_emit(buf, "Write '1' to trigger qcom_pcie_init\n");
+}
+
+static ssize_t qcom_pcie_init_trigger_store(struct device *dev,
+		struct device_attribute *attr,
+		const char *buf, size_t count)
+{
+	struct qcom_pcie *pcie = (struct qcom_pcie *)dev_get_drvdata(dev);
+	struct platform_device *pdev = to_platform_device(dev);
+	unsigned long val;
+	int ret;
+
+	ret = kstrtoul(buf, 10, &val);
+	if (ret)
+		return ret;
+
+	if (val != 1) {
+		dev_err(dev, "Invalid value. Write '1' to trigger qcom_pcie_init\n");
+		return -EINVAL;
+	}
+
+	dev_info(dev, "Triggering qcom_pcie_init via sysfs\n");
+
+	/* Call qcom_pcie_init function */
+	ret = qcom_pcie_init(pcie, pdev);
+	if (ret) {
+		dev_err(dev, "qcom_pcie_init failed: %d\n", ret);
+		return ret;
+	}
+
+	/* Update platform driver data to ensure same pcie structure is used */
+	platform_set_drvdata(pdev, pcie);
+
+	dev_info(dev, "qcom_pcie_init completed successfully\n");
+	return count;
+}
+static DEVICE_ATTR_RW(qcom_pcie_init_trigger);
+
+static ssize_t qcom_pcie_deinit_trigger_show(struct device *dev,
+		struct device_attribute *attr,
+		char *buf)
+{
+	return sysfs_emit(buf, "Write '1' to trigger qcom_pcie_deinit\n");
+}
+
+static ssize_t qcom_pcie_deinit_trigger_store(struct device *dev,
+		struct device_attribute *attr,
+		const char *buf, size_t count)
+{
+	struct qcom_pcie *pcie = (struct qcom_pcie *)dev_get_drvdata(dev);
+	unsigned long val;
+	int ret;
+
+	ret = kstrtoul(buf, 10, &val);
+	if (ret)
+		return ret;
+
+	if (val != 1) {
+		dev_err(dev, "Invalid value. Write '1' to trigger qcom_pcie_deinit\n");
+		return -EINVAL;
+	}
+
+	dev_info(dev, "Triggering qcom_pcie_deinit via sysfs\n");
+
+	/* Call qcom_pcie_deinit function */
+	ret = qcom_pcie_deinit(pcie);
+	if (ret) {
+		dev_err(dev, "qcom_pcie_deinit failed: %d\n", ret);
+		return ret;
+	}
+
+	dev_info(dev, "qcom_pcie_deinit completed successfully\n");
+	return count;
+}
+static DEVICE_ATTR_RW(qcom_pcie_deinit_trigger);
+
 static struct attribute *qcom_pcie_attrs[] = {
 	&dev_attr_qcom_pcie_error_report.attr,
+	&dev_attr_qcom_pcie_init_trigger.attr,
