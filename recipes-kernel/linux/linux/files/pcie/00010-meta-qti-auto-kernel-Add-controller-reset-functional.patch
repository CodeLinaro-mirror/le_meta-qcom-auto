From 51998078400f806e67af7da35416f4f315cca53c Mon Sep 17 00:00:00 2001
From: Rama Krishna Phani A <ramkri@qti.qualcomm.com>
Date: Tue, 28 Apr 2026 21:43:38 +0530
Subject: [PATCH] meta-qti-auto-kernel: Add controller reset functionality with
 proper serialization

Add controller reset functionality to enable dynamic PCIe
controller lifecycle management through sysfs interface. This patch
introduces a complete reset sequence (deinit → delay → init) with proper
synchronization and error handling.

Key Features:
1. Controller Reset Sysfs Interface.
2. Complete Serialization.
3. Reset State Tracking.

Change-Id: I8116bcd6cdd3942b3a1426eb9aef09c5624b6c50
Signed-off-by: Rama Krishna Phani A <ramkri@qti.qualcomm.com>
---
 drivers/pci/controller/pcie-qcom-ecam.c | 118 ++++++++++++++++++++++++
 1 file changed, 118 insertions(+)

diff --git a/drivers/pci/controller/pcie-qcom-ecam.c b/drivers/pci/controller/pcie-qcom-ecam.c
index cefa267b8fe5..82133812b586 100644
--- a/drivers/pci/controller/pcie-qcom-ecam.c
+++ b/drivers/pci/controller/pcie-qcom-ecam.c
@@ -24,6 +24,8 @@
 #include <linux/device.h>
 #include <linux/types.h>
 #include <linux/debugfs.h>
+#include <linux/delay.h>
+#include <linux/mutex.h>
 
 #include "pci-host-common.h"
 
@@ -291,6 +293,8 @@ struct qcom_pcie {
 	int active_power_domain_idx;
 	bool power_enabled;
 	bool pci_host_initialized;
+	bool reset_in_progress;
+	struct mutex reset_lock;
 	struct pci_host_bridge *bridge;
 	struct pci_config_window *cfg;
 };
@@ -1320,18 +1324,34 @@ static ssize_t qcom_pcie_init_trigger_store(struct device *dev,
 		return -EINVAL;
 	}
 
+	/* Serialize init/deinit/reset operations */
+	if (!mutex_trylock(&pcie->reset_lock)) {
+		dev_warn(dev, "Another init/deinit/reset operation in progress, please wait\n");
+		return -EBUSY;
+	}
+
+	/* Check if reset is in progress */
+	if (pcie->reset_in_progress) {
+		dev_warn(dev, "Controller reset in progress, cannot init now\n");
+		mutex_unlock(&pcie->reset_lock);
+		return -EBUSY;
+	}
+
 	dev_info(dev, "Triggering qcom_pcie_init via sysfs\n");
 
 	/* Call qcom_pcie_init function */
 	ret = qcom_pcie_init(pcie, pdev);
 	if (ret) {
 		dev_err(dev, "qcom_pcie_init failed: %d\n", ret);
+		mutex_unlock(&pcie->reset_lock);
 		return ret;
 	}
 
 	/* Update platform driver data to ensure same pcie structure is used */
 	platform_set_drvdata(pdev, pcie);
 
+	mutex_unlock(&pcie->reset_lock);
+
 	dev_info(dev, "qcom_pcie_init completed successfully\n");
 	return count;
 }
@@ -1361,24 +1381,119 @@ static ssize_t qcom_pcie_deinit_trigger_store(struct device *dev,
 		return -EINVAL;
 	}
 
+	/* Serialize init/deinit/reset operations */
+	if (!mutex_trylock(&pcie->reset_lock)) {
+		dev_warn(dev, "Another init/deinit/reset operation in progress, please wait\n");
+		return -EBUSY;
+	}
+
+	/* Check if reset is in progress */
+	if (pcie->reset_in_progress) {
+		dev_warn(dev, "Controller reset in progress, cannot deinit now\n");
+		mutex_unlock(&pcie->reset_lock);
+		return -EBUSY;
+	}
+
 	dev_info(dev, "Triggering qcom_pcie_deinit via sysfs\n");
 
 	/* Call qcom_pcie_deinit function */
 	ret = qcom_pcie_deinit(pcie);
 	if (ret) {
 		dev_err(dev, "qcom_pcie_deinit failed: %d\n", ret);
+		mutex_unlock(&pcie->reset_lock);
 		return ret;
 	}
 
+	mutex_unlock(&pcie->reset_lock);
+
 	dev_info(dev, "qcom_pcie_deinit completed successfully\n");
 	return count;
 }
 static DEVICE_ATTR_RW(qcom_pcie_deinit_trigger);
 
+static ssize_t qcom_pcie_controller_reset_show(struct device *dev,
+		struct device_attribute *attr,
+		char *buf)
+{
+	return sysfs_emit(buf, "Write '1' to reset PCIe controller (deinit + delay + init)\n");
+}
+
+static ssize_t qcom_pcie_controller_reset_store(struct device *dev,
+		struct device_attribute *attr,
+		const char *buf, size_t count)
+{
+	struct qcom_pcie *pcie = (struct qcom_pcie *)dev_get_drvdata(dev);
+	struct platform_device *pdev = to_platform_device(dev);
+	unsigned long val;
+	int ret;
+
+	ret = kstrtoul(buf, 10, &val);
+	if (ret)
+		return ret;
+
+	if (val != 1) {
+		dev_err(dev, "Invalid value. Write '1' to reset controller\n");
+		return -EINVAL;
+	}
+
+	/* Try to acquire reset lock to prevent concurrent resets */
+	if (!mutex_trylock(&pcie->reset_lock)) {
+		dev_warn(dev, "Controller reset already in progress, please wait\n");
+		return -EBUSY;
+	}
+
+	/* Check if reset is already in progress (double protection) */
+	if (pcie->reset_in_progress) {
+		dev_warn(dev, "Controller reset already in progress\n");
+		mutex_unlock(&pcie->reset_lock);
+		return -EBUSY;
+	}
+
+	pcie->reset_in_progress = true;
+	dev_info(dev, "Starting PCIe controller reset sequence\n");
+
+	/* Deinitialize the controller */
+	dev_info(dev, "Deinitializing PCIe controller\n");
+	ret = qcom_pcie_deinit(pcie);
+	if (ret) {
+		dev_err(dev, "Controller deinit failed during reset: %d\n", ret);
+		pcie->reset_in_progress = false;
+		mutex_unlock(&pcie->reset_lock);
+		return ret;
+	}
+	dev_info(dev, "Deinit completed successfully\n");
+
+	/* Add delay between deinit and init */
+	dev_info(dev, "Waiting 100ms before re-initialization\n");
+	msleep(100);  /* 100ms delay to allow hardware to settle */
+
+	/* Re-initialize the controller */
+	dev_info(dev, "Re-initializing PCIe controller\n");
+	ret = qcom_pcie_init(pcie, pdev);
+	if (ret) {
+		dev_err(dev, "Controller init failed during reset: %d\n", ret);
+		dev_warn(dev, "Controller left in deinitialized state after failed reset\n");
+		pcie->reset_in_progress = false;
+		mutex_unlock(&pcie->reset_lock);
+		return ret;
+	}
+
+	/* Update platform driver data to ensure same pcie structure is used */
+	platform_set_drvdata(pdev, pcie);
+
+	pcie->reset_in_progress = false;
+	mutex_unlock(&pcie->reset_lock);
+
+	dev_info(dev, "PCIe controller reset completed successfully\n");
+	return count;
+}
+static DEVICE_ATTR_RW(qcom_pcie_controller_reset);
+
 static struct attribute *qcom_pcie_attrs[] = {
 	&dev_attr_qcom_pcie_error_report.attr,
 	&dev_attr_qcom_pcie_init_trigger.attr,
 	&dev_attr_qcom_pcie_deinit_trigger.attr,
+	&dev_attr_qcom_pcie_controller_reset.attr,
 	NULL,
 };
 
@@ -1504,6 +1619,9 @@ static int qcom_pcie_ecam_probe(struct platform_device *pdev)
 
 	pcie->dev = dev;
 
+	/* Initialize reset lock */
+	mutex_init(&pcie->reset_lock);
+
 	if (of_property_read_reg(dev->of_node, 0, &addr, NULL) < 0) {
 		dev_err(dev, "Failed to get dbi address\n");
 		return -ENODEV;
-- 

