Subject: [PATCH 06/20] PENDING: usb: host: xhci-plat: Trivial code cleanup

Trivial code cleanup for xhci resource init.

Change-Id: I3c9658043e41187fe8eaddbf1aac8c5d6e3113b8
Signed-off-by: Sriram Dash <quic_sriramd@quicinc.com>
---
 drivers/usb/host/xhci-plat.c | 85 ++++++++++++++++++++----------------
 1 file changed, 47 insertions(+), 38 deletions(-)

diff --git a/drivers/usb/host/xhci-plat.c b/drivers/usb/host/xhci-plat.c
index d68e9abcdc69a..fa90b2a3581a1 100644
--- a/drivers/usb/host/xhci-plat.c
+++ b/drivers/usb/host/xhci-plat.c
@@ -139,6 +139,49 @@ static const struct of_device_id usb_xhci_of_match[] = {
 MODULE_DEVICE_TABLE(of, usb_xhci_of_match);
 #endif
 
+static int xhci_resource_init(struct platform_device *pdev, struct xhci_hcd *xhci)
+{
+	int ret;
+
+	/*
+	 * Not all platforms have clks so it is not an error if the
+	 * clock do not exist.
+	 */
+	xhci->reg_clk = devm_clk_get_optional(&pdev->dev, "reg");
+	if (IS_ERR(xhci->reg_clk))
+		return PTR_ERR(xhci->reg_clk);
+
+	xhci->clk = devm_clk_get_optional(&pdev->dev, NULL);
+	if (IS_ERR(xhci->clk))
+		return PTR_ERR(xhci->clk);
+
+	xhci->reset = devm_reset_control_array_get_optional_shared(&pdev->dev);
+	if (IS_ERR(xhci->reset))
+		return PTR_ERR(xhci->reset);
+
+	ret = reset_control_deassert(xhci->reset);
+	if (ret)
+		return ret;
+
+	ret = clk_prepare_enable(xhci->reg_clk);
+	if (ret)
+		goto err_reset;
+
+	ret = clk_prepare_enable(xhci->clk);
+	if (ret)
+		goto disable_reg_clk;
+
+	return ret;
+
+disable_reg_clk:
+	clk_disable_unprepare(xhci->reg_clk);
+
+err_reset:
+	reset_control_assert(xhci->reset);
+
+	return ret;
+}
+
 int xhci_plat_probe(struct platform_device *pdev, struct device *sysdev, const struct xhci_plat_priv *priv_match)
 {
 	const struct hc_driver	*driver;
@@ -191,40 +234,10 @@ int xhci_plat_probe(struct platform_device *pdev, struct device *sysdev, const s
 
 	xhci->allow_single_roothub = 1;
 
-	/*
-	 * Not all platforms have clks so it is not an error if the
-	 * clock do not exist.
-	 */
-	xhci->reg_clk = devm_clk_get_optional(&pdev->dev, "reg");
-	if (IS_ERR(xhci->reg_clk)) {
-		ret = PTR_ERR(xhci->reg_clk);
-		goto put_hcd;
-	}
-
-	xhci->clk = devm_clk_get_optional(&pdev->dev, NULL);
-	if (IS_ERR(xhci->clk)) {
-		ret = PTR_ERR(xhci->clk);
-		goto put_hcd;
-	}
-
-	xhci->reset = devm_reset_control_array_get_optional_shared(&pdev->dev);
-	if (IS_ERR(xhci->reset)) {
-		ret = PTR_ERR(xhci->reset);
-		goto put_hcd;
-	}
-
-	ret = reset_control_deassert(xhci->reset);
+	ret = xhci_resource_init(pdev, xhci);
 	if (ret)
 		goto put_hcd;
 
-	ret = clk_prepare_enable(xhci->reg_clk);
-	if (ret)
-		goto err_reset;
-
-	ret = clk_prepare_enable(xhci->clk);
-	if (ret)
-		goto disable_reg_clk;
-
 	if (priv_match) {
 		priv = hcd_to_xhci_priv(hcd);
 		/* Just copy data for now */
@@ -267,12 +280,12 @@ int xhci_plat_probe(struct platform_device *pdev, struct device *sysdev, const s
 		if (IS_ERR(hcd->usb_phy)) {
 			ret = PTR_ERR(hcd->usb_phy);
 			if (ret == -EPROBE_DEFER)
-				goto disable_clk;
+				goto disable_resources;
 			hcd->usb_phy = NULL;
 		} else {
 			ret = usb_phy_init(hcd->usb_phy);
 			if (ret)
-				goto disable_clk;
+				goto disable_resources;
 		}
 	}
 
@@ -343,13 +356,9 @@ int xhci_plat_probe(struct platform_device *pdev, struct device *sysdev, const s
 disable_usb_phy:
 	usb_phy_shutdown(hcd->usb_phy);
 
-disable_clk:
+disable_resources:
 	clk_disable_unprepare(xhci->clk);
-
-disable_reg_clk:
