Date: Wed, 26 Nov 2025 18:14:59 +0530
Subject: [PATCH 6/7] Revert "PENDING: ufs: ufs-qcom: Skip UFS link startup in
 HLOS"

This reverts commit 91eca375be85c91672b3c0e8eea9bf24afd9c14c.

Change-Id: I20788e6f01de4aca7df5a352ba6d404aaa3ed52f
Signed-off-by: Ram Kumar Dwivedi <rdwivedi@qti.qualcomm.com>
---
 drivers/ufs/core/ufshcd.c | 15 ---------------
 1 file changed, 15 deletions(-)

diff --git a/drivers/ufs/core/ufshcd.c b/drivers/ufs/core/ufshcd.c
index ba3a51d3e92c..ab3b6d36dcf1 100644
--- a/drivers/ufs/core/ufshcd.c
+++ b/drivers/ufs/core/ufshcd.c
@@ -4909,12 +4909,8 @@ static int ufshcd_hba_execute_hce(struct ufs_hba *hba)
 {
 	int retry_outer = 3;
 	int retry_inner;
-	static int is_boot = true;
 
 start:
-	if (!strncmp(hba->vops->name, "qcom-fmr", 8) && (is_boot))
-		goto fmr_managed;
-
 	if (ufshcd_is_hba_active(hba))
 		/* change controller state to "reset state" */
 		ufshcd_hba_stop(hba);
@@ -4922,7 +4918,6 @@ static int ufshcd_hba_execute_hce(struct ufs_hba *hba)
 	/* UniPro link is disabled at this point */
 	ufshcd_set_link_off(hba);
 
-fmr_managed:
 	ufshcd_vops_hce_enable_notify(hba, PRE_CHANGE);
 
 	/* start controller initialization sequence */
@@ -4962,8 +4957,6 @@ static int ufshcd_hba_execute_hce(struct ufs_hba *hba)
 
 	ufshcd_vops_hce_enable_notify(hba, POST_CHANGE);
 
-	is_boot = false;
-
 	return 0;
 }
 
@@ -5062,14 +5055,6 @@ static int ufshcd_link_startup(struct ufs_hba *hba)
 	int ret;
 	int retries = DME_LINKSTARTUP_RETRIES;
 	bool link_startup_again = false;
-	static bool is_boot = true;
-
-	if (!strncmp(hba->vops->name, "qcom-fmr", 8) && (is_boot)) {
-		ufshcd_init_pwr_info(hba);
-		ret = ufshcd_make_hba_operational(hba);
-		is_boot = false;
-		return ret;
-	}
 
 	/*
 	 * If UFS device isn't active then we will have to issue link startup
