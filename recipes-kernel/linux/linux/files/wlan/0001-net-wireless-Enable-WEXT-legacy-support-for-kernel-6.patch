From d49c4f64ac2a34f7477da3978877145ba0d61282 Mon Sep 17 00:00:00 2001
From: Ben Wang <benw@qti.qualcomm.com>
Date: Wed, 1 Jul 2026 17:35:15 +0800
Subject: [PATCH] net/wireless: Enable WEXT legacy support for kernel 6.6

In kernel 6.6, CONFIG_GKI_LEGACY_WEXT_ALLCONFIG was removed and
WIRELESS_EXT/WEXT_PRIV/WEXT_SPY became hidden bools with no default,
causing make olddefconfig to strip them. This breaks iwpriv support
in WLAN drivers that check CONFIG_WIRELESS_EXT.

Change WIRELESS_EXT, WEXT_SPY and WEXT_PRIV from plain 'bool' to
'def_bool y' so they are always enabled, restoring the behavior
equivalent to kernel 5.15's GKI_LEGACY_WEXT_ALLCONFIG.

Change-Id: I1c5df7bb48b4d6b44d7cd733644a884b54e24f79
Signed-off-by: Ben Wang <benw@qti.qualcomm.com>
---
 net/wireless/Kconfig | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/net/wireless/Kconfig b/net/wireless/Kconfig
index f620acd2a0f5..3d3c91ed1932 100644
--- a/net/wireless/Kconfig
+++ b/net/wireless/Kconfig
@@ -1,6 +1,6 @@
 # SPDX-License-Identifier: GPL-2.0-only
 config WIRELESS_EXT
-	bool
+	def_bool y
 
 config WEXT_CORE
 	def_bool y
@@ -12,10 +12,10 @@ config WEXT_PROC
 	depends on WEXT_CORE
 
 config WEXT_SPY
-	bool
+	def_bool y
 
 config WEXT_PRIV
-	bool
+	def_bool y
 
 config CFG80211
 	tristate "cfg80211 - wireless configuration API"
-- 
2.43.0

