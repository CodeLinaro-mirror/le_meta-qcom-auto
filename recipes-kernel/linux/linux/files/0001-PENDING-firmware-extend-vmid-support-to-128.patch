 {
 	struct page *p;
 	struct qcom_scm_vmperm perms[2];
-	u64 src  = BIT(QCOM_SCM_VMID_HLOS);
+	u64 src[2] = {0};
 	int ret;
 
 	struct arm_smmu_domain *domain = (void *)cookie;
 
+	src[0] = BIT(QCOM_SCM_VMID_HLOS);
 	p = alloc_page(gfp);
 	if (!p)
 		return NULL;
@@ -436,7 +437,7 @@ static void *qcom_alloc_pages(void *cookie, size_t size, gfp_t gfp)
