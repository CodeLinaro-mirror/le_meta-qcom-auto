From 846c6e51e5d8b6c888ba448a9b25fdb62397ae2f Mon Sep 17 00:00:00 2001
From: Shashank Babu Chinta Venkata <schintav@qti.qualcomm.com>
Date: Thu, 26 Jun 2025 15:04:28 -0700
Subject: [PATCH] PENDING: firmware: extend vmid support to 128

Current implementation only supports source vms under 64
during mem assign API call. With vmid now extending upto 128,
the callers need more than single word to express
source vm in bitmap format.

Change-Id: If9748cc8ee78bf4c0e701b0bc85c171483ade26b
Signed-off-by: Shashank Babu Chinta Venkata <schintav@qti.qualcomm.com>
---
 .../heaps/qcom_dma_heap_secure_utils.c        |  5 ++-
 drivers/firmware/qcom_scm.c                   | 29 +++++++++----
 drivers/iommu/arm/arm-smmu/arm-smmu-qcom.c    | 12 +++---
 drivers/misc/fastrpc.c                        | 42 +++++++++++--------
 drivers/net/wireless/ath/ath10k/qmi.c         | 14 +++----
 drivers/soc/qcom/rmtfs_mem.c                  | 10 ++---
 drivers/virt/gunyah/gunyah_qcom.c             | 23 +++++-----
 include/linux/firmware/qcom/qcom_scm.h        |  3 ++
 sound/soc/qcom/qdsp6/msm_audio_mem.c          | 15 ++++---
 9 files changed, 92 insertions(+), 61 deletions(-)

diff --git a/drivers/dma-buf/heaps/qcom_dma_heap_secure_utils.c b/drivers/dma-buf/heaps/qcom_dma_heap_secure_utils.c
index a50b0fed58a2..9763cecfdc72 100644
--- a/drivers/dma-buf/heaps/qcom_dma_heap_secure_utils.c
+++ b/drivers/dma-buf/heaps/qcom_dma_heap_secure_utils.c
@@ -256,11 +256,12 @@ int hyp_assign_from_flags(u64 base, u64 size, unsigned long flags)
 {
 	int *vmids, *modes;
 	u32 nr;
-	u64 src_vm = BIT(QCOM_SCM_VMID_HLOS);
+	u64 src_vm [2] = {0};
 	struct qcom_scm_vmperm *newvm;
 	int ret;
 	int i;
 
+	src_vm[0] = BIT(QCOM_SCM_VMID_HLOS);
 	ret = get_vmperm_from_ion_flags(flags, &vmids, &modes, &nr);
 	if (ret)
 		return ret;
@@ -274,7 +275,7 @@ int hyp_assign_from_flags(u64 base, u64 size, unsigned long flags)
 		newvm[i].vmid = vmids[i];
 		newvm[i].perm = modes[i];
 	}
-	ret = qcom_scm_assign_mem(base, size, &src_vm, newvm, nr);
+	ret = qcom_scm_assign_mem(base, size, &src_vm[0], newvm, nr);
 	if (ret)
 		pr_err("%s: Assign call failed, flags 0x%lx\n", __func__,
 		       flags);
diff --git a/drivers/firmware/qcom_scm.c b/drivers/firmware/qcom_scm.c
index 36edd96a84eb..b77c3ce1395a 100644
--- a/drivers/firmware/qcom_scm.c
+++ b/drivers/firmware/qcom_scm.c
@@ -1006,6 +1006,16 @@ static int __qcom_scm_assign_mem(struct device *dev, phys_addr_t mem_region,
 	return ret ? : res.result[0];
 }
 
+void qcom_scm_set_vmid_by_word(u64 *srcvm, int vmid)
+{
+	if (vmid < QCOM_SCM_VM_WORD_SIZE) {
+		srcvm[0] |= BIT(vmid);
+	} else {
+		srcvm[1] |= BIT(vmid - QCOM_SCM_VM_WORD_SIZE);
+	}
+}
+EXPORT_SYMBOL_GPL(qcom_scm_set_vmid_by_word);
+
 /**
  * qcom_scm_assign_mem() - Make a secure call to reassign memory ownership
  * @mem_addr: mem region whose ownership need to be reassigned
@@ -1032,12 +1042,11 @@ int qcom_scm_assign_mem(phys_addr_t mem_addr, size_t mem_sz,
 	size_t dest_sz;
 	size_t src_sz;
 	size_t ptr_sz;
-	int next_vm;
+	u64 next_vm[2] = {0};
 	__le32 *src;
 	int ret, i, b;
-	u64 srcvm_bits = *srcvm;
 
-	src_sz = hweight64(srcvm_bits) * sizeof(*src);
+	src_sz = (hweight64(srcvm[0]) + (hweight64(srcvm[1]))) * sizeof(*src);
 	mem_to_map_sz = sizeof(*mem_to_map);
 	dest_sz = dest_cnt * sizeof(*destvm);
 	ptr_sz = ALIGN(src_sz, SZ_64) + ALIGN(mem_to_map_sz, SZ_64) +
@@ -1054,7 +1063,12 @@ int qcom_scm_assign_mem(phys_addr_t mem_addr, size_t mem_sz,
 	src = ptr;
 	i = 0;
 	for (b = 0; b < BITS_PER_TYPE(u64); b++) {
-		if (srcvm_bits & BIT(b))
+		if (srcvm[0] & BIT(b))
+			src[i++] = cpu_to_le32(b);
+	}
+
+	for (b = QCOM_SCM_VM_WORD_SIZE; b < QCOM_SCM_MAX_VMID; b++) {
+		if (srcvm[1] & BIT(b - QCOM_SCM_VM_WORD_SIZE))
 			src[i++] = cpu_to_le32(b);
 	}
 
@@ -1064,7 +1078,6 @@ int qcom_scm_assign_mem(phys_addr_t mem_addr, size_t mem_sz,
 	mem_to_map->mem_addr = cpu_to_le64(mem_addr);
 	mem_to_map->mem_size = cpu_to_le64(mem_sz);
 
-	next_vm = 0;
 	/* Fill details of next vmid detail */
 	destvm = ptr + ALIGN(mem_to_map_sz, SZ_64) + ALIGN(src_sz, SZ_64);
 	dest_phys = ptr_phys + ALIGN(mem_to_map_sz, SZ_64) + ALIGN(src_sz, SZ_64);
@@ -1073,7 +1086,7 @@ int qcom_scm_assign_mem(phys_addr_t mem_addr, size_t mem_sz,
 		destvm->perm = cpu_to_le32(newvm->perm);
 		destvm->ctx = 0;
 		destvm->ctx_size = 0;
-		next_vm |= BIT(newvm->vmid);
+		qcom_scm_set_vmid_by_word(&next_vm[0], newvm->vmid);
 	}
 
 	ret = __qcom_scm_assign_mem(__scm->dev, mem_to_map_phys, mem_to_map_sz,
@@ -1081,10 +1094,12 @@ int qcom_scm_assign_mem(phys_addr_t mem_addr, size_t mem_sz,
 	if (ret) {
 		dev_err(__scm->dev,
 			"Assign memory protection call failed %d\n", ret);
+		WARN_ON(1);
 		return -EINVAL;
 	}
 
-	*srcvm = next_vm;
+	srcvm[0] = next_vm[0];
+	srcvm[1] = next_vm[1];
 	return 0;
 }
 EXPORT_SYMBOL_GPL(qcom_scm_assign_mem);
