From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AU.0.3.0 porting <noreply@qti.qualcomm.com>
Date: Wed, 2 Jul 2026 00:00:00 -0700
Subject: [PATCH] qcom_scm: add qcom_scm compat helpers for OOT modules

Minimal subset of the QLI-2.0 qcom_scm_addon patch: adds only
qcom_scm_set_vmid_by_word() and camera CAMNOC QoS support needed by OOT
modules, plus the gunyah VFIO container DMA-owner relaxation. The full
qcom_scm_addon.c/.h is not carried because most addon APIs are not needed for
this target.

Signed-off-by: Venkatakrishnaiah Pari <vpari@qti.qualcomm.com>

Upstream-Status: Inappropriate
---
diff --git a/drivers/firmware/qcom/qcom_scm.c b/drivers/firmware/qcom/qcom_scm.c
index 38feefda7dd0..6ee5d32d5ac7 100644
--- a/drivers/firmware/qcom/qcom_scm.c
+++ b/drivers/firmware/qcom/qcom_scm.c
@@ -1313,6 +1313,61 @@ int qcom_scm_mem_protect_video_var(u32 cp_start, u32 cp_size,
 }
 EXPORT_SYMBOL_GPL(qcom_scm_mem_protect_video_var);
 
+void qcom_scm_set_vmid_by_word(u64 *srcvm, int vmid)
+{
+	if (vmid < QCOM_SCM_VM_WORD_SIZE) {
+		srcvm[0] |= BIT(vmid);
+	} else {
+		srcvm[1] |= BIT(vmid - QCOM_SCM_VM_WORD_SIZE);
+	}
+}
+EXPORT_SYMBOL_GPL(qcom_scm_set_vmid_by_word);
+
+int qcom_scm_camera_update_camnoc_qos(u32 use_case_id, u32 cam_qos_cnt,
+				      struct qcom_scm_camera_qos *cam_qos)
+{
+	struct qcom_scm_desc desc = {
+		.svc = QCOM_SCM_SVC_CAMERA,
+		.cmd = QCOM_SCM_CAMERA_UPDATE_CAMNOC_QOS,
+		.owner = ARM_SMCCC_OWNER_SIP,
+		.args[0] = use_case_id,
+		.arginfo = QCOM_SCM_ARGS(3, QCOM_SCM_VAL, QCOM_SCM_RW,
+					 QCOM_SCM_VAL),
+	};
+	struct qcom_scm_camera_qos *payload_buf = NULL;
+	dma_addr_t payload_phys;
+	size_t payload_size;
+	int ret;
+
+	if (cam_qos_cnt > QCOM_SCM_CAMERA_MAX_QOS_CNT ||
+	    (cam_qos_cnt && !cam_qos)) {
+		pr_err("Invalid input SmartQoS count: %u\n", cam_qos_cnt);
+		return -EINVAL;
+	}
+
+	payload_size = cam_qos_cnt * sizeof(*cam_qos);
+	desc.args[2] = payload_size;
+
+	if (use_case_id && payload_size) {
+		payload_buf = dma_alloc_coherent(__scm->dev, payload_size,
+						 &payload_phys, GFP_KERNEL);
+		if (!payload_buf)
+			return -ENOMEM;
+
+		memcpy(payload_buf, cam_qos, payload_size);
+		desc.args[1] = payload_phys;
+	}
+
+	ret = qcom_scm_call(__scm->dev, &desc, NULL);
+
+	if (payload_buf)
+		dma_free_coherent(__scm->dev, payload_size, payload_buf,
+				  payload_phys);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(qcom_scm_camera_update_camnoc_qos);
+
 static int __qcom_scm_assign_mem(struct device *dev, phys_addr_t mem_region,
 				 size_t mem_sz, phys_addr_t src, size_t src_sz,
 				 phys_addr_t dest, size_t dest_sz)
diff --git a/drivers/vfio/container.c b/drivers/vfio/container.c
index 003281dbf8bc..ad1da1e598e4 100644
--- a/drivers/vfio/container.c
+++ b/drivers/vfio/container.c
@@ -433,11 +433,13 @@ int vfio_container_attach_group(struct vfio_container *container,
 		goto out_unlock_container;
 	}
 
+/*
 	if (group->type == VFIO_IOMMU) {
 		ret = iommu_group_claim_dma_owner(group->iommu_group, group);
 		if (ret)
 			goto out_unlock_container;
 	}
+*/
 
 	driver = container->iommu_driver;
 	if (driver) {
@@ -480,8 +482,10 @@ void vfio_group_detach_container(struct vfio_group *group)
 		driver->ops->detach_group(container->iommu_data,
 					  group->iommu_group);
 
+/*
 	if (group->type == VFIO_IOMMU)
 		iommu_group_release_dma_owner(group->iommu_group);
+*/
 
 	group->container = NULL;
 	group->container_users = 0;
diff --git a/include/linux/firmware/qcom/qcom_scm.h b/include/linux/firmware/qcom/qcom_scm.h
index d84b5eb6870c..257e39bcdd31 100644
--- a/include/linux/firmware/qcom/qcom_scm.h
+++ b/include/linux/firmware/qcom/qcom_scm.h
@@ -60,10 +60,23 @@ enum qcom_scm_ice_cipher {
 #define QCOM_SCM_PERM_EXEC       0x1
 #define QCOM_SCM_PERM_RW (QCOM_SCM_PERM_READ | QCOM_SCM_PERM_WRITE)
 #define QCOM_SCM_PERM_RWX (QCOM_SCM_PERM_RW | QCOM_SCM_PERM_EXEC)
+#define QCOM_SCM_VM_WORD_SIZE       64
+#define QCOM_SCM_MAX_VMID       128
+#define QCOM_SCM_SVC_CAMERA       0x18
+#define QCOM_SCM_CAMERA_UPDATE_CAMNOC_QOS       0xA
+#define QCOM_SCM_CAMERA_MAX_QOS_CNT       2
+
+struct qcom_scm_camera_qos {
+	u32 offset;
+	u32 val;
+};
 
 bool qcom_scm_is_available(void);
 
 int qcom_scm_set_cold_boot_addr(void *entry);
+extern void qcom_scm_set_vmid_by_word(u64 *srcvm, int vmid);
+int qcom_scm_camera_update_camnoc_qos(u32 use_case_id, u32 qos_cnt,
+				      struct qcom_scm_camera_qos *scm_buf);
 int qcom_scm_set_warm_boot_addr(void *entry);
 void qcom_scm_cpu_power_down(u32 flags);
 int qcom_scm_set_remote_state(u32 state, u32 id);
