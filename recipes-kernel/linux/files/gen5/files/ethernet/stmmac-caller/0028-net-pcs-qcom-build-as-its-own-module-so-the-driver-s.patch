From d71340e87af884ea3824d3370590f2edcc433db4 Mon Sep 17 00:00:00 2001
From: Sagar Cheluvegowda <quic_scheluve@quicinc.com>
Date: Tue, 8 Sep 2026 18:45:35 -0700
Subject: [PATCH 28/28] net: pcs: qcom: build as its own module so the driver
 self-registers

Commit "net: pcs: qcom: avoid duplicate init_module/cleanup_module"
(ethernet patch 0016) resolved a link failure - two module_init()s in one
pcs_xpcs.ko - by replacing this driver's module_platform_driver() with
exported qcom_xpcs_driver_register()/_unregister() helpers, to be called by
whichever consumer wires up qcom,xpcs.

Nothing ever called them. With the ethqos-side consumer now in place, the
qcom XPCS platform driver was therefore never registered on the platform
bus: the qcom,xpcs node created a platform device that nothing bound to, so
probe() never ran and platform_set_drvdata() was never called. That made
qcom_xpcs_create() fail its "!platform_get_drvdata(pdev)" guard and return
-EPROBE_DEFER unconditionally, so ethernet never probed.

Link the object into its own pcs-xpcs-qcom.ko instead. It has no undefined
references into pcs-xpcs.o, so no new exports are needed, and owning its own
module means it can carry module_platform_driver() without reintroducing the
duplicate-init_module failure this originally worked around.

While here:

 - add MODULE_DEVICE_TABLE(of, ...) so the module autoloads from the
   qcom,xpcs compatible rather than only as a dependency;
 - rename .driver.name to "qcom-dwxpcs". Both this driver and the generic
   pcs-xpcs-plat.c driver used "dwxpcs", and driver_register() rejects a
   duplicate name on the same bus, so registering both would have failed;
 - propagate qcom_xpcs_create()'s error out of ethqos_xpcs_init() instead of
   squashing it to -ENODEV, so a genuine -EPROBE_DEFER can be retried.

This supersedes the register/unregister approach from ethernet patch 0016;
the two can be squashed before upstreaming.

Signed-off-by: Sagar Cheluvegowda <quic_scheluve@quicinc.com>
---
 .../stmicro/stmmac/dwmac-qcom-ethqos.c        |  8 ++++++-
 drivers/net/pcs/Makefile                      |  3 ++-
 drivers/net/pcs/pcs-xpcs-qcom.c               | 23 +++----------------
 include/linux/pcs-xpcs-qcom.h                 |  3 ---
 4 files changed, 12 insertions(+), 25 deletions(-)

diff --git a/drivers/net/ethernet/stmicro/stmmac/dwmac-qcom-ethqos.c b/drivers/net/ethernet/stmicro/stmmac/dwmac-qcom-ethqos.c
index 55e1af7ac3d22..b9c3949682064 100644
--- a/drivers/net/ethernet/stmicro/stmmac/dwmac-qcom-ethqos.c
+++ b/drivers/net/ethernet/stmicro/stmmac/dwmac-qcom-ethqos.c
@@ -1242,7 +1242,13 @@ static int ethqos_xpcs_init(struct stmmac_priv *priv)
 	xpcs_node = of_parse_phandle(priv->device->of_node, "qcom-xpcs-handle", 0);
 
 	priv->hw->phylink_pcs = qcom_xpcs_create(xpcs_node, priv->plat->phy_interface);
-	if (IS_ERR_OR_NULL(priv->hw->phylink_pcs))
+	/* Propagate the real error: qcom_xpcs_create() returns -EPROBE_DEFER
+	 * when the qcom,xpcs device has not been bound yet, and squashing that
+	 * to -ENODEV would turn a retryable defer into a permanent failure.
+	 */
+	if (IS_ERR(priv->hw->phylink_pcs))
+		return PTR_ERR(priv->hw->phylink_pcs);
+	if (!priv->hw->phylink_pcs)
 		return -ENODEV;
 
 	return 0;
diff --git a/drivers/net/pcs/Makefile b/drivers/net/pcs/Makefile
index 14d61bc99c844..a04c2b054f0a9 100644
--- a/drivers/net/pcs/Makefile
+++ b/drivers/net/pcs/Makefile
@@ -2,9 +2,10 @@
 # Makefile for Linux PCS drivers
 
 pcs_xpcs-$(CONFIG_PCS_XPCS)	:= pcs-xpcs.o pcs-xpcs-plat.o \
-				   pcs-xpcs-nxp.o pcs-xpcs-wx.o pcs-xpcs-qcom.o
+				   pcs-xpcs-nxp.o pcs-xpcs-wx.o
 
 obj-$(CONFIG_PCS_XPCS)		+= pcs_xpcs.o
+obj-$(CONFIG_PCS_XPCS)		+= pcs-xpcs-qcom.o
 obj-$(CONFIG_PCS_LYNX)		+= pcs-lynx.o
 obj-$(CONFIG_PCS_MTK_LYNXI)	+= pcs-mtk-lynxi.o
 obj-$(CONFIG_PCS_RZN1_MIIC)	+= pcs-rzn1-miic.o
diff --git a/drivers/net/pcs/pcs-xpcs-qcom.c b/drivers/net/pcs/pcs-xpcs-qcom.c
index 8a36462d72d89..01873ed41e89a 100644
--- a/drivers/net/pcs/pcs-xpcs-qcom.c
+++ b/drivers/net/pcs/pcs-xpcs-qcom.c
@@ -1227,32 +1227,15 @@ static const struct of_device_id qcom_xpcs_match[] = {
 	{ .compatible = "qcom,xpcs"},
 	{}
 };
+MODULE_DEVICE_TABLE(of, qcom_xpcs_match);
 
 static struct platform_driver pcs_xpcs_qcom_driver = {
 	.probe = qcom_xpcs_probe,
 	.driver = {
-		.name = "dwxpcs",
+		.name = "qcom-dwxpcs",
 		.of_match_table = of_match_ptr(qcom_xpcs_match),
 	},
 };
-
-/*
- * Not wrapped in module_platform_driver()/module_init(): this object is
- * linked into the same pcs_xpcs.ko as pcs-xpcs-plat.c, which already owns
- * that module's init_module/cleanup_module. The caller that wires up
- * qcom,xpcs (the stmmac/ethqos-side consumer of qcom_xpcs_create()) is
- * responsible for calling qcom_xpcs_driver_register()/_unregister().
- */
-int qcom_xpcs_driver_register(void)
-{
-	return platform_driver_register(&pcs_xpcs_qcom_driver);
-}
-EXPORT_SYMBOL_GPL(qcom_xpcs_driver_register);
-
-void qcom_xpcs_driver_unregister(void)
-{
-	platform_driver_unregister(&pcs_xpcs_qcom_driver);
-}
-EXPORT_SYMBOL_GPL(qcom_xpcs_driver_unregister);
+module_platform_driver(pcs_xpcs_qcom_driver);
 
 MODULE_LICENSE("GPL");
diff --git a/include/linux/pcs-xpcs-qcom.h b/include/linux/pcs-xpcs-qcom.h
index 612f0604c676b..5238df9388e3f 100644
--- a/include/linux/pcs-xpcs-qcom.h
+++ b/include/linux/pcs-xpcs-qcom.h
@@ -40,7 +40,4 @@ void qcom_xpcs_destroy(struct phylink_pcs *pcs);
 
 void qcom_xpcs_get_err_stats(struct phylink_pcs *pcs, unsigned long *ptr);
 
-int qcom_xpcs_driver_register(void);
-void qcom_xpcs_driver_unregister(void);
-
 #endif /* __LINUX_PCS_XPCS_QCOM_H */
