@@ -162,7 +181,7 @@ void dw25gmac_dma_init_rx_chan(struct stmmac_priv *priv,
 	/* PDMA to TC mapping */
 	value = rd_dma_ch_ind(ioaddr, MODE_RXEXTCFG, chan);
