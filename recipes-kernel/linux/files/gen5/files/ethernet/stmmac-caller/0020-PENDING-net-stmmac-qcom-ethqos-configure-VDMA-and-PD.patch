 {
 	const struct dwxgmac_addrs *dwxgmac_addrs = priv->plat->dwxgmac_addrs;
-	u32 tc = (dma_cfg->rx_pdma_custom_map ? dma_cfg->rx_pdma_map[chan] : chan);
+	u32 tc_pdma_map, tc_vdma_map, numtc;
