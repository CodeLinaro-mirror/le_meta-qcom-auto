From c4a125b86172edee128a88fc4f5515c57f9c33e6 Mon Sep 17 00:00:00 2001
From: Sagar Cheluvegowda <quic_scheluve@quicinc.com>
Date: Tue, 8 Sep 2026 14:28:22 -0700
Subject: [PATCH 27/28] DEBUG: net: stmmac: dwmac-qcom-ethqos: add ETHDBG
 bring-up prints

Temporary unconditional dev_info() prints on the SA8797P ethernet bring-up
path to aid first-flash debugging on target:

 - qcom_ethqos_domain_attach()   : num_pd + dev_pm_domain_attach_list() ret
 - qcom_ethqos_serdes_set_level(): phy mode, OPP level, ret
 - qcom_ethqos_serdes_up/down()  : callback entry + ret
 - ethqos_fix_mac_speed_usxgmii(): interface, speed, mode, use_domains, pcs

All prints are prefixed 'ETHDBG:' so they can be grepped from dmesg and
this commit dropped wholesale once bring-up is complete.

NOT a gerrit change - debug scaffolding only, do not upstream.

Signed-off-by: Sagar Cheluvegowda <quic_scheluve@quicinc.com>
---
 .../stmicro/stmmac/dwmac-qcom-ethqos.c        | 19 +++++++++++++++++--
 1 file changed, 17 insertions(+), 2 deletions(-)

diff --git a/drivers/net/ethernet/stmicro/stmmac/dwmac-qcom-ethqos.c b/drivers/net/ethernet/stmicro/stmmac/dwmac-qcom-ethqos.c
index 650f8aad0be68..55e1af7ac3d22 100644
--- a/drivers/net/ethernet/stmicro/stmmac/dwmac-qcom-ethqos.c
+++ b/drivers/net/ethernet/stmicro/stmmac/dwmac-qcom-ethqos.c
@@ -411,6 +411,7 @@ static int qcom_ethqos_domain_attach(struct qcom_ethqos *ethqos)
 {
 	struct ethqos_emac_driver_data *data;
 	struct device *dev = &ethqos->pdev->dev;
+	int ret;
 
 	data = of_device_get_match_data(dev);
 	if (!data) {
@@ -418,8 +419,12 @@ static int qcom_ethqos_domain_attach(struct qcom_ethqos *ethqos)
 		return -EINVAL;
 	}
 
-	dev_dbg(dev, "qcom_ethqos_domain_attach num pd %d\n", data->pd_data.num_pd_names);
-	return dev_pm_domain_attach_list(dev, &data->pd_data, &ethqos->pd_list);
+	dev_info(dev, "ETHDBG: domain_attach: num_pd=%d\n",
+		 data->pd_data.num_pd_names);
+	ret = dev_pm_domain_attach_list(dev, &data->pd_data, &ethqos->pd_list);
+	dev_info(dev, "ETHDBG: domain_attach: dev_pm_domain_attach_list ret=%d\n",
+		 ret);
+	return ret;
 }
 
 static int qcom_ethqos_domain_on(struct qcom_ethqos *ethqos, enum domain_t dom)
@@ -469,6 +474,8 @@ static int qcom_ethqos_serdes_set_level(struct qcom_ethqos *ethqos)
 		dev = ethqos->pd_list->pd_devs[PERF_SERDES];
 	}
 	ret = dev_pm_opp_set_level(dev, ethqos->serdes_speed);
+	dev_info(dev, "ETHDBG: serdes_set_level: mode=%s level(serdes_speed)=%d ret=%d\n",
+		 phy_modes(ethqos->phy_mode), ethqos->serdes_speed, ret);
 	if (ret)
 		dev_err(dev, "Failed to set serdes level. (err=%d)\n", ret);
 
@@ -812,6 +819,11 @@ static void ethqos_fix_mac_speed_usxgmii(void *bsp_priv,
 	struct stmmac_priv *priv = netdev_priv(ndev);
 	unsigned int i;
 
+	dev_info(&ethqos->pdev->dev,
+		 "ETHDBG: fix_mac_speed_usxgmii: iface=%s speed=%d mode=%u use_domains=%d pcs=%p\n",
+		 phy_modes(interface), speed, mode, ethqos->use_domains,
+		 priv->hw->phylink_pcs);
+
 	qcom_ethqos_set_sgmii_loopback(ethqos, false);
 
 	/* Reset to POR values */
@@ -948,6 +960,7 @@ static int qcom_ethqos_serdes_up(struct net_device *ndev, void *priv)
 	int ret = 0;
 
 	ret = qcom_ethqos_serdes_set_level(ethqos);
+	dev_info(&ethqos->pdev->dev, "ETHDBG: serdes_up: ret=%d\n", ret);
 
 	return ret;
 }
@@ -958,6 +971,8 @@ static void qcom_ethqos_serdes_down(struct net_device *ndev, void *priv)
 	int old_speed = ethqos->serdes_speed;
 	int domain = PERF_SERDES;
 
+	dev_info(&ethqos->pdev->dev, "ETHDBG: serdes_down: enter (was %d)\n",
+		 old_speed);
 	ethqos->serdes_speed = 10;
 	qcom_ethqos_serdes_set_level(ethqos);
 	ethqos->serdes_speed = old_speed;
