From fb85c036a0a2c5f6570349e28e0694f2c905733b Mon Sep 17 00:00:00 2001
From: Sriram Dash <quic_sriramd@quicinc.com>
Date: Fri, 28 Feb 2025 16:34:21 +0530
Subject: [PATCH 07/17] usb: dwc3: qcom: Add support for sa8255p for qcom usb

QCOM SoC sa8255p allow multiple resources to be managed
by firmware. On this platform, tasks related to clocks, regulators,
resets, TLMM and interconnects can be delegated to the firmware,
while the remaining responsibilities are handled by Linux.

The power domain, managed through the PM runtime framework,
is utilized for activation/deactivation of the resources.

Power domain "usb_core" controls the GDSC, resets,
and TLMM(gpio) whereas power domain "usb_transfer"
controls clocks and interconnects.

On this platform, the two disjoint sets of resources are modeled against
the power domain suppliers which can be turned on/off to achieve modeled
device states. Two modeled low power states d1 and d3 are supported.

transition: d0 <--> d3  :: both core and transfer suppliers
transition: d0 <--> d1  :: only transfer supplier

Ported from meta-qti-auto-kernel patch: 0012-PENDING-usb-dwc3-qcom-Add-support-for-sa8255p-for-qc.patch
Adapted the fw_managed/power-domain d0/d1/d3 transition support onto this
tree's dwc3-qcom.c, which already uses the dwc3_probe_data/dwc3_core_probe
glue API. Two hunks from the original patch were omitted as not applicable:
the has_acpi_companion()/dwc3_qcom_acpi_register_core() branch (this file
has no ACPI support at all), and the dwc3_qcom_props[] xhci-reset-on-resume
property entry (that array does not exist here since it was introduced by
a patch skipped earlier in this port).

Change-Id: Iaa236081cd76d263279d23115534bd2b81ec70ba
Signed-off-by: Sriram Dash <quic_sriramd@quicinc.com>
Signed-off-by: Shazad Hussain <quic_shazhuss@quicinc.com>
---
 drivers/usb/dwc3/dwc3-qcom.c | 135 +++++++++++++++++++++++++++++++++--
 1 file changed, 131 insertions(+), 4 deletions(-)

diff --git a/drivers/usb/dwc3/dwc3-qcom.c b/drivers/usb/dwc3/dwc3-qcom.c
index 5579cf48e120..965b333d3743 100644
--- a/drivers/usb/dwc3/dwc3-qcom.c
+++ b/drivers/usb/dwc3/dwc3-qcom.c
@@ -13,6 +13,7 @@
 #include <linux/kernel.h>
 #include <linux/interconnect.h>
 #include <linux/platform_device.h>
+#include <linux/pm_domain.h>
 #include <linux/phy/phy.h>
 #include <linux/usb/of.h>
 #include <linux/reset.h>
@@ -78,6 +79,10 @@ struct dwc3_qcom_port {
 	enum usb_device_speed	usb2_speed;
 };
 
+struct dwc3_qcom_priv_data {
+	bool	fw_managed;
+};
+
 struct dwc3_qcom {
 	struct device		*dev;
 	void __iomem		*qscratch_base;
@@ -96,10 +101,83 @@ struct dwc3_qcom {
 
 	bool			ignore_pipe_clk;
 	enum usb_role		current_role;
+
+	struct dev_pm_domain_list	*pd_list;
 };
 
 #define to_dwc3_qcom(d) container_of((d), struct dwc3_qcom, dwc)
 
+static const struct dwc3_qcom_priv_data sa8255p_dwc3_qcom_priv_data = {
+	.fw_managed	= true,
+};
+
+static void dwc3_qcom_domain_detach(struct dwc3_qcom *qcom)
+{
+	dev_pm_domain_detach_list(qcom->pd_list);
+}
+
+static int dwc3_qcom_domain_attach(struct dwc3_qcom *qcom)
+{
+	struct dev_pm_domain_attach_data pd_data = {
+		.pd_flags	= PD_FLAG_NO_DEV_LINK,
+		.pd_names	= (const char*[]) { "usb_transfer", "usb_core" },
+		.num_pd_names	= 2,
+	};
+	struct device *dev = qcom->dev;
+	int ret;
+
+	ret = dev_pm_domain_attach_list(dev, &pd_data, &qcom->pd_list);
+	if (ret < 0) {
+		dev_err(dev, "domain attach failed %d)\n", ret);
+		return ret;
+	}
+
+	return 0;
+}
+
+/* d3_to_d0 transition by turning on all the suppliers */
+static int dwc3_qcom_d3_to_d0(struct dwc3_qcom *qcom)
+{
+	int ret;
+
+	if (!qcom->pd_list)
+		return 0;
+
+	ret = pm_runtime_resume_and_get(qcom->pd_list->pd_devs[0]);
+	if (ret)
+		return ret;
+
+	return pm_runtime_resume_and_get(qcom->pd_list->pd_devs[1]);
+}
+
+/* d0_to_d3 transition by turning off all the suppliers */
+static void dwc3_qcom_d0_to_d3(struct dwc3_qcom *qcom)
+{
+	if (!qcom->pd_list)
+		return;
+
+	pm_runtime_put_sync(qcom->pd_list->pd_devs[0]);
+	pm_runtime_put_sync(qcom->pd_list->pd_devs[1]);
+}
+
+/* d1_to_d0 transition by turning on the 'transfer' supplier */
+static int dwc3_qcom_d1_to_d0(struct dwc3_qcom *qcom)
+{
+	if (!qcom->pd_list)
+		return 0;
+
+	return pm_runtime_resume_and_get(qcom->pd_list->pd_devs[0]);
+}
+
+/* d0_to_d1 transition by turning off the 'transfer' supplier */
+static void dwc3_qcom_d0_to_d1(struct dwc3_qcom *qcom)
+{
+	if (!qcom->pd_list)
+		return;
+
+	pm_runtime_put_sync(qcom->pd_list->pd_devs[0]);
+}
+
 static inline void dwc3_qcom_setbits(void __iomem *base, u32 offset, u32 val)
 {
 	u32 reg;
@@ -359,6 +437,12 @@ static int dwc3_qcom_suspend(struct dwc3_qcom *qcom, bool wakeup)
 		if (!(val & PWR_EVNT_LPM_IN_L2_MASK))
 			dev_err(qcom->dev, "port-%d HS-PHY not in L2\n", i + 1);
 	}
+
+	if (wakeup)
+		dwc3_qcom_d0_to_d1(qcom);
+	else
+		dwc3_qcom_d0_to_d3(qcom);
+
 	clk_bulk_disable_unprepare(qcom->num_clocks, qcom->clks);
 
 	ret = dwc3_qcom_interconnect_disable(qcom);
@@ -408,6 +492,16 @@ static int dwc3_qcom_resume(struct dwc3_qcom *qcom, bool wakeup)
 	if (dwc3_qcom_is_host(qcom) && wakeup)
 		dwc3_qcom_disable_interrupts(qcom);
 
+	if (wakeup)
+		ret = dwc3_qcom_d1_to_d0(qcom);
+	else
+		ret = dwc3_qcom_d3_to_d0(qcom);
+
+	if (ret < 0) {
+		dev_err(qcom->dev, "Failed to transition to d0 state\n");
+		return ret;
+	}
+
 	ret = clk_bulk_prepare_enable(qcom->num_clocks, qcom->clks);
 	if (ret < 0)
 		return ret;
@@ -647,6 +741,7 @@ static int dwc3_qcom_probe(struct platform_device *pdev)
 	struct dwc3_probe_data	probe_data = {};
 	struct device		*dev = &pdev->dev;
 	struct dwc3_qcom	*qcom;
+	const struct dwc3_qcom_priv_data *priv_data;
 	struct resource		res;
 	struct resource		*r;
 	const struct dwc3_qcom_data *data;
@@ -660,20 +755,39 @@ static int dwc3_qcom_probe(struct platform_device *pdev)
 	qcom->dev = &pdev->dev;
 	data = device_get_match_data(dev);
 
+	priv_data = of_device_get_match_data(dev);
+
+	if (priv_data && priv_data->fw_managed) {
+		ret = dwc3_qcom_domain_attach(qcom);
+		if (ret) {
+			dev_err(dev, "Failed to attach domains. Bail out\n");
+			return ret;
+		}
+	}
+
+	ret = dwc3_qcom_d3_to_d0(qcom);
+	if (ret < 0) {
+		dev_err(qcom->dev, "Failed to transition to d0 state\n");
+		goto domain_detach;
+	}
+
 	qcom->resets = devm_reset_control_array_get_optional_exclusive(dev);
 	if (IS_ERR(qcom->resets)) {
-		return dev_err_probe(&pdev->dev, PTR_ERR(qcom->resets),
+		ret = dev_err_probe(&pdev->dev, PTR_ERR(qcom->resets),
 				     "failed to get resets\n");
+		goto resources_off;
 	}
 
 	ret = devm_clk_bulk_get_all(&pdev->dev, &qcom->clks);
-	if (ret < 0)
-		return dev_err_probe(dev, ret, "failed to get clocks\n");
+	if (ret < 0) {
+		ret = dev_err_probe(dev, ret, "failed to get clocks\n");
+		goto resources_off;
+	}
 	qcom->num_clocks = ret;
 
 	ret = clk_bulk_prepare_enable(qcom->num_clocks, qcom->clks);
 	if (ret < 0)
-		return ret;
+		goto resources_off;
 
 	ret = reset_control_assert(qcom->resets);
 	if (ret) {
@@ -764,6 +878,12 @@ static int dwc3_qcom_probe(struct platform_device *pdev)
 clk_disable:
 	clk_bulk_disable_unprepare(qcom->num_clocks, qcom->clks);
 
+resources_off:
+	dwc3_qcom_d0_to_d3(qcom);
+
+domain_detach:
+	dwc3_qcom_domain_detach(qcom);
+
 	return ret;
 }
 
@@ -779,6 +899,9 @@ static void dwc3_qcom_remove(struct platform_device *pdev)
 	clk_bulk_disable_unprepare(qcom->num_clocks, qcom->clks);
 	dwc3_qcom_interconnect_exit(qcom);
 
+	dwc3_qcom_d0_to_d3(qcom);
+	dwc3_qcom_domain_detach(qcom);
+
 	pm_runtime_put_noidle(qcom->dev);
 }
 
@@ -877,6 +1000,10 @@ static const struct dev_pm_ops dwc3_qcom_dev_pm_ops = {
 
 static const struct of_device_id dwc3_qcom_of_match[] = {
 	{ .compatible = "qcom,nord-dwc3", .data = &dwc3_qcom_nord_data },
+	{
+		.compatible	= "qcom,sa8255p-dwc3",
+		.data		= &sa8255p_dwc3_qcom_priv_data,
+	},
 	{ .compatible = "qcom,snps-dwc3" },
 	{ }
 };
-- 
