+		.args[2] = crc8,
+		.arginfo = QCOM_SCM_ARGS(3, QCOM_SCM_RO, QCOM_SCM_VAL, QCOM_SCM_VAL),
+	};
+	struct qcom_scm_res res;
+
+	ret = qcom_scm_call(__scm->dev, &desc, &res);
