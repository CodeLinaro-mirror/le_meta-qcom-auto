From fcccbd1b91b0a32a40743fafcdc73d184b316763 Mon Sep 17 00:00:00 2001
From: Venkatakrishnaiah Pari <vpari@qti.qualcomm.com>
Date: Wed, 6 May 2026 17:14:43 -0700
Subject: [PATCH] qcom_scm_addon: Enable qcom scm addons

Enable qcom scm addons

Signed-off-by: Venkatakrishnaiah Pari <vpari@qti.qualcomm.com>

Upstream-Status: Inappropriate
---
 drivers/firmware/qcom/qcom_scm.c             |  12 +
 drivers/firmware/qcom/qcom_scm_addon.c       | 725 +++++++++++++++++++
 include/linux/firmware/qcom/qcom_scm.h       |   4 +
 include/linux/firmware/qcom/qcom_scm_addon.h |  70 ++
 4 files changed, 811 insertions(+)
 create mode 100644 drivers/firmware/qcom/qcom_scm_addon.c
 create mode 100644 include/linux/firmware/qcom/qcom_scm_addon.h

diff --git a/drivers/firmware/qcom/qcom_scm.c b/drivers/firmware/qcom/qcom_scm.c
index 8fbc96693a55..46f055803745 100644
--- a/drivers/firmware/qcom/qcom_scm.c
+++ b/drivers/firmware/qcom/qcom_scm.c
@@ -1315,6 +1315,16 @@ int qcom_scm_mem_protect_video_var(u32 cp_start, u32 cp_size,
 }
 EXPORT_SYMBOL_GPL(qcom_scm_mem_protect_video_var);
 
+void qcom_scm_set_vmid_by_word(u64 *srcvm, int vmid)
+{
+	if (vmid < QCOM_SCM_VM_WORD_SIZE) {
+		srcvm[0] |= BIT(vmid);
+	} else {
+		srcvm[1] |= BIT(vmid - QCOM_SCM_VM_WORD_SIZE);
+	}
+}
+EXPORT_SYMBOL_GPL(qcom_scm_set_vmid_by_word);
+
 static int __qcom_scm_assign_mem(struct device *dev, phys_addr_t mem_region,
 				 size_t mem_sz, phys_addr_t src, size_t src_sz,
 				 phys_addr_t dest, size_t dest_sz)
@@ -2640,6 +2650,8 @@ static irqreturn_t qcom_scm_irq_handler(int irq, void *data)
 	return IRQ_HANDLED;
 }
 
+#include "qcom_scm_addon.c"
+
 static int get_download_mode(char *buffer, const struct kernel_param *kp)
 {
 	if (download_mode >= ARRAY_SIZE(download_mode_name))
