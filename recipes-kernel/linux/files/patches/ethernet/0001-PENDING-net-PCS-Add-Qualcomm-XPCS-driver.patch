+#define DW_SR_MII_PCS_TP_B1		0x009c
+#define DW_SR_MII_PCS_TP_B2		0x00a0
+#define DW_SR_MII_PCS_TP_B3		0x00a4
+#define DW_SR_MII_PCS_TP_CTRL		0x00a8
+#define DW_SR_MII_PCS_TP_ERRCTR		0x00ac
