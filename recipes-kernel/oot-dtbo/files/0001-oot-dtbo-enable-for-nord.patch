diff --git a/devicetree/sa8797p-vfio.dtsi b/devicetree/sa8797p-vfio.dtsi
new file mode 100644
index 0000000..2100711
--- /dev/null
+++ b/devicetree/sa8797p-vfio.dtsi
@@ -0,0 +1,2074 @@
+//SPDX-License-Identifier: BSD-3-Clause
+/*
+* Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+*/
+
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <oot-dt-bindings/qcom-ipcc-sa8797p.h>
+
+&soc {
+	scm_user_intf_device {
+		compatible = "qcom,scm-user-intf";
+		scm_dev = "scm";
+		status = "ok";
+	};
+
+	vfio_timer@17813000 {
+		compatible = "qcom,vfio-platform";
+		interrupts = <GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH>;
+		reg = <0x00 0x17813000 0x0 0x1000>;
+		iommus = <&apps_smmu_0 0x1980 0x0>;
+		qcom,iommu-dma-addr-pool = <0x0 0x60002000 0x0 0x1FFFE000>;
+		dma-coherent;
+	};
+
+	safety-ddr@82010000 {
+		compatible = "qcom,vdev-device";
+		reg = <0x0 0x82010000 0x0 0x10000>,
+			  <0x0 0x09185000 0x0 0x1000>,
+			  <0x0 0x87200000 0x0 0x1000>,
+			  <0x0 0x87ADB000 0x0 0x1000>,
+			  <0x0 0x01F76000 0x0 0x3000>,
+			  <0x0 0x1F73000  0x0 0x1000>,
+			  <0x0 0x210AF000 0x0 0x4000000>,
+			  <0x0 0x17F60000 0x0 0x2000>,
+			  <0x0 0x19AA0000 0x0 0x2000>,
+			  <0x0 0x87ADA000 0x0 0x2000>,
+			  <0x0 0x01F97000 0x0 0x1000>,
+			  <0x0 0x87AE3000 0x0 0x2000>;
+		interrupts-extended = <&ipcc2 IPCC_COMPUTE_L1_SAIL0 1 IRQ_TYPE_LEVEL_HIGH>;
+	};
+
+	apss-stl@8400000 {
+		compatible = "qcom,vdev-device";
+		reg = <0x0 0x08400000 0x0 0x1000>;
+	};
+
+	umd_nsp_drv@1f012000 {
+		compatible = "qcom,vdev-device";
+		reg = <0x0 0x1F012000 0x0 0x1000>,
+				<0x0 0x1F412000 0x0 0x1000>,
+				<0x0 0x1F812000 0x0 0x1000>,
+				<0x0 0x1FC12000 0x0 0x1000>,
