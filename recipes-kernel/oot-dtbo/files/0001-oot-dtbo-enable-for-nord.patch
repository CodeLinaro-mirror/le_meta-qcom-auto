diff --git a/devicetree/nord-ride_overlay.dtso b/devicetree/nord-ride_overlay.dtso
new file mode 100644
index 0000000..6e0acf7
--- /dev/null
+++ b/devicetree/nord-ride_overlay.dtso
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ */
+
+/dts-v1/;
+/plugin/;
+
+#include "sa8797p-vfio.dtsi"
+
+/ {
+	model = "Qualcomm Technologies, Inc. nord ride";
+	compatible = "qcom,nord-ride", "qcom,nord";
+
+	#address-cells = <2>;
+	#size-cells = <2>;
+	
+};
+
+&soc {
+	kaslr_store {
+		compatible = "qcom,kaslr-off-store";
+		reg = <0x0 0x146806d0 0x0 0xc>;
+	};
+
+	dload_mode {
+		compatible = "qcom,dload-mode";
+	};
+
+	dload_type {
+		compatible = "qcom,msm-imem-dload-type";
+		reg = <0x0 0x1468001c 0x0 0x4>;
+	};
+
+	kiumd {
+		compatible = "qcom,kiumd";
+		qcom,dev-name = "kiumd";
+		status = "ok";
+	};
+
+	mini_dump_mode {
+		compatible = "qcom,minidump";
+		status = "ok";
+	};
+
+	scm_user_intf_device {
+		compatible = "qcom,scm-user-intf";
+		scm_dev = "scm";
+		status = "ok";
+	};
+};
+
+&adreno_smmu_0 {
+	status = "okay";
+};
