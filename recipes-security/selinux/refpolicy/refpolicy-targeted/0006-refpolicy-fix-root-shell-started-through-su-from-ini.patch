diff --git a/policy/modules/admin/su.if b/policy/modules/admin/su.if
index b6c7ca0..6730574 100644
--- a/policy/modules/admin/su.if
+++ b/policy/modules/admin/su.if
@@ -316,6 +316,31 @@ interface(`su_exec',`
 	can_exec($1, su_exec_t)
 ')
 
+#######################################
+## <summary>
+##	Execute su in the specified domain.
+## </summary>
+## <param name="domain">
+##	<summary>
+##	Domain allowed to transition.
+##	</summary>
+## </param>
+## <param name="target_domain">
+##	<summary>
+##	Domain to transition to.
+##	</summary>
+## </param>
+#
+interface(`su_domtrans_to',`
+	gen_require(`
+		type su_exec_t;
+	')
+
+	corecmd_search_bin($1)
+	domain_entry_file($2, su_exec_t)
+	domtrans_pattern($1, su_exec_t, $2)
+')
+
 #######################################
 ## <summary>
 ##	Send signals to all su domains.
diff --git a/policy/modules/kernel/filesystem.if b/policy/modules/kernel/filesystem.if
index e22bf5a..1044098 100644
--- a/policy/modules/kernel/filesystem.if
+++ b/policy/modules/kernel/filesystem.if
@@ -6496,6 +6496,24 @@ interface(`fs_getattr_tmpfs_sockets',`
 	getattr_sock_files_pattern($1, tmpfs_t, tmpfs_t)
 ')
 
+########################################
+## <summary>
+##	Get attributes of tmpfs named pipes.
+## </summary>
+## <param name="domain">
+##	<summary>
+##	Domain allowed access.
+##	</summary>
+## </param>
+#
+interface(`fs_getattr_tmpfs_fifo_files',`
+	gen_require(`
+		type tmpfs_t;
+	')
+
+	getattr_fifo_files_pattern($1, tmpfs_t, tmpfs_t)
+')
+
 ########################################
 ## <summary>
 ##	Relabelfrom tmpfs link files.
diff --git a/policy/modules/services/ssh.fc b/policy/modules/services/ssh.fc
index 81314fd..ea64274 100644
--- a/policy/modules/services/ssh.fc
+++ b/policy/modules/services/ssh.fc
@@ -27,6 +27,7 @@ HOME_DIR/\.ssh(/.*)?			gen_context(system_u:object_r:ssh_home_t,s0)
 
 /usr/sbin/sshd			--	gen_context(system_u:object_r:sshd_exec_t,s0)
 
+/run/ssh(/.*)?			gen_context(system_u:object_r:sshd_key_t,s0)
 /run/sshd(/.*)?			gen_context(system_u:object_r:sshd_runtime_t,s0)
 /run/sshd\.init\.pid	--	gen_context(system_u:object_r:sshd_runtime_t,s0)
 /run/sshd\.pid		--	gen_context(system_u:object_r:sshd_runtime_t,s0)
diff --git a/policy/modules/services/ssh.if b/policy/modules/services/ssh.if
index 39fd112..ba2012c 100644
--- a/policy/modules/services/ssh.if
+++ b/policy/modules/services/ssh.if
@@ -739,6 +739,26 @@ interface(`ssh_setattr_key_files',`
 	files_search_runtime($1)
 ')
 
+########################################
+## <summary>
+##	Create the ssh server key directory
+##	in the runtime directories.
+## </summary>
+## <param name="domain">
+##	<summary>
+##	Domain allowed access.
+##	</summary>
+## </param>
+#
+interface(`ssh_runtime_filetrans_key_dir',`
+	gen_require(`
+		type sshd_key_t;
+	')
+
+	allow $1 sshd_key_t:dir create_dir_perms;
+	files_runtime_filetrans($1, sshd_key_t, dir, "ssh")
+')
+
 ########################################
 ## <summary>
 ##	Execute the ssh agent client in the caller domain.
diff --git a/policy/modules/services/ssh.te b/policy/modules/services/ssh.te
index 7b97358..e3626ec 100644
--- a/policy/modules/services/ssh.te
+++ b/policy/modules/services/ssh.te
@@ -17,7 +17,7 @@ gen_tunable(allow_ssh_keysign, false)
 ## Allow ssh logins as sysadm_r:sysadm_t
 ## </p>
 ## </desc>
-gen_tunable(ssh_sysadm_login, false)
+gen_tunable(ssh_sysadm_login, true)
 
 ## <desc>
 ## <p>
@@ -257,6 +257,7 @@ allow sshd_t self:netlink_route_socket r_netlink_socket_perms;
 allow sshd_t self:key { link search write };
 
 allow sshd_t sshd_keytab_t:file read_file_perms;
+allow sshd_t sshd_key_t:dir search_dir_perms;
 
 manage_dirs_pattern(sshd_t, sshd_tmp_t, sshd_tmp_t)
 manage_files_pattern(sshd_t, sshd_tmp_t, sshd_tmp_t)
@@ -368,6 +369,8 @@ allow ssh_keygen_t self:unix_stream_socket create_stream_socket_perms;
 
 allow ssh_keygen_t sshd_key_t:file manage_file_perms;
 files_etc_filetrans(ssh_keygen_t, sshd_key_t, file)
+manage_files_pattern(ssh_keygen_t, sshd_key_t, sshd_key_t)
+files_search_runtime(ssh_keygen_t)
 
 kernel_read_kernel_sysctls(ssh_keygen_t)
 kernel_dontaudit_getattr_proc(ssh_keygen_t)
diff --git a/policy/modules/system/init.if b/policy/modules/system/init.if
index 129afd9..7bb4e12 100644
--- a/policy/modules/system/init.if
+++ b/policy/modules/system/init.if
@@ -2970,6 +2970,25 @@ interface(`init_rw_script_tmp_files',`
 	rw_files_pattern($1, initrc_tmp_t, initrc_tmp_t)
 ')
 
+########################################
+## <summary>
+##	Write init script log files.
+## </summary>
+## <param name="domain">
+##	<summary>
+##	Domain allowed access.
+##	</summary>
+## </param>
+#
+interface(`init_write_script_log_files',`
+	gen_require(`
+		type initrc_var_log_t;
+	')
+
+	logging_search_logs($1)
+	write_files_pattern($1, initrc_var_log_t, initrc_var_log_t)
+')
+
 ########################################
 ## <summary>
 ##	Create files in a init script
diff --git a/policy/modules/system/init.te b/policy/modules/system/init.te
index 8188f8a..ff9a286 100644
--- a/policy/modules/system/init.te
+++ b/policy/modules/system/init.te
@@ -919,6 +919,8 @@ fs_getattr_all_fs(initrc_t)
 fs_search_all(initrc_t)
 fs_getattr_nfsd_files(initrc_t)
 
+fstools_runtime_filetrans(initrc_t, dir, "blkid")
+
 mcs_process_set_categories(initrc_t)
 
 mls_file_read_all_levels(initrc_t)
@@ -1526,6 +1528,7 @@ optional_policy(`
 optional_policy(`
 	ssh_dontaudit_read_server_keys(initrc_t)
 	ssh_setattr_key_files(initrc_t)
+	ssh_runtime_filetrans_key_dir(initrc_t)
 ')
 
 optional_policy(`
@@ -1564,6 +1567,10 @@ optional_policy(`
 		mono_domtrans(initrc_t)
 	')
 
+	optional_policy(`
+		unconfined_su_domtrans(initrc_t)
+	')
+
 	optional_policy(`
 		rtkit_scheduled(initrc_t)
 	')
diff --git a/policy/modules/system/modutils.fc b/policy/modules/system/modutils.fc
index 3231200..f0d83da 100644
--- a/policy/modules/system/modutils.fc
+++ b/policy/modules/system/modutils.fc
@@ -13,6 +13,8 @@ ifdef(`init_systemd',`
 /run/tmpfiles\.d/static-nodes\.conf --  gen_context(system_u:object_r:kmod_tmpfiles_conf_t,s0)
 ')
 
+/run/modprobe\.d(/.*)?		gen_context(system_u:object_r:modules_conf_t,s0)
+
 /usr/bin/depmod.*		--	gen_context(system_u:object_r:kmod_exec_t,s0)
 /usr/bin/generate-modprobe\.conf --	gen_context(system_u:object_r:kmod_exec_t,s0)
 /usr/bin/insmod.*		--	gen_context(system_u:object_r:kmod_exec_t,s0)
diff --git a/policy/modules/system/modutils.if b/policy/modules/system/modutils.if
index 09e782c..99400f7 100644
--- a/policy/modules/system/modutils.if
+++ b/policy/modules/system/modutils.if
@@ -122,6 +122,27 @@ interface(`modutils_manage_module_config',`
 	manage_files_pattern($1, modules_conf_t, modules_conf_t)
 ')
 
+########################################
+## <summary>
+##	Create and manage module configuration
+##	in the runtime directories.
+## </summary>
+## <param name="domain">
+##	<summary>
+##	Domain allowed access.
+##	</summary>
+## </param>
+#
+interface(`modutils_manage_runtime_module_config',`
+	gen_require(`
+		type modules_conf_t;
+	')
+
+	files_runtime_filetrans($1, modules_conf_t, dir, "modprobe.d")
+	manage_dirs_pattern($1, modules_conf_t, modules_conf_t)
+	manage_files_pattern($1, modules_conf_t, modules_conf_t)
+')
+
 ########################################
 ## <summary>
 ##	Execute any modutil,
diff --git a/policy/modules/system/mount.if b/policy/modules/system/mount.if
index db9880d..7674d4b 100644
--- a/policy/modules/system/mount.if
+++ b/policy/modules/system/mount.if
@@ -165,6 +165,25 @@ interface(`mount_run_unconfined',`
 	role $2 types unconfined_mount_t;
 ')
 
+########################################
+## <summary>
+##	Allow a domain to transition to the unconfined_mount_t domain
+##	when the process has the NoNewPrivileges flag set.
+## </summary>
+## <param name="domain">
+##	<summary>
+##	Domain allowed to transition.
+##	</summary>
+## </param>
+#
+interface(`mount_nnp_trans_unconfined',`
+	gen_require(`
+		type unconfined_mount_t;
+	')
+
+	allow $1 unconfined_mount_t:process2 nnp_transition;
+')
+
 ########################################
 ## <summary>
 ##	Read loopback filesystem image files.
