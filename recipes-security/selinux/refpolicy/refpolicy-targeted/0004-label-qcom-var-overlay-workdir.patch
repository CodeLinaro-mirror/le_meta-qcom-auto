From 3ebd7d4a1b46032521c7f1b84d56664a44192cb3 Mon Sep 17 00:00:00 2001
From: Jie Ma <mjie@qti.qualcomm.com>
Date: Wed, 9 Sep 2026 10:00:00 +0200
Subject: [PATCH] refpolicy: label runtime mount paths

On systems where /var is mounted as an overlay with:

  lowerdir=/persist,upperdir=/data/var_upper,workdir=/data/var_work

With refpolicy-targeted in enforcing mode, the /var overlay backing
paths fall back to default_t.  During overlay setup, mount_t must clean
and recreate the internal work directory, and the access to default_t is
denied.  The kernel then mounts /var read-only, which causes follow-on
failures for services that need writable state under /var or /var/lib.

The DSP firmware mount also uses a fixed SELinux context:

  context=system_u:object_r:dsp_file_t:s0

When dsp_file_t is not defined in policy, the kernel cannot resolve the
mount context and the mount fails with EINVAL before any AVC denial is
reported.

Label the platform overlay workdir in the files module, place the
related file contexts in their owner modules, and route cross-module access
through interfaces.  Also add file context substitutions so the persistent
lowerdir and upperdir can be relabelled with the same contexts they expose
through /var.  Define the DSP firmware file type in the files module so
the /vendor/dsp mount context can be resolved by SELinux.

Upstream-Status: Pending

Signed-off-by: Jie Ma <mjie@qti.qualcomm.com>
---
diff --git a/config/file_contexts.subs_dist b/config/file_contexts.subs_dist
index 8aaf368..5f6ef3d 100644
--- a/config/file_contexts.subs_dist
+++ b/config/file_contexts.subs_dist
@@ -49,3 +49,8 @@
 # The genhomedircon.py will expand /root home directory to /home/root
 # Add an aliase for it
 /root /home/root
+
+# /var overlay backing stores.
+# Relabel these paths as the /var hierarchy they back.
+/persist /var
+/data/var_upper /var
diff --git a/policy/modules/admin/logrotate.if b/policy/modules/admin/logrotate.if
index dd8e01a..c460b49 100644
--- a/policy/modules/admin/logrotate.if
+++ b/policy/modules/admin/logrotate.if
@@ -120,3 +120,41 @@ interface(`logrotate_read_tmp_files',`
 	files_search_tmp($1)
 	allow $1 logrotate_tmp_t:file read_file_perms;
 ')
+
+########################################
+## <summary>
+##	Manage logrotate state files.
+## </summary>
+## <param name="domain">
+##	<summary>
+##	Domain allowed access.
+##	</summary>
+## </param>
+#
+interface(`logrotate_manage_var_lib_files',`
+	gen_require(`
+		type logrotate_var_lib_t;
+	')
+
+	files_search_var_lib($1)
+	manage_files_pattern($1, logrotate_var_lib_t, logrotate_var_lib_t)
+')
+
+########################################
+## <summary>
+##	Relabel logrotate state files.
+## </summary>
+## <param name="domain">
+##	<summary>
+##	Domain allowed access.
+##	</summary>
+## </param>
+#
+interface(`logrotate_relabel_var_lib_files',`
+	gen_require(`
+		type logrotate_var_lib_t;
+	')
+
+	files_search_var_lib($1)
+	allow $1 logrotate_var_lib_t:file relabel_file_perms;
+')
diff --git a/policy/modules/kernel/files.fc b/policy/modules/kernel/files.fc
index f98e9d0..6a9e080 100644
--- a/policy/modules/kernel/files.fc
+++ b/policy/modules/kernel/files.fc
@@ -50,6 +50,11 @@
 #
 /etc			-d	gen_context(system_u:object_r:etc_t,s0)
 /etc/.*				gen_context(system_u:object_r:etc_t,s0)
+# Runtime mount/config paths.
+/etc/build\.prop	--	gen_context(system_u:object_r:runtime_etc_t,s0)
+/etc/gptp_cfg\.ini	--	gen_context(system_u:object_r:runtime_etc_t,s0)
+/etc/usb(/.*)?			gen_context(system_u:object_r:runtime_etc_t,s0)
+
 /etc/\.fstab\.hal\..+	--	gen_context(system_u:object_r:etc_runtime_t,s0)
 /etc/blkid(/.*)?		gen_context(system_u:object_r:etc_runtime_t,s0)
 /etc/cmtab		--	gen_context(system_u:object_r:etc_runtime_t,s0)
@@ -233,6 +233,12 @@ ifndef(`distro_redhat',`
 #
 # /var
 #
+/data/var_work		-d	gen_context(system_u:object_r:var_overlay_work_t,s0)
+/data/var_work/.*		gen_context(system_u:object_r:var_overlay_work_t,s0)
+
+# DSP firmware mount.
+/vendor/dsp(/.*)?		gen_context(system_u:object_r:dsp_file_t,s0)
+
 /var			-d	gen_context(system_u:object_r:var_t,s0)
 /var/.*				gen_context(system_u:object_r:var_t,s0)
 /var/\.journal			<<none>>
diff --git a/policy/modules/kernel/files.if b/policy/modules/kernel/files.if
index 79ea217..67bf452 100644
--- a/policy/modules/kernel/files.if
+++ b/policy/modules/kernel/files.if
@@ -5140,6 +5140,120 @@ interface(`files_manage_generic_tmp_files',`
 	allow $1 tmp_t:lnk_file read_lnk_file_perms;
 ')
 
+########################################
+## <summary>
+##	Relabel symbolic links in /tmp.
+## </summary>
+## <param name="domain">
+##	<summary>
+##	Domain allowed access.
+##	</summary>
+## </param>
+#
+interface(`files_relabel_generic_tmp_symlinks',`
+	gen_require(`
+		type tmp_t;
+	')
+
+	allow $1 tmp_t:lnk_file relabel_lnk_file_perms;
+')
+
+########################################
+## <summary>
+##	Relabel from symbolic links in /tmp.
+## </summary>
+## <param name="domain">
+##	<summary>
+##	Domain allowed access.
+##	</summary>
+## </param>
+#
+interface(`files_relabelfrom_generic_tmp_symlinks',`
+	gen_require(`
+		type tmp_t;
+	')
+
+	allow $1 tmp_t:lnk_file relabelfrom_lnk_file_perms;
+')
+
+########################################
+## <summary>
+##	Manage symbolic links in /tmp.
+## </summary>
+## <param name="domain">
+##	<summary>
+##	Domain allowed access.
+##	</summary>
+## </param>
+#
+interface(`files_manage_generic_tmp_symlinks',`
+	gen_require(`
+		type tmp_t;
+	')
+
+	manage_lnk_files_pattern($1, tmp_t, tmp_t)
+')
+
+########################################
+## <summary>
+##	Manage runtime files and directories under /etc.
+## </summary>
+## <param name="domain">
+##	<summary>
+##	Domain allowed access.
+##	</summary>
+## </param>
+#
+interface(`files_manage_runtime_etc',`
+	gen_require(`
+		type etc_t, runtime_etc_t;
+	')
+
+	manage_dirs_pattern($1, etc_t, runtime_etc_t)
+	manage_files_pattern($1, etc_t, runtime_etc_t)
+	allow $1 runtime_etc_t:dir relabel_dir_perms;
+	allow $1 runtime_etc_t:file relabel_file_perms;
+')
+
+########################################
+## <summary>
+##	Mount on runtime files and directories under /etc.
+## </summary>
+## <param name="domain">
+##	<summary>
+##	Domain allowed access.
+##	</summary>
+## </param>
+#
+interface(`files_mounton_runtime_etc',`
+	gen_require(`
+		type runtime_etc_t;
+	')
+
+	allow $1 runtime_etc_t:dir mounton;
+	allow $1 runtime_etc_t:file mounton;
+')
+
+########################################
+## <summary>
+##	Create runtime /etc objects with automatic type transitions.
+## </summary>
+## <param name="domain">
+##	<summary>
+##	Domain allowed access.
+##	</summary>
+## </param>
+#
+interface(`files_runtime_etc_filetrans',`
+	gen_require(`
+		type etc_t, runtime_etc_t;
+	')
+
+	filetrans_pattern($1, etc_t, runtime_etc_t, file, "build.prop")
+	filetrans_pattern($1, etc_t, runtime_etc_t, file, "gptp_cfg.ini")
+	filetrans_pattern($1, etc_t, runtime_etc_t, dir, "usb")
+')
+
 ########################################
 ## <summary>
 ##	Read symbolic links in the tmp directory (/tmp).
@@ -6239,6 +6275,24 @@ interface(`files_manage_var_files',`
 	manage_files_pattern($1, var_t, var_t)
 ')
 
