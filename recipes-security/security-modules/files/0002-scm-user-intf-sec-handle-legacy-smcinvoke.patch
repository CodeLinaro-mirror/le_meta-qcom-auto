From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jie Ma <mjie@qti.qualcomm.com>
Date: Tue, 1 Sep 2026 15:00:00 +0200
Subject: [PATCH] scm_user_intf_sec: handle legacy smcinvoke command

The userspace libtzbsp ABI sends command 0x0 for the original SMCInvoke
request, 0x1 for callback responses, and 0x2 for cache-coherent requests.
After the kernel 7.0 API adaptation, scm_user_intf_sec only accepted 0x2 and
0x1, leaving the legacy request path unsupported and dropping the third SCM
result register from qtee wrapper calls.

Handle command 0x0 explicitly through a kernel compatibility helper and keep
result[2] initialized for userspace.

Upstream-Status: Pending

Signed-off-by: Jie Ma <mjie@qti.qualcomm.com>
---
 drivers/scm_user_intf_sec.c | 18 +++++++++++++++---
 1 file changed, 15 insertions(+), 3 deletions(-)

diff --git a/drivers/scm_user_intf_sec.c b/drivers/scm_user_intf_sec.c
--- a/drivers/scm_user_intf_sec.c
+++ b/drivers/scm_user_intf_sec.c
@@ -56,6 +56,8 @@ typedef struct {
 static const char* scm_dev_name = "qcom_scm";
 static u64 g_tzmem_handle = 0;
 
+#define QCOM_SCM_SMCINVOKE_LEGACY	0x0
+
 /*
  * SVC/ Cmd ID pair that needs DMA buf fd to PA translation
  */
@@ -63,6 +65,7 @@ static const struct svc_cmd_dma_list dma_fd_tbl[] = {
 
 	{QCOM_SCM_SVC_SMC_INVOKE, QCOM_SCM_SMCINVOKE, 1, DMA_FD_ARGS(0)},
 	{QCOM_SCM_SVC_SMC_INVOKE, QCOM_SCM_SMCINVOKE_CB_RESP, 1, DMA_FD_ARGS(0)},
+	{QCOM_SCM_SVC_SMC_INVOKE, QCOM_SCM_SMCINVOKE_LEGACY, 1, DMA_FD_ARGS(0)},
 
 };
 
@@ -348,11 +351,11 @@ static long scm_smcinvoke_ioctl(struct file *file, unsigned int cmd, unsigned lo
 	dma_buf_info_t dma_buf_info = {0};
 	struct scm_hand_shake scm_data;
 #if (LINUX_VERSION_CODE == KERNEL_VERSION(5, 14, 0))
-	struct qcom_scm_desc desc;
-	struct qcom_scm_res res;
+	struct qcom_scm_desc desc = {0};
+	struct qcom_scm_res res = {0};
 #else
-	struct scm_user_res res;
+	struct scm_user_res res = {0};
 #endif
 	int no_dma_fds = 0;
 	int i, no_of_args;
 	int ret = 0;
@@ -383,6 +386,18 @@ static long scm_smcinvoke_ioctl(struct file *file, unsigned int cmd, unsigned lo
 	u64 out_buf_size = scm_data.args_buffer[2];
 
 #if (LINUX_VERSION_CODE != KERNEL_VERSION(5, 14, 0))
+	if (scm_data.cmd == QCOM_SCM_SMCINVOKE_LEGACY) {
+		scm_data.ret = qcom_scm_qtee_invoke_smc_legacy(in_buf, in_buf_size, out_buf, out_buf_size, &res.result[1], &res.result[0], &res.result[2]);
+	} else
 	if (scm_data.cmd == QCOM_SCM_SMCINVOKE) {
 		scm_data.ret = qcom_scm_qtee_invoke_smc(in_buf, in_buf_size, out_buf, out_buf_size, &res.result[1], &res.result[0]);
+		if (scm_data.ret == -EINVAL) {
+			dev_warn_once(__scm_dev->dev,
+				      "cache-coherent smcinvoke failed with -EINVAL, falling back to legacy command\n");
+			scm_data.ret = qcom_scm_qtee_invoke_smc_legacy(in_buf, in_buf_size,
+								       out_buf, out_buf_size,
+								       &res.result[1],
+								       &res.result[0],
+								       &res.result[2]);
+		}
 	} else if (scm_data.cmd == QCOM_SCM_SMCINVOKE_CB_RESP) {
-- 
